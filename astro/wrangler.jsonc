{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hunter-alpha-hub-astro-preview",
  "account_id": "de677f38b96340f3a63a53e5044a1c98",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hunter-alpha-hub-subscribers",
      "database_id": "941d6f24-ecc4-4f45-bc3a-888d9b6df00e"
    }
  ],

  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Slashed variants (/faq/) must answer 308, not the asset layer's default 307:
    // 307 is temporary, so Google keeps both forms instead of consolidating.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get the build's own 404.html instead of the bare asset-layer page.
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
