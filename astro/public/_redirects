# a 404 — a bare 404 throws away whatever signal those URLs accumulated.
# Same six rules as `redirects()` in next.config.ts; verified against the live
# site in the Phase 4 checklist.
/leaderboard / 301
/monitor / 301
/evidence / 301
/timeline / 301
/videos / 301
/profile/:nickname / 301
