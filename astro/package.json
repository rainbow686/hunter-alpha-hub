{
  "name": "hunter-alpha-hub-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "check:parity": "node scripts/check-page-parity.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "import:blog": "node --experimental-strip-types scripts/import-blog.mjs",
    "preview": "wrangler dev",
    "deploy": "astro build && node scripts/mark-preview.mjs && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  },
  "engines": { "node": ">=22" }
}
