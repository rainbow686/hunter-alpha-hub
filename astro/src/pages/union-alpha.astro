---
import Base from "../layouts/Base.astro";

// Sample page for the design review: a tracker, i.e. the page type that has to
// carry live state, a spec table and unverified claims without blurring them.
const verified = [
  { field: "OpenRouter ID", value: "stealth/union-alpha", note: "Catalogue field" },
  { field: "Context window", value: "262,144 tokens", note: "Catalogue field" },
  { field: "Maximum output", value: "131,072 tokens", note: "Endpoint parameter list" },
  { field: "Input modalities", value: "Text, image", note: "Catalogue field" },
  { field: "Pricing", value: "$0.00 in / $0.00 out", note: "Free preview, can change" },
  { field: "First listed", value: "2026-09-16 14:42 UTC", note: "Unix 1789569723" },
];

const claims = [
  {
    claim: "Union Alpha may be an orchestrator over several models rather than one model.",
    confidence: "Medium",
    evidence: "Testers reported inconsistent behaviour between sessions; a public landing page describes parallel generation with a synthesised answer.",
  },
  {
    claim: "Expected paid pricing of $0.50 in / $1.50 out per million tokens.",
    confidence: "Low",
    evidence: "Listed as anticipated on a third-party landing page. The catalogue still bills $0.",
  },
];
---
<Base
  title="Union Alpha — specs, status and claims"
  description="Union Alpha: verified catalogue specs, live status, and community claims kept separate."
  canonical="https://www.hunteralphahub.com/union-alpha"
>
  <p class="tag verified">Verified 2026-09-17</p>
  <h1>Union Alpha</h1>
  <p class="lede">
    An anonymous multimodal model, free while it lasts. Everything below is either read from the
    public catalogue or labelled as an unverified claim — the two are never mixed.
  </p>

  <p style="margin-top: var(--space-4);">
    <span class="badge live"><span class="dot"></span> Live on OpenRouter</span>
  </p>

  <h2>Verified specs</h2>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr><th>Field</th><th>Value</th><th>Where it comes from</th></tr>
      </thead>
      <tbody>
        {verified.map((row) => (
          <tr>
            <td>{row.field}</td>
            <td class="num" style="text-align: left; font-weight: 600;">{row.value}</td>
            <td style="color: var(--text-muted);">{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="provenance">
    <span>Source: <code>openrouter.ai/api/v1/models</code></span>
    <span>Verified <code>2026-09-17</code></span>
    <span>Re-checked on every page view via <code>/api/union-alpha/status</code></span>
  </div>

  <h2>Unverified claims</h2>
  <p class="prose" style="color: var(--text-muted);">
    Public discussion, paraphrased and attributed. Not findings.
  </p>
  <div class="table-scroll" style="margin-top: var(--space-4);">
    <table class="data">
      <thead>
        <tr><th>Claim</th><th>Confidence</th><th>Basis</th></tr>
      </thead>
      <tbody>
        {claims.map((row) => (
          <tr>
            <td style="max-width: 34ch;">{row.claim}</td>
            <td><span class={`tag ${row.confidence === "Medium" ? "claimed" : "unknown"}`}>{row.confidence}</span></td>
            <td style="color: var(--text-muted);">{row.evidence}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
