---
import Journal from "../../layouts/Journal.astro";
import Logo from "../../components/Logo.astro";
import { readFileSync } from "node:fs";

const modelsSource = readFileSync(`${process.env.SITE_ROOT ?? "../"}lib/openrouter-models.ts`, "utf8");
const models = [...modelsSource.matchAll(/slug: "([^"]+)",\s*\n\s*name: "([^"]+)",\s*\n\s*vendor: "([^"]+)",\s*\n\s*contextWindow: ([\d_]+),\s*\n\s*inputPricePerMillion: ([\d.]+),\s*\n\s*outputPricePerMillion: ([\d.]+)/g)]
  .map((m) => ({ slug: m[1], name: m[2], vendor: m[3], context: Number(m[4].replace(/_/g, "")), input: Number(m[5]), output: Number(m[6]) }));
const maxContext = Math.max(...models.map((m) => m.context));
const fmtCtx = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 2)}M` : `${Math.round(n / 1024)}K`);
const fmtPrice = (n: number) => (n === 0 ? "free" : `$${n.toFixed(n < 1 ? 3 : 2)}`);
---
<Journal
  title="V6 — paper journal with designed header and footer"
  description="Variant 6 preview"
  canonical="https://www.hunteralphahub.com/"
>
  <p class="kicker">OpenRouter model index</p>
  <h1 class="display">Every model, priced and dated.</h1>
  <p class="lede">
    Catalogue facts in one table: context window, price per million, modality. The stealth line is tracked
    separately, and every claim carries a confidence label.
  </p>
  <div class="byline">
    <span>Model index</span><span>Verified 2026-09-17</span><span>Source: public catalogue</span>
  </div>

  <div class="stats">
    <div class="stat"><div class="label">Curated models</div><div class="value">{models.length}</div><div class="sub">drift-checked daily</div></div>
    <div class="stat"><div class="label">Largest window</div><div class="value">{fmtCtx(maxContext)}</div><div class="sub">tokens</div></div>
    <div class="stat"><div class="label">Free entries</div><div class="value">{models.filter((m) => m.input === 0).length}</div><div class="sub">preview pricing</div></div>
    <div class="stat"><div class="label">Verified</div><div class="value">2026-09-17</div><div class="sub">catalogue read</div></div>
  </div>

  <h2>Model snapshot</h2>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr><th>Model</th><th>Vendor</th><th class="num">Context</th><th class="num">Input /M</th><th class="num">Output /M</th></tr>
      </thead>
      <tbody>
        {models.map((m) => (
          <tr>
            <td><a href={`/openrouter-models/${m.slug}`}>{m.name}</a></td>
            <td style="color: var(--text-muted);">{m.vendor}</td>
            <td class="num">
              <span class="bar">
                <span class="track"><span class="fill" style={`width:${Math.round((m.context / maxContext) * 100)}%`}></span></span>
                <span class="num">{fmtCtx(m.context)}</span>
              </span>
            </td>
            <td class={`num ${m.input === 0 ? "free" : ""}`}>{fmtPrice(m.input)}</td>
            <td class={`num ${m.output === 0 ? "free" : ""}`}>{fmtPrice(m.output)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="provenance">
    <span>Source <code>openrouter.ai/api/v1/models</code></span>
    <span>Verified <code>2026-09-17</code></span>
    <span>Drift check <code>daily 06:00</code></span>
  </div>

  <h2>Brand review</h2>
  <p class="prose" style="color: var(--text-muted);">
    The mark is drawn from the subject: two muted nodes for the models already revealed, one larger
    accent node for the release that is live now. It has to survive 16px (favicon) and still mean
    something at 32px.
  </p>
  <div class="card" style="margin-top: var(--space-4);">
    <div style="display:flex; align-items:center; gap:16px; padding:14px 0; border-bottom:1px solid var(--border);">
      <span style="min-width:190px; font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-faint);">Mark, three sizes</span>
      <span style="display:inline-flex; align-items:center; gap:14px;"><Logo size={16} /><Logo size={22} /><Logo size={32} /></span>
    </div>
    <div style="display:flex; align-items:center; gap:16px; padding:14px 0; border-bottom:1px solid var(--border); flex-wrap:wrap;">
      <span style="min-width:190px; font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-faint);">Wordmark</span>
      <span class="wordmark" style="font-family: var(--serif); font-size: 20px;">
        hunteralpha<span style="color: var(--accent);">hub</span>
      </span>
      <span class="brand" style="display: inline-flex; align-items: center; gap: 8px;">
        <Logo size={22} />
        <span class="wordmark" style="font-family: var(--serif); font-size: 20px;">
          hunteralpha<span style="color: var(--accent);">hub</span>
        </span>
      </span>
    </div>
    <div style="display:flex; align-items:center; gap:16px; padding:14px 0; border-bottom:1px solid var(--border); flex-wrap:wrap;">
      <span style="min-width:190px; font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-faint);">Lockup + tagline</span>

      <span class="brand">
        <Logo size={26} />
        <span class="wordmark" style="font-family: var(--serif); font-size: 19px;">
          hunteralpha<span style="color: var(--accent);">hub</span>
        </span>
        <span class="tagline">OpenRouter reference</span>
      </span>
    </div>
    <div style="display:flex; align-items:center; gap:16px; padding:14px 0; flex-wrap:wrap;">
      <span style="min-width:190px; font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-faint);">Favicon scale (16px)</span>

      <span style="display: inline-flex; align-items: center; gap: 6px; background: var(--bg); padding: 6px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm);">
        <Logo size={16} /><span style="font-size: 12px; color: var(--text-muted);">hunteralphahub.com</span>
      </span>
    </div>
  </div>
</Journal>
