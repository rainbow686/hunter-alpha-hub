---
/**
 * Homepage — the page that carries most of this site's search traffic.
 *
 * In GSC it accounts for 232 of 237 clicks over 90 days, ranking around position
 * 2.8 for "hunter alpha ai" and 6.9 for "hunter alpha openrouter" on the strength
 * of the domain name. So its title, description, canonical (no trailing slash),
 * single h1 and structured data are the site's most valuable indexed assets, and
 * `npm run verify:pages` checks them against the live page like any other route.
 *
 * It replaced the Phase-1 scaffold, which was a design-comparison page that
 * linked eleven /vN variants. Those variants still exist as unlinked internal
 * pages, which the link audit is right to ignore — the real homepage links none
 * of them, and the preview audit is what caught them.
 *
 * Structure follows ADR-0012: the homepage is the [primary] layer, and its job is
 * to route into the second tier — the live codename, the register, the
 * comparison — not to be a third copy of them.
 *
 * ## The 2026-09-25 pass (second attempt): a hub that does not need editing
 *
 * First attempt: copy the topic covers' shapes onto the front page — a cover card
 * per live topic in the hero, and a wall interleaved from both. It looked right and
 * it was wrong in two ways the reader named before I did:
 *
 *   1. **It hard-codes the two hot models.** A page whose hero names Jev and Laya
 *      has to be edited again when they cool down and something else lands.
 *   2. **Its wall was the topic pages' content again.** Two topics means any card
 *      band on this page overlaps with them; a *sample of each column* — which is
 *      what a topic cover shows — was the worst possible choice, because it is the
 *      same selection in the same order.
 *
 * The fix is to make the page read its own data and to give every band a job the
 * topic pages do not already do:
 *
 *   - **the hero's card is the spotlight**, read from `lib/spotlight.ts` — the same
 *     file the masthead badges read, so "what is hot" is edited in one data file,
 *     and the card plays its clip only when the clip is small enough to be worth it
 *     (the first attempt fetched 6.19 MB for one hero video);
 *   - **the models index lists every model we cover**, followed topics first, then
 *     the catalogue snapshot — which is the "all models in one place" layer. It
 *     grows by itself; nothing here is hand-listed;
 *   - **the card band is a date-ordered site feed** (`siteFeed`), not a per-column
 *     sample: *what landed last, anywhere*, which is the one thing no topic page
 *     says. With two topics it still mostly shows Jev and Laya — that is
 *     arithmetic, and it stops being true when a third model arrives;
 *   - **the codename answer sits above the fold.** GSC says this page is found for
 *     "hunter alpha" (1,423 impressions, position 6.9) and "hunter alpha ai"
 *     (position 3.4, 20% CTR) — and neither the h1 nor the title contains the
 *     phrase, so the first screen now states codename → model, dated.
 *
 * What it did not do, deliberately: change the title, the description, the h1, the
 * canonical or the structured data. `verify:pages` compares all of those against the
 * live page, and this page is where the site's search traffic is; a redesign is not
 * a reason to rewrite the strings that earn it.
 */
import System from "../layouts/System.astro";
import JsonLd from "../components/JsonLd.astro";
import Provenance from "../components/Provenance.astro";
import TopicWall from "../components/TopicWall.astro";
import XClipWall from "../components/XClipWall.astro";
import { TOPIC_LABEL, siteFeed, topicRecords, topicSizes } from "../lib/topic-wall";
import { breadcrumbSchema, SITE, SITE_NAME, webSiteSchema } from "../lib/schema";
import {
  defaultScenarios,
  openrouterModels,
  formatContextWindow,
  formatPrice,
  getModelBySlug,
  modelsForScenario,
  modelHubDataAsOf,
} from "@repo/lib/openrouter-models";
import { jevLaunchPost, jevXPosts } from "@repo/lib/jev-x-posts";
import { layaTopPost, layaXPosts } from "@repo/lib/laya-x-posts";
import { JEV_DATA_AS_OF, JEV_INPUT_PRICE_PER_MILLION, JEV_MODEL_ID } from "@repo/lib/jev";
import { LAYA_READ_ON } from "@repo/lib/laya";
import { topics as spotlight } from "@repo/lib/spotlight";
import { UNION_ALPHA_REVEAL } from "@repo/lib/union-alpha";
import { JEV_OURS_MEASURED_ON, oursLatency } from "@repo/lib/jev-our-measurements";
import { LAYA_OURS_MEASURED_ON, latencyCpu } from "@repo/lib/laya-our-measurements";

const title = "OpenRouter Model Hub — Compare AI Models: Pricing, Context & Benchmarks";
const description =
  "Compare 15+ AI models on OpenRouter side-by-side. Pricing, context windows, modality support and practical recommendations for coding, long context, agents and budget workloads.";
/** No trailing slash: every internal link, the sitemap and Google all use this form. */
const canonical = SITE;

/**
 * The codename this domain is named after. Its numbers come from the catalogue
 * entry it became, so the section cannot drift from the model page.
 */
const hunterAlpha = getModelBySlug("mimo-v2.5");

/*
 * Where to go next: the sections that are not already on this page. The model directory, the two
 * topics and the comparison each have a block of their own above, so repeating them here would be
 * the same link twice on one screen — which is how this page got to eleven cards the last time.
 */
const entryPoints = [
  {
    href: "/stealth-models",
    kicker: "register",
    title: "Every stealth release",
    body: "Each anonymous model, what it turned out to be, and what it costs after the reveal.",
  },
  {
    href: "/union-alpha",
    kicker: "revealed",
    title: "Union Alpha",
    body: "The third Alpha-line codename: listed 16 September, revealed as Unbiased Pareto on the 18th, with the specs, the timeline and the new price.",
  },
  {
    href: "/field-notes",
    kicker: "series",
    title: "Field notes",
    /*
      Points at the section, never at an entry. The previous version of this array
      had one card per page, which grows without bound and means every new page
      edits the homepage; this one card covers the series forever.
    */
    body: "When a model lands, we read the projects built on it — their code, their measurement files, their limits sections — and write down what holds up. Every entry says what we ran and what we did not.",
  },
  {
    href: "/comparison",
    kicker: "decide",
    title: "Compare before you commit",
    body: "Price, context window and modality side by side, fifteen models wide — including the free anonymous model next to paid ones.",
  },
  {
    href: "/openrouter-pricing-calculator",
    kicker: "tool",
    title: "Estimate your monthly cost",
    body: "Set token volume and the input/output mix to estimate monthly spend across several models at once.",
  },
  {
    href: "/alpha-line-report",
    kicker: "data",
    title: "The line, as a citable report",
    body: "Every dated fact we publish about the Alpha line — models, prices, reveals — as a plain page and plain JSON, CC BY 4.0.",
  },
];
/** Which models the workload strip has already named, so no two entries repeat. */
const usedInCards = new Set<string>();

const fmt = (n: number) => n.toLocaleString("en-US");

/*
 * The hero's right-hand column: two cards, both from data.
 *
 * The reader's note on the previous version was that the page had the content but not the pull:
 * "观感上不如动态的效果…轮播、卡片墙里有动态视频". They were right — the wall had moved below an
 * eighteen-row table, which is the least visual thing on the site, and the first screen had one
 * still picture on it. So the columns, top to bottom, are now pictures, pictures, motion, then the
 * reference table.
 *
 * Card 1 is the spotlight: its topic comes from `lib/spotlight.ts` — the same list the masthead
 * badges read — so "what is hot" is edited in one data file and never in this page. The media is
 * the post the topic itself leads with, because a picture of the thing somebody actually posted
 * says more than a generated illustration of "a decision model".
 *
 * It is playable only when the clip is small enough to be worth it. The first version of this page
 * played whatever the lead post carried, and that one file was 6.19 MB of a 7.43 MB first load
 * (`docs/lessons/measure-the-first-screen.md`); the threshold is the fix, and it is a fact about
 * the row rather than a taste call. A poster-only card is still a link into the section.
 */
const HERO_CLIP_MAX_BYTES = 1_500_000;
/*
 * The feed's cap is higher, and deliberately: the feed is the page's motion block, and a reader who
 * has scrolled this far has asked for it. The hero's is lower because that one is fetched before
 * anybody has decided they are interested.
 */
const FEED_CLIP_MAX_BYTES = 2_000_000;

/*
 * Everything a spotlight entry needs to become a card. Kept keyed by href rather than by label,
 * because the label is editorial and the href is the identity; an entry with no data here is
 * skipped by the markup instead of printing a card with holes in it.
 */
const topicData = {
  "/typesafe-jev": {
    slug: "jev" as const,
    name: "Jev",
    what: "TypeSafe's decision model: state in, typed decision out. It does not write.",
    /*
     * The topic's own cover engraving — generated for the reference page and, until 2026-09-25,
     * never shown where most readers meet the topic. A picture of an input going in and a decision
     * coming out says what the model does faster than the sentence does.
     */
    cover: "/img/cover-jev-topic.webp",
    coverAlt: "An engraving: a brass mailbox on a bench, a handwritten page going into its slot at the top and a punched brass card falling into the tray below.",
    verified: JEV_DATA_AS_OF,
    post: jevLaunchPost,
    postLabel: "X post · the launch",
    postLink: jevLaunchPost?.page
      ? { href: `/typesafe-jev/x-posts/${jevLaunchPost.page.slug}`, external: false, label: "What this post claims, and what we make of it" }
      : undefined,
    recordCount: topicRecords("jev"),
    repos: topicSizes.jev.builds,
  },
  "/laya": {
    slug: "laya" as const,
    name: "Laya",
    what: "The open-weights System One model, from Convai — a decision model you can run yourself.",
    cover: "/img/cover-laya-topic.webp",
    coverAlt: "An engraving: a small brass instrument with three dials on a single base, a blank paper tag tied to it.",
    verified: LAYA_READ_ON,
    post: layaTopPost,
    postLabel: "X post · the one that travelled",
    /*
     * Jev's X rows mostly have a page of ours; Laya's link out, and the card says which. Without
     * this the card would be one link short of the same card for the other topic.
     */
    postLink: layaTopPost
      ? { href: layaTopPost.url, external: true, label: "Read the post on X" }
      : undefined,
    recordCount: topicRecords("laya"),
    repos: topicSizes.laya.builds,
  },
} as const;

const heroTopic = spotlight.map((entry) => ({ ...entry, data: topicData[entry.href as keyof typeof topicData] })).find((entry) => entry.data);

/** The clip on the hero card, when it is small enough that a first impression is worth the bytes. */
const heroClip =
  heroTopic?.data.post?.video && heroTopic.data.post.video.bytes <= HERO_CLIP_MAX_BYTES
    ? heroTopic.data.post.video.url
    : undefined;

/*
 * The models index: everything this site covers, in one place, and the reason the front page does
 * not need editing when a model lands.
 *
 * Two kinds of row, and the difference matters: the followed topics have a section of their own
 * (counts, records, a page per record), the catalogue rows are what OpenRouter serves and we
 * compare. A reader who wants "all the models" gets both; a reader who wants "what are you
 * following" can tell which is which.
 */
const followedRows = spotlight
  .map((entry) => ({ entry, data: topicData[entry.href as keyof typeof topicData] }))
  .filter((row): row is { entry: (typeof spotlight)[number]; data: NonNullable<(typeof topicData)[keyof typeof topicData]> } => Boolean(row.data))
  .map(({ entry, data }) => ({
    name: entry.label,
    note: data.what,
    href: entry.href,
    records: data.recordCount,
    repos: data.repos,
    verified: data.verified,
    cover: data.cover,
    coverAlt: data.coverAlt,
  }));

const catalogueRows = openrouterModels.map((model) => ({
  name: model.name,
  href: `/openrouter-models/${model.slug}`,
  vendor: model.formerAlias ? `${model.vendor} · formerly ${model.formerAlias}` : model.vendor,
  input: formatPrice(model.inputPricePerMillion),
  output: formatPrice(model.outputPricePerMillion),
  context: formatContextWindow(model.contextWindow),
  bestFor: model.bestFor.slice(0, 3).join(" · "),
}));

/*
 * The headline picks, one per workload, as a strip rather than as six cards: the card grid said
 * the same thing the index below says, one screen further down. Each entry names a different
 * model — the first version took the top model per scenario and printed Xiaomi MiMo-V2.5 twice.
 */
const workloadPicks = defaultScenarios.flatMap((scenario) => {
  const model = modelsForScenario(scenario.scenario, 4).find((candidate) => !usedInCards.has(candidate.slug));
  if (!model) return [];
  usedInCards.add(model.slug);
  return [{ scenario: scenario.title, model: model.name, href: `/openrouter-models/${model.slug}` }];
});

/*
 * The site feed: what landed last that was worth looking at, anywhere. Six cards per topic, merged
 * by date, each labelled with the topic it came from — the one view of these records that no topic
 * page provides. The rules (a signal floor per kind, and both topics getting their turn) live in
 * `siteFeed` with the numbers that calibrated them.
 */
const FEED_PER_TOPIC = 6;
/*
 * One row of headroom: the hero's second card takes the newest clip on the site out of this list,
 * so the two must not both render it — one file, two `<video>` elements is the bug the topic
 * covers hit on 2026-09-24.
 */
const recent = siteFeed(FEED_PER_TOPIC + 1, { excludeXId: heroTopic?.data.post?.id });
/*
 * Picked against the **hero** cap, not the feed's: this row is fetched before the reader has
 * decided they are interested, so it may only play if it is small. If nothing recent is that
 * small, the card is a poster and a link — and the feed below still moves.
 */
const heroClipRow = recent.find((row) => row.video && (row.videoBytes ?? 0) <= HERO_CLIP_MAX_BYTES);

const feed = recent
  .filter((row) => row !== heroClipRow)
  .slice(0, FEED_PER_TOPIC * 2)
  .map((row) => ({
    ...row,
    kind: `${TOPIC_LABEL[row.topic]} · ${row.kind}`,
    /*
     * Playing a clip in place is a choice the page makes per row, and a 2.6 MB clip in a
     * twelve-card feed is not the same offer as a 0.3 MB one. Measured with everything playing:
     * 11.2 MB for a full scroll, two files making up 6.5 of it. Over the cap the card keeps its
     * poster and links to the source, which is what a reader who wants the video does anyway.
     */
    video: row.videoBytes !== undefined && row.videoBytes <= FEED_CLIP_MAX_BYTES ? row.video : undefined,
  }));
const feedColumns = [
  { label: "Jev", href: "/typesafe-jev", count: topicRecords("jev") },
  { label: "Laya", href: "/laya", count: topicRecords("laya") },
];

/*
 * What the codenames turned out to be, on the first screen.
 *
 * This is the page's search intent, stated as a fact: GSC has the site at position 6.9 for
 * "hunter alpha" and 3.4 for "hunter alpha ai" (20% CTR), and neither the h1 nor the title carries
 * the phrase. The answer was on this page all along — nine screens down, in the Hunter Alpha
 * section. Both rows are read from the catalogue, so a price change moves them.
 */
const codenameAnswer = [
  hunterAlpha
    ? {
        codename: "Hunter Alpha",
        found: hunterAlpha.name,
        detail: `${hunterAlpha.vendor} · listed March 2026 · ${formatContextWindow(hunterAlpha.contextWindow)} context · ${formatPrice(hunterAlpha.inputPricePerMillion)} in / ${formatPrice(hunterAlpha.outputPricePerMillion)} out per million`,
        href: "/hunter-alpha",
      }
    : null,
  {
    codename: "Union Alpha",
    found: UNION_ALPHA_REVEAL.name,
    detail: `${UNION_ALPHA_REVEAL.vendor} · listed 16 September 2026 · revealed ${UNION_ALPHA_REVEAL.modelId} · ${formatPrice(UNION_ALPHA_REVEAL.inputPricePerMillion)} in / ${formatPrice(UNION_ALPHA_REVEAL.outputPricePerMillion)} out per million`,
    href: "/union-alpha",
  },
].filter((row): row is NonNullable<typeof row> => Boolean(row));

/*
 * Four numbers about the whole site rather than about one model. The pattern is the topic covers'
 * pattern — three counts and one figure of our own — because that last tile is the argument this
 * site is making: at least one number on the page came out of a machine we own.
 */
const hubStats = [
  {
    value: fmt(openrouterModels.length),
    label: "models in the directory",
    note: `price, context and modality, read ${modelHubDataAsOf}`,
  },
  {
    value: fmt(topicRecords("jev") + topicRecords("laya")),
    label: "records in the two sections",
    note: `${fmt(topicRecords("jev"))} Jev · ${fmt(topicRecords("laya"))} Laya, every one dated`,
  },
  {
    value: fmt(topicSizes.jev.builds + topicSizes.laya.builds),
    label: "repositories we track",
    note: "stars re-read by the GitHub ingest, never typed",
  },
  {
    value: "2",
    label: "models we ran ourselves",
    note: `Jev ${oursLatency.median} ms (${JEV_OURS_MEASURED_ON}) and Laya ${latencyCpu[0].p50} s (${LAYA_OURS_MEASURED_ON}) per question`,
  },
];
---
{/*
  No `| OpenRouter Model Hub` suffix here, unlike every other page: the live
  homepage title is used verbatim, and the root title is the single most
  valuable indexed string on the site. The parity check caught this.
*/}
{/*
  `noReferrer` is required from this build onwards: the hero and the wall hotlink clips from X's
  CDN, and video.twimg.com answers 403 to any request carrying a third-party Referer (see the prop
  in System.astro — the topic covers have carried it since their clips went in).
*/}
<System title={title} description={description} canonical={canonical} wide noReferrer>
  <JsonLd
    slot="head"
    data={webSiteSchema({
      name: "OpenRouter Model Hub",
      url: canonical,
      description:
        "Compare AI models on OpenRouter by pricing, context window, modality and best-use case.",
    })}
  />
  <JsonLd slot="head" data={breadcrumbSchema([{ name: "Home", url: canonical }])} />

  {/*
    The hero: words left, something real right. The right column is one cover card per live topic
    — the picture the topic itself leads with, playable when that post carries a clip, and linking
    into the section rather than into the post.

    The reader asked for this shape on the topic covers on 2026-09-24 ("一般网站左侧是文字介绍，
    右侧是图") and asked why the front page did not have it on 2026-09-25. It is the same shape:
    `.topic-hero` from `system.css`.
  */}
  <section class="topic-hero">
    <div class="hero-copy">
      <p class="card-eyebrow">OpenRouter model index</p>
      <h1 class="display">Find the Right AI Model</h1>
      <p class="lede">
        Compare 15+ AI models on OpenRouter side-by-side. Pricing, context windows, modality support
        and practical recommendations — read from the public catalogue and dated.
      </p>
      <p class="provenance">
        <span>Snapshot {modelHubDataAsOf}</span>
        <span>Drift-checked daily</span>
      </p>

      <ul class="stat-row">
        {hubStats.map((stat) => (
          <li>
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-note">{stat.note}</span>
          </li>
        ))}
      </ul>

      <p class="hero-actions">
        <a class="btn primary" href="/comparison">Compare models</a>
        <a class="btn ghost" href="/best-openrouter-models">See best picks</a>
      </p>
    </div>

    {/*
      One card, not a slide deck: **what we are following right now**, from `lib/spotlight.ts`.
      The card is the whole right column so the picture is worth looking at, and it carries the
      topic's own counts and its own date.

      Marked `data-generated`: the spotlight is a sample of one, and the record page it links to
      changes when the spotlight does — so the link-parity guard has to ignore it. The codename
      strip and the models index are navigation and are deliberately *not* marked: a link missing
      from those means a model left the catalogue, which is what the guard should stop and ask
      about. (The first attempt marked them, and the guard reported the six model links the old
      cards carried as dropped — its job, on a marker I put in the wrong place.)
    */}
    <div class="hero-media">
      {heroTopic?.data.post && (
        <figure class="hero-card" data-generated="hero-spotlight">
          {heroClip ? (
            <button
              class="xvideo-facade"
              type="button"
              data-xvideo={heroClip}
              data-poster={heroTopic.data.post.thumb}
              aria-label={`Play the clip on this ${heroTopic.data.name} card`}
            >
              <span class="card-src">{heroTopic.data.postLabel}</span>
              <img
                src={heroTopic.data.post.thumb}
                alt=""
                width={heroTopic.data.post.thumbW}
                height={heroTopic.data.post.thumbH}
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <span class="xvideo-play" aria-hidden="true">▶</span>
            </button>
          ) : (
            <a
              class="card-media"
              href={heroTopic.href}
              style={`--ratio: ${heroTopic.data.post.thumbW} / ${heroTopic.data.post.thumbH}`}
            >
              <span class="card-src">{heroTopic.data.postLabel}</span>
              <img
                src={heroTopic.data.post.thumb}
                alt=""
                width={heroTopic.data.post.thumbW}
                height={heroTopic.data.post.thumbH}
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
          )}
          <figcaption class="hero-cap">
            <span class="hero-cap-kicker">Following now · verified {heroTopic.data.verified}</span>
            <span class="hero-cap-title">{heroTopic.data.name} — {heroTopic.data.what}</span>
            <span class="hero-cap-meta">
              {fmt(heroTopic.data.recordCount)} records · {fmt(heroTopic.data.repos)} repositories
            </span>
            <a class="hero-cap-link" href={heroTopic.href}>
              Everything on {heroTopic.data.name} →
            </a>
            {heroTopic.data.postLink && (
              <>
                {" "}
                <a
                  class="hero-cap-link"
                  href={heroTopic.data.postLink.href}
                  rel={heroTopic.data.postLink.external ? "noopener noreferrer" : undefined}
                >
                  {heroTopic.data.postLink.label} →
                </a>
              </>
            )}
          </figcaption>
        </figure>
      )}

      {/*
        Card 2: the newest clip on the site, whoever posted it. This is the one that makes the
        first screen move without naming a model anywhere in this file — the row is whatever the
        feed says is newest and small enough to stream.
      */}
      {heroClipRow && (
        <figure class="hero-card" data-generated="hero-latest-clip">
          {heroClipRow.video ? (
            <button
              class="xvideo-facade"
              type="button"
              data-xvideo={heroClipRow.video}
              data-poster={heroClipRow.thumb}
              aria-label={`Play the clip in this entry: ${heroClipRow.headline}`}
            >
              <span class="card-src">{TOPIC_LABEL[heroClipRow.topic]} · {heroClipRow.kind}</span>
              <img
                src={heroClipRow.thumb}
                alt=""
                width={heroClipRow.thumbW}
                height={heroClipRow.thumbH}
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <span class="xvideo-play" aria-hidden="true">▶</span>
            </button>
          ) : (
            <a
              class="card-media"
              href={heroClipRow.href}
              rel={heroClipRow.external ? "noopener noreferrer" : undefined}
              style={`--ratio: ${heroClipRow.thumbW} / ${heroClipRow.thumbH}`}
            >
              <span class="card-src">{TOPIC_LABEL[heroClipRow.topic]} · {heroClipRow.kind}</span>
              <img
                src={heroClipRow.thumb}
                alt=""
                width={heroClipRow.thumbW}
                height={heroClipRow.thumbH}
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
          )}
          <figcaption class="hero-cap">
            <span class="hero-cap-kicker">Newest clip on the site · {heroClipRow.at}</span>
            <span class="hero-cap-title">{heroClipRow.headline}</span>
            <span class="hero-cap-meta">{heroClipRow.meta.join(" · ")}</span>
            <a
              class="hero-cap-link"
              href={heroClipRow.href}
              rel={heroClipRow.external ? "noopener noreferrer" : undefined}
            >
              {heroClipRow.external ? "Watch at the source" : "Open the record"} →
            </a>
          </figcaption>
        </figure>
      )}
    </div>
  </section>

  {/*
    The codename answer, on the first screen after the fold.

    This page is found for "hunter alpha" (1,423 impressions, position 6.9) and "hunter alpha ai"
    (position 3.4, 20% CTR), and until now the answer lived nine screens down in the Hunter Alpha
    section — while the h1 and the title never said the phrase at all. A reader who searched a
    codename now gets codename → model, dated, before they scroll.
  */}
  {/*
    Not marked `data-generated`, and that is deliberate: the marker tells the link-parity guard to
    ignore everything inside, and this block's two links are fixed navigation, not a sample. The
    same goes for the models index below — it lists every model, so a link missing from it is a
    model that left the catalogue, which is exactly what the guard should stop and ask about.
    (First attempt marked both. It reported the six model links the old cards used to carry as
    "dropped", which is the guard doing its job on a marker I put in the wrong place.)
  */}
  <section class="answer-strip">
    <h2 class="answer-strip-title">What the codenames turned out to be</h2>
    <dl class="answer-list">
      {codenameAnswer.map((row) => (
        <div class="answer-row">
          <dt><a href={row.href}>{row.codename}</a></dt>
          <dd>
            <span class="answer-found">→ {row.found}</span>
            <span class="answer-detail">{row.detail}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {/*
    What we follow: the two sections, as pictures.

    Their cover engravings were generated for the reference pages and, until now, never appeared
    where most readers meet the topic — the first screen of the site. These are the only two images
    on this page that belong to a *section* rather than to a record, so they are what makes "the
    things this site follows" visible instead of described.
  */}
  <section class="followed">
    <h2>What we follow</h2>
    <div class="followed-cards">
      {followedRows.map((row) => (
        <article class="card">
          <a class="card-media" href={row.href} style="--ratio: 16 / 9">
            <img src={row.cover} alt={row.coverAlt} width="1024" height="576" loading="lazy" decoding="async" />
          </a>
          <div class="card-body">
            <h3 class="card-title"><a href={row.href}>{row.name}</a></h3>
            <p class="card-body-text">{row.note}</p>
            <p class="card-meta">
              {fmt(row.records)} records · {fmt(row.repos)} repositories · verified {row.verified}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {/*
    The feed: what landed last, anywhere on the site — twelve cards, each labelled with the topic it
    came from, and the page's motion block. It sits above the catalogue table on purpose: the reader
    said the page "有内容但不够吸引人", and the fix was to lead with pictures and movement and keep
    the reference layer underneath.
  */}
  <section class="topic-wall" data-generated="site-feed">
    <h2>Latest across the site</h2>
    <p class="wall-note">
      The strongest recent records, newest first — projects, posts, recordings and threads from
      every model we follow. A row gets here once somebody other than us has looked at it: a post
      with a hundred likes, a repository with a hundred stars, a thread with fifteen points. Each
      card links to our own page where we have one and to the source where we do not — a card
      marked <strong>source</strong> leaves this site.
    </p>
    <TopicWall items={feed} columns={feedColumns} footPrefix="Both sections, in full:" />
  </section>

  {/* The player for any clip the hero or the feed rendered (see TopicWall.astro). */}
  <XClipWall />

  {/*
    The reference layer: every model this site covers, in one place, and the reason this page does
    not need editing when a model lands. A table, not cards — a price list is read down a column —
    and it comes after the pictures rather than in front of them.
  */}
  <section class="models-index">
    <h2>All {catalogueRows.length} models we compare</h2>
    <p class="wall-note">
      Served by OpenRouter and read from its catalogue on {modelHubDataAsOf}, which is what the
      comparison and the calculator price. A model we <strong>follow</strong> — Jev, Laya — has a
      section of its own above; these are the rest, with the numbers that decide a choice.
    </p>
    {/*
      `data-label` carries the column name into the narrow-screen layout, where each row becomes a
      block and the heading row is hidden.
    */}
    <table class="model-table">
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">In / out per 1M</th>
          <th scope="col">Context</th>
          <th scope="col">Best for</th>
        </tr>
      </thead>
      <tbody>
        {catalogueRows.map((row) => (
          <tr>
            <th scope="row">
              <a href={row.href}>{row.name}</a>
              <span class="model-vendor">{row.vendor}</span>
            </th>
            <td data-label="In / out per 1M">
              {row.input} / {row.output}
            </td>
            <td data-label="Context">{row.context}</td>
            <td data-label="Best for">{row.bestFor}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="wall-note">
      The pick for each workload, named:{" "}
      {workloadPicks.map((pick, index) => (
        <>
          {index > 0 && " · "}
          <a href={pick.href}>{pick.model}</a> <span class="pick-scenario">({pick.scenario})</span>
        </>
      ))}{" "}
      — see <a href="/best-openrouter-models">the full reasoning</a> or{" "}
      <a href="/openrouter-models">the directory</a>.
    </p>
  </section>

  {/*
    The routing row. It used to carry a fifth card for the Jev topic; that card went when the hero
    grew a cover per topic (2026-09-25), because the same link twice on one screen is the page
    arguing with itself about which one is the entrance. The Union Alpha banner that sat above this
    row went for the same reason: it is one of these cards, and the codename stopped being the news
    the moment it was revealed.
  */}
  <h2>Where to go next</h2>
  <div class="grid-cards">
    {entryPoints.map((entry) => (
      <article class="card">
        <p class="card-kicker">{entry.kicker}</p>
        <h3 class="card-title"><a href={entry.href}>{entry.title}</a></h3>
        <p class="card-body">{entry.body}</p>
      </article>
    ))}
  </div>

  {hunterAlpha && (
    <section class="card hunter">
      <h2 style="margin-top: 0;">Hunter Alpha on OpenRouter</h2>
      <p class="measure">
        Hunter Alpha was the anonymous model that appeared on OpenRouter in March 2026 with a 1M-token
        context window and no maker attached. It did not stay anonymous: it was confirmed as{" "}
        <strong>{hunterAlpha.name}</strong> in the same month, and it is now a normal paid model on
        OpenRouter at {formatPrice(hunterAlpha.inputPricePerMillion)} in /{" "}
        {formatPrice(hunterAlpha.outputPricePerMillion)} out per million tokens with a{" "}
        {formatContextWindow(hunterAlpha.contextWindow)} window. If you came here looking for the
        codename, that is the model you want.
      </p>
      <p class="measure">
        The codename still circulates in a few spellings — <em>alpha hunter</em>, <em>hunteralpha</em>,{" "}
        <em>Hunter-Alpha</em> — and it also lives on as history: this site started as a tracker for it.
        The line it belonged to is still running: the most recent codename was{" "}
        <a href="/union-alpha">Union Alpha</a>, revealed on 18 September 2026 as Unbiased Pareto.
      </p>
      <p class="hero-actions">
        <a class="btn primary" href={`/openrouter-models/${hunterAlpha.slug}`}>
          {hunterAlpha.name} details →
        </a>
        <a class="btn ghost" href="/hunter-alpha">Hunter Alpha archive</a>
        <a class="btn ghost" href="/hunter-alpha-benchmarks">Benchmarks: verified vs claimed</a>
      </p>
    </section>
  )}

  <Provenance
    source="openrouter.ai/api/v1/models"
    verified={modelHubDataAsOf}
    extra={["One catalogue snapshot keeps the comparison, the calculator and this page consistent"]}
  />
</System>

<style>
  /*
   * The hero, the numbers strip and the card band come from the "front pages" section of
   * `system.css` — three callers now, so they are shared rather than copied. What is left here is
   * what only this page has: the codename answer, the model index, and the routing cards.
   */
  .grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .card-kicker { margin: 0; font-size: var(--text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-faint); }
  .card-title { margin: var(--space-1) 0 var(--space-2); font-size: var(--text-lg); }
  .card-body { margin: 0; color: var(--text-muted); font-size: var(--text-sm); }
  .card-meta { margin: var(--space-2) 0 0; color: var(--text-faint); font-size: var(--text-xs); }

  /* The hero card's eyebrow: "Following now", which is the one thing on the card that changes
     week to week, so it is labelled rather than implied. */
  .hero-cap-kicker {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /*
   * The codename answer. A definition list, because that is what it is — two terms and two
   * answers — and it reads as one line per codename rather than as two more cards.
   */
  .answer-strip {
    border-top: 2px solid var(--border-strong);
    border-bottom: 1px solid var(--border);
    padding: var(--space-5) 0;
    margin: var(--space-8) 0 var(--space-10);
  }
  .answer-strip-title {
    margin: 0 0 var(--space-4);
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 400;
  }
  .answer-list { margin: 0; display: grid; gap: var(--space-4); }
  .answer-row {
    display: grid;
    grid-template-columns: minmax(140px, 180px) minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    align-items: baseline;
  }
  .answer-row dt { font-family: var(--sans); font-size: var(--text-lg); font-weight: 600; }
  .answer-row dd { margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .answer-found { font-weight: 600; }
  .answer-detail { font-size: var(--text-sm); color: var(--text-muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 620px) {
    .answer-row { grid-template-columns: minmax(0, 1fr); }
  }

  /*
   * The models index.
   *
   * This is the "all the models in one place" layer the reader asked for, and the answer to "does
   * the front page need editing when a model lands": no — the catalogue half is the snapshot, and
   * the followed half is the spotlight list, so neither is typed here.
   *
   * A table for the catalogue half rather than cards, because a price list is read down a column.
   * On a narrow screen each row becomes a block and `data-label` supplies the column name, which
   * is the one thing a stacked table otherwise loses.
   */
  .models-index { margin-bottom: var(--space-12); }

  /* The two followed sections, as pictures. Two up on a desktop, stacked on a phone. */
  .followed { margin-bottom: var(--space-10); }
  .followed-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  @media (max-width: 760px) {
    .followed-cards { grid-template-columns: minmax(0, 1fr); }
  }
  .followed-cards .card { margin-bottom: 0; }
  .card-body-text { margin: 0; color: var(--text-muted); font-size: var(--text-sm); }

  .model-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .model-table th,
  .model-table td {
    text-align: left;
    vertical-align: baseline;
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--border);
  }
  .model-table thead th {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 400;
    border-bottom: 1px solid var(--border-strong);
  }
  .model-table tbody th { font-weight: 600; }
  .model-table td { color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .model-vendor { display: block; font-weight: 400; font-size: var(--text-xs); color: var(--text-faint); }
  @media (max-width: 760px) {
    .model-table thead { display: none; }
    .model-table tr { display: block; padding: var(--space-4) 0; border-bottom: 1px solid var(--border); }
    .model-table th, .model-table td { display: block; border: 0; padding: 0; }
    .model-table tbody td::before {
      content: attr(data-label) " · ";
      font-family: var(--mono);
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-faint);
    }
    .model-table tbody td { margin-top: var(--space-2); }
  }
  /* The workload picks: one sentence under the table, not six cards above it. */
  .pick-scenario { color: var(--text-faint); }

  .hunter {
    margin-bottom: var(--space-10);
  }
  .measure {
    color: var(--text-muted);
    max-width: var(--measure);
  }
</style>
