---
import Base from "../layouts/Base.astro";
import { readFileSync, readdirSync } from "node:fs";

// Reads the existing model snapshot so the sample page shows real numbers rather
// than placeholder text. During migration this becomes a shared TS module.
const repoRoot = process.env.SITE_ROOT ?? "../";
const modelsSource = readFileSync(`${repoRoot}/lib/openrouter-models.ts`, "utf8");
const rows = [...modelsSource.matchAll(/slug: "([^"]+)",\s*\n\s*name: "([^"]+)",\s*\n\s*vendor: "([^"]+)",\s*\n\s*contextWindow: ([\d_]+),\s*\n\s*inputPricePerMillion: ([\d.]+),\s*\n\s*outputPricePerMillion: ([\d.]+)/g)]
  .map((m) => ({
    slug: m[1],
    name: m[2],
    vendor: m[3],
    context: Number(m[4].replace(/_/g, "")),
    input: Number(m[5]),
    output: Number(m[6]),
  }))
  .slice(0, 8);

const fmtContext = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 2)}M` : `${Math.round(n / 1024)}K`);
const fmtPrice = (n: number) => (n === 0 ? "free" : `$${n.toFixed(n < 1 ? 3 : 2)}`);

const blogCount = readdirSync(`${repoRoot}/lib`).filter((f) => f.endsWith(".ts")).length;
---
<Base
  title="Hunter Alpha Hub — OpenRouter model index"
  description="Compare OpenRouter models by price, context window and modality. Verified facts, dated."
  canonical="https://www.hunteralphahub.com/"
>
  <h1>OpenRouter models, verified and dated</h1>
  <p class="lede">
    Prices, context windows and modalities read from the public catalogue. Stealth releases are
    tracked separately and always labelled as claimed or verified.
  </p>

  <h2>Snapshot</h2>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr>
          <th>Model</th>
          <th>Vendor</th>
          <th class="num">Context</th>
          <th class="num">Input /M</th>
          <th class="num">Output /M</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td><a href={`/openrouter-models/${row.slug}`}>{row.name}</a></td>
            <td style="color: var(--text-muted);">{row.vendor}</td>
            <td class="num">{fmtContext(row.context)}</td>
            <td class="num">{fmtPrice(row.input)}</td>
            <td class="num">{fmtPrice(row.output)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="provenance">
    <span>Source: <code>lib/openrouter-models.ts</code> ({rows.length} of the curated set shown)</span>
    <span>Verified <code>2026-09-17</code></span>
    <span>Drift re-checked daily at <code>06:00</code></span>
    <span>{blogCount} data modules loaded</span>
  </div>

  <h2>What this sample is</h2>
  <p class="prose">
    A design-system sample, not a finished page: it exists to settle typography, table behaviour,
    the provenance line and the fact-versus-claim labelling before the other 27 pages are migrated.
  </p>
  <p class="prose">
    Compare the variants: <a href="/">v1 dark console</a> · <a href="/v2/">v2 data console (calibrated)</a> ·
    <a href="/v3/">v3 editorial hybrid</a> · <a href="/v4/">v4 paper console (warm ivory)</a>.
    · <a href="/v5/">v5 paper journal (warm ivory + serif display)</a>.
    · <a href="/v6/">v6 paper journal + designed header/footer</a>.
    · <a href="/v7/">v7 paper journal + publication masthead</a>.
    · <a href="/v8/">v8 compact single-row sticky header</a>.
    · <a href="/v9/">v9 wordmark studies (pick one)</a>.
    · <a href="/v10/">v10 masthead + brand in sticky row</a>.
    · <a href="/v11/">v11 masthead that shrinks on scroll</a>.
    · <a href="/v12/">v12 masthead collapsing into a single row (recommended)</a>.
  </p>
</Base>
