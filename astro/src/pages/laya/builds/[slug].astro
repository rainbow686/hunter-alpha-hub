---
/**
 * /laya/builds/<slug> — one project, with the part nobody else has.
 *
 * The dossier, and the reason this topic can carry eighteen GitHub rows without becoming a link
 * dump: what it does, how it works, what we read, and — printed as a section rather than as a
 * footnote — what we did not check. The rail carries the repository's own numbers with the day we
 * read them (ADR-0024).
 *
 * There is no claims block here, unlike the Jev build pages: Laya's authors publish fewer
 * self-reported figures, and the ones they do publish are in the dossier prose where they belong.
 * A claims file with two entries would be a mechanism looking for a use.
 */
import System from "../../../layouts/System.astro";
import JsonLd from "../../../components/JsonLd.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import TopicIndex from "../../../components/TopicIndex.astro";
import { articleSchema, SITE, SITE_NAME } from "../../../lib/schema";
import { layaBuilds, layaBuildsWithPages } from "@repo/lib/laya-builds";
import { layaTopicEntries } from "@repo/lib/laya-topic";
import { LAYA_KIND_COUNTS } from "@repo/lib/laya-kinds";

export function getStaticPaths() {
  return layaBuildsWithPages.map((build) => ({ params: { slug: build.dossier!.slug }, props: { build } }));
}

const { build } = Astro.props;
const dossier = build.dossier!;
const canonical = `${SITE}/laya/builds/${dossier.slug}`;
const fmt = (n: number) => n.toLocaleString("en-US");
const kindLabel = (slug: string) => LAYA_KIND_COUNTS.find((k) => k.slug === slug)?.label ?? slug;

/* "More like this": rows that share a kind, excluding this one. */
const related = layaBuildsWithPages
  .filter((other) => other.id !== build.id && other.tags.some((tag) => build.tags.includes(tag)))
  .slice(0, 3);

const title = `${build.title}: what it does, and what we checked`;
const description = `${build.title} — ${dossier.bestFor}. Stars, licence and stack read from the repository on ${dossier.readOn}, with the parts we did not check stated.`;
---

{/*
  `wide`: this is a two-column page (prose plus a Details rail), and ADR-0019 puts two-column pages
  in the full frame — a rail inside the narrow column leaves about 450px for the prose.
*/}
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} wide ogType="article">
  <JsonLd
    slot="head"
    data={articleSchema({
      title: build.title,
      description,
      publishedAt: dossier.readOn,
      updatedAt: dossier.readOn,
      image: `${SITE}${build.card ?? "/og-image.png"}`,
      url: canonical,
    })}
  />

  <Breadcrumbs
    schema={true}
    items={[
      { name: "Laya", url: `${SITE}/laya` },
      { name: "Builds", url: `${SITE}/laya/builds` },
      { name: build.title, url: canonical },
    ]}
  />

  <article class="build">
    <div class="build-main">
      <header>
        <p class="card-eyebrow">GitHub · {build.tags.map((t) => kindLabel(t)).join(" · ") || "infrastructure"}</p>
        <h1>{build.title}</h1>
        <p class="lede">{dossier.bestFor.charAt(0).toUpperCase() + dossier.bestFor.slice(1)}.</p>
      </header>

      {build.card && (
        <figure class="build-card">
          <img src={build.card} width="1280" height="640" alt={`The repository's GitHub card, read on ${dossier.readOn}`} loading="eager" decoding="async" />
        </figure>
      )}

      <section>
        <h2>What it does</h2>
        <p>{dossier.whatItDoes}</p>
        {build.what && <p class="quoted">The repository's own description: “{build.what}”</p>}
      </section>

      <section>
        <h2>How it works</h2>
        <p>{dossier.howItWorks}</p>
      </section>

      <section>
        <h2>The repository, by the numbers</h2>
        <div class="stat-strip">
          <div class="stat">
            <div class="stat-label">Stars</div>
            <div class="stat-value">{fmt(build.stars)}</div>
          </div>
          <div class="stat">
            <div class="stat-label">{build.forks === null ? "Licence" : "Forks"}</div>
            <div class="stat-value">{build.forks === null ? dossier.license : fmt(build.forks)}</div>
          </div>
          <div class="stat">
            <div class="stat-label">{build.language ? "Language" : "Stack"}</div>
            <div class="stat-value">{build.language ?? dossier.stack}</div>
          </div>
          <div class="stat">
            <div class="stat-label">Last push</div>
            <div class="stat-value">{build.pushedAt}</div>
          </div>
        </div>
        <p class="stat-note">
          Read from the GitHub API on {build.starsAsOf}. Stars and the last push move daily — quote
          them with the date, the way we do.
        </p>
      </section>

      <section>
        <h2>What we checked</h2>
        <ul class="checked">
          {dossier.whatWeChecked.map((item) => <li>{item}</li>)}
        </ul>
        <p class="not-checked"><strong>What we did not check. </strong>{dossier.whatWeDidNotCheck}</p>
      </section>

      <p class="hero-actions">
        <a class="btn primary" href={build.url} rel="noopener noreferrer">Open the repository ↗</a>
        <a class="btn ghost" href="/laya/builds">All builds</a>
      </p>
    </div>

    <aside class="build-rail">
      <h2>Details</h2>
      <dl>
        <dt>Author</dt><dd>{build.author}</dd>
        <dt>Stars</dt><dd>{fmt(build.stars)}</dd>
        <dt>Last push</dt><dd>{build.pushedAt}</dd>
        <dt>Licence</dt><dd>{dossier.license}</dd>
        <dt>Stack</dt><dd>{dossier.stack}</dd>
        <dt>Read on</dt><dd>{dossier.readOn}</dd>
      </dl>
      <p class="rail-note">
        Stars and the last push come from GitHub and move; the date above is when we read them. The
        licence and the stack come from the files in the repository.
      </p>
      <div class="rail-tags">
        {build.tags.map((tag) => <a href={`/laya/kinds/${tag}`}>{kindLabel(tag)}</a>)}
      </div>
    </aside>
  </article>

  {/* `data-generated`: three nearest rows sharing a kind — see the Jev build pages. */}
  {related.length > 0 && (
    <section class="related" data-generated="related-builds">
      <h2>More like this</h2>
      <ul class="card-grid">
        {related.map((other) => (
          <li class="card" data-sources="github" data-tags={other.tags.join(" ")}>
            <div class="card-body">
              <p class="card-eyebrow">GitHub · {other.tags.map((t) => kindLabel(t)).join(" · ")}</p>
              <h3 class="card-title"><a href={`/laya/builds/${other.dossier!.slug}`}>{other.title}</a></h3>
              <p class="card-note">{other.dossier!.bestFor.charAt(0).toUpperCase() + other.dossier!.bestFor.slice(1)}.</p>
              <p class="card-meta"><span>{fmt(other.stars)} ★</span><span>last push {other.pushedAt}</span></p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <TopicIndex entries={layaTopicEntries} current="/laya/builds" title="The rest of the topic" />
</System>

<style>
  /* The rail layout, copied from the Jev build pages because it is the same problem: prose and a
     table of facts on one screen. Below 1100px the rail becomes a block under the intro. */
  .build { display: grid; gap: var(--space-8); align-items: start; }
  @media (min-width: 1100px) {
    .build { grid-template-columns: minmax(0, 1fr) 300px; gap: var(--space-12); }
    .build-rail { border-left: 1px solid var(--border-strong); border-top: 0; border-right: 0; border-bottom: 0; border-radius: 0; background: transparent; padding: var(--space-1) 0 0 var(--space-5); position: sticky; top: 84px; }
  }
  .build-main { min-width: 0; max-width: var(--measure); }
  .build-main h1 { margin: var(--space-2) 0 var(--space-3); }
  .build-main section { margin-top: var(--space-8); }
  .build-main h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .build-main p { color: var(--text-muted); }
  .build-card { margin: var(--space-6) 0 0; }
  .build-card img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius); display: block; }
  .quoted { font-style: italic; }
  .checked { margin: 0; padding-left: var(--space-5); color: var(--text-muted); }
  .checked li { margin-bottom: var(--space-2); }
  .not-checked {
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--warn);
    background: var(--warn-soft);
    border-radius: var(--radius-sm);
  }
  .not-checked strong { color: var(--text); }
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stat { background: var(--surface); padding: var(--space-3) var(--space-4); }
  .stat-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .stat-value { margin-top: var(--space-1); font-size: var(--text-lg); color: var(--text); font-variant-numeric: tabular-nums; }
  .stat-note { margin: var(--space-3) 0 0; font-size: var(--text-xs); color: var(--text-faint); }
  .build-rail { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: var(--space-5); }
  .build-rail h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 400;
  }
  .build-rail dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: var(--space-2) var(--space-3); font-size: var(--text-sm); }
  .build-rail dt { color: var(--text-faint); }
  .build-rail dd { margin: 0; color: var(--text); }
  .rail-note { margin: var(--space-4) 0 0; font-size: var(--text-xs); color: var(--text-faint); }
  .rail-tags { margin-top: var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .rail-tags a {
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
  }
  .related { margin-top: var(--space-12); }
  .related h2 { margin-bottom: 0; }
</style>
