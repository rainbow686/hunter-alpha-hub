---
/**
 * Best models by workload — the "which one should I pick" page.
 *
 * Kept deliberately scenario-shaped rather than a single ranked list: the picks
 * come from `modelsForScenario`, so they move with the snapshot and a model
 * cannot be recommended for work its own entry does not list as a fit.
 *
 * Parity contract (npm run verify:pages): title, description, canonical, one h1,
 * and exactly Article + ItemList + ListItem + BreadcrumbList — the live page
 * carries no FAQPage, so this one must not add one.
 */
import System from "../../layouts/System.astro";
import JsonLd from "../../components/JsonLd.astro";
import { articleSchema, breadcrumbSchema, itemListSchema, SITE, SITE_NAME } from "../../lib/schema";
import { defaultScenarios, modelHubDataAsOf, modelsForScenario } from "@repo/lib/openrouter-models";

const title = "Best OpenRouter Models for Coding, Long Context & Budget (2026)";
const description =
  "A practical list of the best OpenRouter models by scenario: coding, long context, budget, multimodal work and agents. Updated with current pricing and context windows.";
const canonical = `${SITE}/best-openrouter-models`;
---
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical}>
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Best OpenRouter Models for Coding, Long Context & Budget",
      description:
        "A practical list of the best OpenRouter models by scenario, with current pricing and context windows.",
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <JsonLd
    slot="head"
    data={itemListSchema(
      "Best OpenRouter models by scenario",
      defaultScenarios.flatMap((scenario) =>
        modelsForScenario(scenario.scenario, 1).map((model) => ({
          name: `${scenario.title}: ${model.name}`,
          url: `${SITE}/openrouter-models/${model.slug}`,
        })),
      ),
    )}
  />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "Best OpenRouter Models", url: canonical },
    ])}
  />

  <p class="kicker">Picks · by workload</p>
  <h1 class="display">Best OpenRouter Models</h1>
  <p class="lede">
    Not one universal winner — a practical list by workload. Use these picks for coding, long documents,
    high-volume extraction, multimodal work and agents.
  </p>
  <div class="byline">
    <span>Data snapshot {modelHubDataAsOf}</span>
    <span><a href="/comparison">Full side-by-side →</a></span>
  </div>
  <p class="measure">
    Every pick here is a named, priced model on purpose. If you want the free option, the current anonymous
    release is <a href="/union-alpha">Union Alpha</a> — read{" "}
    <a href="/union-alpha-free">what its free window means</a> before you depend on it.
  </p>

  {defaultScenarios.map((scenario) => (
    <section>
      <h2>{scenario.title}</h2>
      <p class="measure">{scenario.description}</p>
      <div class="picks">
        {modelsForScenario(scenario.scenario, 3).map((model, index) => (
          <article class="card">
            <p class="rank">#{index + 1} pick</p>
            <p class="pick-name"><a href={`/openrouter-models/${model.slug}`}>{model.name}</a></p>
            <p class="pick-note">{model.strengths[0]}</p>
            <p class="pick-meta">{model.formerAlias ? `formerly ${model.formerAlias}` : model.vendor}</p>
          </article>
        ))}
      </div>
    </section>
  ))}

  <p class="hero-actions">
    <a class="btn primary" href="/comparison">Compare every model</a>
    <a class="btn ghost" href="/openrouter-pricing-calculator">Estimate monthly cost</a>
    <a class="btn ghost" href="/openrouter-models">Full directory</a>
  </p>
</System>

<style>
  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
  }
  .rank {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .pick-name {
    margin: var(--space-2) 0 0;
    font-weight: 600;
  }
  .pick-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .pick-meta {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--text-faint);
  }
  .measure {
    color: var(--text-muted);
    max-width: var(--measure);
  }
</style>
