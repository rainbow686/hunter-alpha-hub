---
/**
 * Union Alpha on OpenCode — the "two front doors" page.
 *
 * The reason this page is worth migrating carefully is its one editorial move:
 * the OpenRouter route is a verified catalogue read, the OpenCode route is a
 * third-party claim, and the page says so in the same block rather than
 * blending them into "you can use it free in OpenCode". Two labelled boxes, not
 * one confident sentence.
 *
 * Parity contract (npm run verify:pages): title, description, canonical, one h1,
 * Article + FAQPage + BreadcrumbList.
 */
import System from "../../layouts/System.astro";
import JsonLd from "../../components/JsonLd.astro";
import Faq from "../../components/Faq.astro";
import RevealNotice from "../../components/RevealNotice.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { articleSchema, breadcrumbSchema, faqSchema, SITE, SITE_NAME } from "../../lib/schema";
import {
  UNION_ALPHA_DATA_AS_OF,
  UNION_ALPHA_MODEL_ID,
  UNION_ALPHA_OPENROUTER_URL,
  UNION_ALPHA_REVEAL,
} from "@repo/lib/union-alpha";

const title = "Union Alpha on OpenCode: What Happened to the Free Route (2026)";
const description =
  "The Union Alpha free route is over: the model was revealed as Unbiased Pareto on 2026-09-18 and delisted. What was verified about the OpenCode route, what was only reported, and what to do instead.";
const canonical = `${SITE}/union-alpha-opencode`;

const frontDoors = [
  {
    label: "OpenRouter route",
    verdict: "Gone",
    tone: "warn",
    detail: `${UNION_ALPHA_MODEL_ID} was delisted on ${UNION_ALPHA_DATA_AS_OF}; the same model is listed as ${UNION_ALPHA_REVEAL.modelId}, billed.`,
  },
  {
    label: "OpenCode route",
    verdict: "Reported, and now moot",
    tone: "claim",
    detail:
      "Third-party write-ups said the same anonymous model was on OpenCode's free tier. We never confirmed it independently, and the anonymous model no longer exists to serve.",
  },
  {
    label: "API key needed",
    verdict: "Key needed now",
    tone: "",
    detail:
      `Using ${UNION_ALPHA_REVEAL.modelId} means billing it, which means an OpenRouter key. No key from the maker was ever published.`,
  },
  {
    label: "Was it worth setting up",
    verdict: "For two days",
    tone: "",
    detail: "The free window lasted 2026-09-16 to 2026-09-18. Anything built to depend on it had to change on day three.",
  },
];

const howToTry = [
  {
    title: "1. Install and sign in to OpenCode.",
    body: "The free tier is the part to look for — it is the route that does not ask for your own provider key.",
  },
  {
    title: "2. Look for the anonymous model in the picker.",
    body: "Free stealth releases often appear without a vendor name attached. If you see an unexplained model alongside the named providers, that is the thing to test.",
  },
  {
    title: "3. Run one prompt you already know the answer to.",
    body: "The identity of the model behind an anonymous endpoint is not something it can tell you reliably, so judge it on output, not on what it says about itself.",
  },
  {
    title: "4. Assume it can vanish.",
    body: "Keep the workflow disposable: no credentials in prompts, no customer data, no dependency your product needs tomorrow.",
  },
];

const checkYourself = [
  {
    want: "Is it still on OpenRouter, and still free?",
    where: `No. The <a href="/api/union-alpha/status">status endpoint</a> answers “no longer listed”, and the <a href="${UNION_ALPHA_OPENROUTER_URL}" rel="noopener noreferrer">stealth page ↗</a> still carries the reveal notice.`,
  },
  {
    want: "Is the OpenCode free tier still serving it?",
    where: "Unknown, and no longer worth checking: the anonymous model was delisted from OpenRouter, which is the route both write-ups pointed at.",
  },
  {
    want: "What it costs now",
    where: `$${UNION_ALPHA_REVEAL.inputPricePerMillion.toFixed(2)} in / $${UNION_ALPHA_REVEAL.outputPricePerMillion.toFixed(2)} out per million, read from the catalogue. See <a href="/union-alpha-free">the free-window page</a>.`,
  },
];

const faqs = [
  {
    question: "Is Union Alpha really available on OpenCode?",
    answer:
      "It was reported, never verified by us — and it is now moot. OpenCode's free tier was described by third parties as serving the same anonymous model; our own verification was always limited to OpenRouter, where we read the catalogue directly. That catalogue entry was removed on 2026-09-18 when the model was revealed as Unbiased Pareto, so there is no anonymous Union Alpha left to route anywhere.",
  },
  {
    question: "Do I need an OpenRouter API key to use Union Alpha through OpenCode?",
    answer:
      "That was the appeal of the OpenCode route: no key of your own. It is gone with the free window. The revealed model, unbiased/pareto, is a normal billed OpenRouter listing, so using it now does need an OpenRouter key.",
  },
  {
    question: "Was it the same model on both routes?",
    answer:
      "Reportedly yes: same anonymous release, two front doors. We could never prove it from outside, and the model's own answers about its identity were unreliable — testers reported inconsistent behaviour between sessions, which is one of the reasons people suspected more than one model behind the name.",
  },
  {
    question: "What should I not use Union Alpha for?",
    answer:
      "Anything with secrets or other people's data — the advice has not changed now that the vendor has a name. Free stealth previews on this line have ended without warning three times, and the anonymous era of this model lasted two days. Evaluation and side projects, yes; production credentials or customer data, no.",
  },
];
---
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} ogType="article">
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Union Alpha on OpenCode: How to Use the Free Tier",
      description:
        "The OpenCode route as it stood during the anonymous window, and what replaced it after the 2026-09-18 reveal.",
      publishedAt: "2026-09-17",
      updatedAt: UNION_ALPHA_DATA_AS_OF,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <JsonLd slot="head" data={faqSchema(faqs)} />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "Union Alpha", url: `${SITE}/union-alpha` },
      { name: "OpenCode", url: canonical },
    ])}
  />

  <p class="kicker">Stealth line · Union Alpha · access</p>
  <h1 class="display">Union Alpha on OpenCode</h1>
  <p class="lede">
    Union Alpha was reported to have two front doors: the OpenRouter listing we could verify directly, and an
    OpenCode free-tier route that third parties described. Both closed on 2026-09-18, when the model was
    revealed as Unbiased Pareto. This page keeps the verified route and the reported one apart — and says which
    of the two we never managed to confirm.
  </p>

  <RevealNotice compact />

  <section id="short-version">
    <h2>The short version</h2>
    <div class="doors">
      {frontDoors.map((door) => (
        <article class="card door">
          <p class="door-label">{door.label}</p>
          <p class={`door-verdict ${door.tone ? `v-${door.tone}` : ""}`}>{door.verdict}</p>
          <p class="door-detail">{door.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="two-doors">
    <h2>Two front doors, one anonymous release — both shut</h2>
    <p class="measure">
      OpenRouter was the route we track, and the source of every verified number on our{" "}
      <a href="/union-alpha">tracker</a>: its catalogue listed <code>{UNION_ALPHA_MODEL_ID}</code> under the{" "}
      <em>stealth</em> namespace with a provider tag of “Stealth” from 2026-09-16 until it was delisted on the
      18th.
    </p>
    <p class="measure">
      OpenCode is the route we cannot see. The claim is that the free tier of the OpenCode coding tool serves the
      same anonymous model, which would let you use it inside an agentic workflow without an API key of your own.
      It is plausible — stealth releases are often seeded through several tools at once to gather usage — but
      “plausible” is not “verified”, and we are not going to report it as fact.
    </p>
  </section>

  <section id="how-to-try">
    <h2>How the route worked, while it was open</h2>
    <ol class="stages">
      {howToTry.map((step) => (
        <li>
          <strong>{step.title}</strong> {step.body}
        </li>
      ))}
    </ol>
    <p class="measure">
      We deliberately do not print a screenshot-accurate click path: the free tier's menu wording changes
      between OpenCode releases, and a stale step-by-step would be worse than none. These four steps are kept
      as the record of what a stealth seeding looked like, because the next codename will repeat the pattern.
    </p>
  </section>

  <section id="check">
    <h2>How to check for yourself</h2>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>What you want to know</th>
            <th>Where it can be checked</th>
          </tr>
        </thead>
        <tbody>
          {checkYourself.map((row) => (
            <tr>
              <td style="color: var(--text-muted);">{row.want}</td>
              <td set:html={row.where} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="faq">
    <h2>FAQ</h2>
    <Faq items={faqs} />
  </section>

  <section class="card" style="margin-top: var(--space-10);">
    <h2 style="margin-top: 0;">Get notified about the next codename</h2>
    <p class="measure">
      This reveal is over. One email when the next stealth model is listed, and one when its identity comes out.
    </p>
    <SubscribeForm />
  </section>

  <p class="hero-actions">
    <a class="btn primary" href="/union-alpha">Union Alpha tracker →</a>
    <a class="btn ghost" href="/union-alpha-free">What it costs now</a>
    <a class="btn ghost" href="/alpha-models">How the Alpha line works</a>
  </p>
</System>

<style>
  .doors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .door-label {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .door-verdict {
    margin: var(--space-1) 0;
    font-weight: 600;
  }
  .door-detail {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .v-verified {
    color: var(--success);
  }
  .v-claim {
    color: var(--warn);
  }
  .v-warn {
    color: var(--danger);
  }
  .measure {
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .stages {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .stages li {
    margin-bottom: var(--space-3);
  }
  .stages strong {
    color: var(--text);
  }
</style>
