---
/**
 * Is Union Alpha free? — the pricing sub-page of the tracker cluster.
 *
 * The whole page exists to make one distinction that the rest of the internet
 * blurs: a catalogue read with a date on it versus a claim somebody made. That
 * distinction got its first real test on 2026-09-18, when the free window closed
 * and the "≈$0.50 / $1.50" rumour was replaced by a listed $2.50 / $7.50. Both
 * kinds of number are in the same table, in different rows, with different
 * status labels — never averaged into one number.
 *
 * Parity contract (npm run verify:pages): title, description, canonical, one
 * h1, Article + FAQPage + BreadcrumbList.
 */
import System from "../../layouts/System.astro";
import JsonLd from "../../components/JsonLd.astro";
import Faq from "../../components/Faq.astro";
import Provenance from "../../components/Provenance.astro";
import RevealNotice from "../../components/RevealNotice.astro";
import StatusStrip from "../../components/StatusStrip.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { articleSchema, breadcrumbSchema, faqSchema, SITE, SITE_NAME } from "../../lib/schema";
import {
  UNION_ALPHA_DATA_AS_OF,
  UNION_ALPHA_MODEL_ID,
  UNION_ALPHA_OPENROUTER_URL,
  UNION_ALPHA_REVEAL,
} from "@repo/lib/union-alpha";

const title = "Is Union Alpha Free? No — the Free Window Is Over (2026)";
const description =
  "Union Alpha was free for two days. As of 2026-09-18 the stealth route is delisted; the model behind it, Unbiased Pareto, bills $2.50 in / $7.50 out per million tokens.";
const canonical = `${SITE}/union-alpha-free`;

/**
 * One row per fact, and the status column says which kind of fact it is.
 *
 * The anonymous era and the revealed model are both here on purpose: the page
 * answers a question whose answer changed on 2026-09-18, and a reader arriving
 * from search needs to see which rows are history and which are current.
 */
const priceRows = [
  {
    field: "Model id",
    value: UNION_ALPHA_MODEL_ID,
    status: "Delisted 2026-09-18",
    tone: "warn",
    code: true,
  },
  {
    field: "Price during the window",
    value: "$0 / $0",
    status: "Verified 2026-09-16 → 09-18",
    tone: "verified",
  },
  {
    field: "Revealed as",
    value: UNION_ALPHA_REVEAL.modelId,
    status: `Verified ${UNION_ALPHA_DATA_AS_OF}`,
    tone: "verified",
    code: true,
  },
  {
    field: "Price now, per million in / out",
    value: `$${UNION_ALPHA_REVEAL.inputPricePerMillion.toFixed(2)} / $${UNION_ALPHA_REVEAL.outputPricePerMillion.toFixed(2)}`,
    status: `Verified ${UNION_ALPHA_DATA_AS_OF}`,
    tone: "verified",
  },
  {
    field: "The price that was reported during the window",
    value: "≈ $0.50 in / $1.50 out per million",
    status: "Claim — did not hold",
    tone: "claim",
  },
  {
    field: "Notice before it changed",
    value: "None published",
    status: "It changed without one",
    tone: "warn",
  },
];

const precedent = [
  {
    codename: "Hunter Alpha",
    revealedAs: "Xiaomi MiMo-V2.5",
    outcome: "Repriced as a normal paid model after the reveal",
  },
  {
    codename: "OX Alpha",
    revealedAs: "Z.ai GLM 5.3 Flash",
    outcome: "Folded into the vendor's own lineup at its list price",
  },
  {
    codename: "Union Alpha",
    revealedAs: "Unbiased Pareto",
    outcome: "Revealed and delisted on day three; relisted under its real name at list price",
    current: true,
  },
];

const faqs = [
  {
    question: "Is Union Alpha free right now?",
    answer:
      "No. It was free for the two days of the stealth window, 2026-09-16 to 2026-09-18, and is not any more: stealth/union-alpha was removed from the OpenRouter catalogue when the model was revealed as Unbiased Pareto, which is listed at $2.50 per million input tokens and $7.50 per million output tokens.",
  },
  {
    question: "How long was it free?",
    answer:
      "Two days. Listed 2026-09-16, revealed and delisted 2026-09-18. That is the third time in a row for this line: every Alpha codename so far has been free while anonymous and repriced or folded into the vendor's own lineup once the identity came out.",
  },
  {
    question: "What does it cost now?",
    answer:
      "unbiased/pareto is listed at $2.50 per million input tokens and $7.50 per million output tokens, read from the public catalogue on 2026-09-18. The ≈$0.50 / $1.50 figure that circulated during the anonymous window was a third-party claim about an unreleased model, and the real listing did not match it — which is the argument for pricing off the catalogue and not off the rumour.",
  },
  {
    question: "Was anyone told before the free window closed?",
    answer:
      "No. Nothing was published in advance by the maker or by OpenRouter; the delisting and the reveal arrived together. Free stealth previews on this line have now ended without notice three times, so the honest planning assumption is that a free endpoint is unannounced on the way in and unannounced on the way out.",
  },
];
---
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} ogType="article">
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Is Union Alpha Free? The Stealth Preview Window Explained",
      description:
        "Two free days, then a reveal: what the anonymous window cost, what unbiased/pareto bills now, and how the previous two Alpha models ended.",
      publishedAt: "2026-09-17",
      updatedAt: UNION_ALPHA_DATA_AS_OF,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <JsonLd slot="head" data={faqSchema(faqs)} />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "Union Alpha", url: `${SITE}/union-alpha` },
      { name: "Free window", url: canonical },
    ])}
  />

  <p class="kicker">Stealth line · Union Alpha · pricing</p>
  <h1 class="display">Is Union Alpha free?</h1>
  <p class="lede">
    Short answer: it was, for two days, and it is not any more. Here is what “free” meant on the anonymous
    endpoint, exactly when it ended, what the revealed model costs instead, and how to check any of it
    yourself in ten seconds.
  </p>

  <RevealNotice compact />

  <StatusStrip modelId={UNION_ALPHA_MODEL_ID} />

  <section id="today">
    <h2>The whole window, in one table</h2>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>Field</th>
            <th>Value</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {priceRows.map((row) => (
            <tr>
              <td style="color: var(--text-muted);">{row.field}</td>
              <td>{row.code ? <code>{row.value}</code> : <strong>{row.value}</strong>}</td>
              <td class={`status-${row.tone}`}>{row.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Provenance
      source="openrouter.ai/api/v1/models"
      verified={UNION_ALPHA_DATA_AS_OF}
      extra={["Live re-check: /api/union-alpha/status"]}
    />
  </section>

  <section id="what-free-means">
    <h2>What “free” means on a stealth endpoint</h2>
    <p class="measure">
      A stealth preview is a lab testing an unreleased model in public. The free price is the incentive to
      get people to use it: you supply the traffic and the feedback, the lab supplies the compute. That
      arrangement ends when the test does.
    </p>
    <p class="measure">
      It also means the endpoint has no commercial obligations to you — no SLA, no published data-retention
      terms, no support channel and no notice period. Everything on this page is written with that in mind.
    </p>
  </section>

  <section id="precedent">
    <h2>What happened to the Alpha models before this one</h2>
    <p class="measure">
      All three codenames so far have ended the same way, which is the closest thing to a forecast that
      exists — a precedent rather than a rule, as it was when this page first said “the last two”.
    </p>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>Codename</th>
            <th>Revealed as</th>
            <th>What happened to the free window</th>
          </tr>
        </thead>
        <tbody>
          {precedent.map((row) => (
            <tr>
              <td class={row.current ? "current" : ""}>{row.codename}</td>
              <td style="color: var(--text-muted);">{row.revealedAs}</td>
              <td style="color: var(--text-muted);">{row.outcome}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="footnote">
      Deeper background: <a href="/alpha-models">how the Alpha line works</a>.
    </p>
  </section>

  <section id="check-yourself">
    <h2>Checking any of this yourself</h2>
    <ol class="stages">
      <li>
        <strong>Ask our status endpoint.</strong> <a href="/api/union-alpha/status">/api/union-alpha/status</a>{" "}
        reads the catalogue live and returns whether <code>{UNION_ALPHA_MODEL_ID}</code> is still listed,
        with its price and context window when it is. It currently answers “no longer listed”.
      </li>
      <li>
        <strong>Or read the listings.</strong> The stealth page at{" "}
        <a href={UNION_ALPHA_OPENROUTER_URL} rel="noopener noreferrer">openrouter.ai/stealth/union-alpha ↗</a>{" "}
        still carries the reveal notice, and the live per-million price for the revealed model is on{" "}
        <a href={`https://openrouter.ai/${UNION_ALPHA_REVEAL.modelId}`} rel="noopener noreferrer">
          openrouter.ai/{UNION_ALPHA_REVEAL.modelId} ↗
        </a>.
      </li>
      <li>
        <strong>Watch the price against the identity.</strong> On this line the free tier has ended with the
        reveal every time, so the reveal is the event to watch, not the price history.
      </li>
    </ol>
  </section>

  <section id="building-on-it">
    <h2>If you built on it</h2>
    <ul class="bullets">
      <li>
        Swap <code>{UNION_ALPHA_MODEL_ID}</code> for <code>{UNION_ALPHA_REVEAL.modelId}</code> — same model,
        same {UNION_ALPHA_REVEAL.contextWindow.toLocaleString("en-US")}-token context window, now billed.
      </li>
      <li>Keep a fallback model configured and tested, so the next delisting is a config change rather than an outage.</li>
      <li>Log which model served each request — an anonymous endpoint that disappears is hard to reason about after the fact.</li>
      <li>
        Re-check your cost estimate against the real listing: ${UNION_ALPHA_REVEAL.inputPricePerMillion.toFixed(2)}{" "}
        in / ${UNION_ALPHA_REVEAL.outputPricePerMillion.toFixed(2)} out per million, not the ≈$0.50 / $1.50 that was
        circulating while the model was anonymous.
      </li>
      <li>Keep secrets and other people's data out of preview endpoints. The anonymous window is closed now, but the next codename will behave the same way.</li>
    </ul>
  </section>

  <section id="faq">
    <h2>FAQ</h2>
    <Faq items={faqs} />
  </section>

  <section class="card" style="margin-top: var(--space-10);">
    <h2 style="margin-top: 0;">Get told when the next codename appears</h2>
    <p class="measure">
      One email when the next stealth model is listed — and one when its identity comes out.
    </p>
    <SubscribeForm />
  </section>

  <p class="hero-actions">
    <a class="btn primary" href="/union-alpha">Union Alpha tracker →</a>
    <a class="btn ghost" href="/union-alpha-opencode">Using it in OpenCode</a>
    <a class="btn ghost" href="/union-alpha-not-working">Errors and limits</a>
  </p>
</System>

<style>
  .status-verified {
    color: var(--success);
  }
  .status-claim {
    color: var(--warn);
  }
  .status-warn {
    color: var(--danger);
  }
  .current {
    font-weight: 600;
  }
  .measure {
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .stages {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .stages li {
    margin-bottom: var(--space-3);
  }
  .stages strong {
    color: var(--text);
  }
  .bullets {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .bullets li {
    margin-bottom: var(--space-2);
  }
  .footnote {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
