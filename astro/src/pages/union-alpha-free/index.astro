---
/**
 * Is Union Alpha free? — the pricing sub-page of the tracker cluster.
 *
 * The whole page exists to make one distinction that the rest of the internet
 * blurs: "$0 today" is a verified catalogue read with a date on it, while
 * "≈$0.50 / $1.50 after the preview" is a third-party claim. They are in the
 * same table, in different rows, with different status labels — never averaged
 * into one number.
 *
 * Parity contract (npm run verify:pages): title, description, canonical, one
 * h1, Article + FAQPage + BreadcrumbList.
 */
import System from "../../layouts/System.astro";
import JsonLd from "../../components/JsonLd.astro";
import Faq from "../../components/Faq.astro";
import Provenance from "../../components/Provenance.astro";
import StatusStrip from "../../components/StatusStrip.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { articleSchema, breadcrumbSchema, faqSchema, SITE, SITE_NAME } from "../../lib/schema";
import {
  UNION_ALPHA_DATA_AS_OF,
  UNION_ALPHA_MODEL_ID,
  UNION_ALPHA_OPENROUTER_URL,
} from "@repo/lib/union-alpha";

const title = "Is Union Alpha Free? The Stealth Preview Window Explained (2026)";
const description =
  "Union Alpha bills $0 per million tokens right now — verified against the OpenRouter catalogue. What a free stealth preview means, what the last two Alpha models did when their windows closed, and how to check the price yourself.";
const canonical = `${SITE}/union-alpha-free`;

/** One row per fact, and the status column says which kind of fact it is. */
const priceRows = [
  {
    field: "Model id",
    value: UNION_ALPHA_MODEL_ID,
    status: "Verified",
    tone: "verified",
    code: true,
  },
  {
    field: "Price per million, in / out",
    value: "$0 / $0",
    status: `Verified ${UNION_ALPHA_DATA_AS_OF}`,
    tone: "verified",
  },
  {
    field: "Expected price after the preview",
    value: "≈ $0.50 in / $1.50 out per million",
    status: "Claim, third-party",
    tone: "claim",
  },
  {
    field: "Notice before it changes",
    value: "None published",
    status: "Assume there is none",
    tone: "warn",
  },
];

const precedent = [
  {
    codename: "Hunter Alpha",
    revealedAs: "Xiaomi MiMo-V2.5",
    outcome: "Repriced as a normal paid model after the reveal",
  },
  {
    codename: "OX Alpha",
    revealedAs: "Z.ai GLM 5.3 Flash",
    outcome: "Folded into the vendor's own lineup at its list price",
  },
  {
    codename: "Union Alpha",
    revealedAs: "Still anonymous",
    outcome: "$0 today; the maker has published nothing",
    current: true,
  },
];

const faqs = [
  {
    question: "Is Union Alpha free right now?",
    answer:
      "Yes as of 2026-09-17: the OpenRouter endpoint for stealth/union-alpha lists $0 per million input tokens and $0 per million output tokens, which we read directly from the public catalogue. That is a snapshot, not a promise — the status endpoint on this site re-checks it.",
  },
  {
    question: "How long will it stay free?",
    answer:
      "Nobody outside the maker knows. The previous two models in this line were free while anonymous and were repriced or delisted once they were revealed. Treat the window as days-to-weeks, and never as a guarantee.",
  },
  {
    question: "What will it cost after the preview?",
    answer:
      "Unconfirmed. Material published for the model itself lists anticipated pricing of about $0.50 per million input tokens and $1.50 per million output tokens — roughly the budget tier. That is a claim by an anonymous party, not an announcement, and the listing on OpenRouter still bills $0 today.",
  },
  {
    question: "Will I be told before the free window closes?",
    answer:
      "Assume not. Free stealth previews have ended without notice before, and there is no mailing list, changelog or status page from the maker. The only honest mitigation is to not depend on it.",
  },
];
---
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} ogType="article">
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Is Union Alpha Free? The Stealth Preview Window Explained",
      description:
        "Verified $0 pricing today, the reported price after the preview, and the precedent set by the previous two Alpha models.",
      publishedAt: "2026-09-17",
      updatedAt: UNION_ALPHA_DATA_AS_OF,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <JsonLd slot="head" data={faqSchema(faqs)} />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "Union Alpha", url: `${SITE}/union-alpha` },
      { name: "Free window", url: canonical },
    ])}
  />

  <p class="kicker">Stealth line · Union Alpha · pricing</p>
  <h1 class="display">Is Union Alpha free?</h1>
  <p class="lede">
    Short answer: yes today, verified against the catalogue — and treated as a countdown, not a price. Here
    is exactly what “free” means on an anonymous endpoint, what the two previous Alpha models did when their
    windows closed, and how to check the number yourself in ten seconds.
  </p>

  <StatusStrip modelId={UNION_ALPHA_MODEL_ID} />

  <section id="today">
    <h2>Today, in one table</h2>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>Field</th>
            <th>Value</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {priceRows.map((row) => (
            <tr>
              <td style="color: var(--text-muted);">{row.field}</td>
              <td>{row.code ? <code>{row.value}</code> : <strong>{row.value}</strong>}</td>
              <td class={`status-${row.tone}`}>{row.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Provenance
      source="openrouter.ai/api/v1/models"
      verified={UNION_ALPHA_DATA_AS_OF}
      extra={["Live re-check: /api/union-alpha/status"]}
    />
  </section>

  <section id="what-free-means">
    <h2>What “free” means on a stealth endpoint</h2>
    <p class="measure">
      A stealth preview is a lab testing an unreleased model in public. The free price is the incentive to
      get people to use it: you supply the traffic and the feedback, the lab supplies the compute. That
      arrangement ends when the test does.
    </p>
    <p class="measure">
      It also means the endpoint has no commercial obligations to you — no SLA, no published data-retention
      terms, no support channel and no notice period. Everything on this page is written with that in mind.
    </p>
  </section>

  <section id="precedent">
    <h2>What happened to the last two Alpha models</h2>
    <p class="measure">This is the closest thing to a forecast that exists, and it is a precedent rather than a rule.</p>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>Codename</th>
            <th>Revealed as</th>
            <th>What happened to the free window</th>
          </tr>
        </thead>
        <tbody>
          {precedent.map((row) => (
            <tr>
              <td class={row.current ? "current" : ""}>{row.codename}</td>
              <td style="color: var(--text-muted);">{row.revealedAs}</td>
              <td style="color: var(--text-muted);">{row.outcome}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="footnote">
      Deeper background: <a href="/alpha-models">how the Alpha line works</a>.
    </p>
  </section>

  <section id="check-yourself">
    <h2>Checking the price yourself</h2>
    <ol class="stages">
      <li>
        <strong>Ask our status endpoint.</strong> <a href="/api/union-alpha/status">/api/union-alpha/status</a>{" "}
        reads the catalogue live and returns the current price, context window and whether the model is still
        listed.
      </li>
      <li>
        <strong>Or read the listing.</strong> OpenRouter shows the per-million price on{" "}
        <a href={UNION_ALPHA_OPENROUTER_URL} rel="noopener noreferrer">the model page ↗</a>.
      </li>
      <li>
        <strong>Watch for the reveal, not the price.</strong> The price changes when the identity does. If a
        lab claims the model, the free tier is on borrowed time.
      </li>
    </ol>
  </section>

  <section id="building-on-it">
    <h2>If you are building on it</h2>
    <ul class="bullets">
      <li>Keep a fallback model configured and tested, so a delisting is a config change rather than an outage.</li>
      <li>Log which model served each request — an anonymous endpoint that disappears is hard to reason about after the fact.</li>
      <li>Keep secrets and other people's data out of the prompts. No data policy has been published to trust.</li>
      <li>Budget for the reported post-preview price rather than the current $0, so the free window is upside, not a dependency.</li>
    </ul>
  </section>

  <section id="faq">
    <h2>FAQ</h2>
    <Faq items={faqs} />
  </section>

  <section class="card" style="margin-top: var(--space-10);">
    <h2 style="margin-top: 0;">Get told when the free window closes</h2>
    <p class="measure">
      One email when Union Alpha is revealed and the price becomes real.
    </p>
    <SubscribeForm />
  </section>

  <p class="hero-actions">
    <a class="btn primary" href="/union-alpha">Union Alpha tracker →</a>
    <a class="btn ghost" href="/union-alpha-opencode">Using it in OpenCode</a>
    <a class="btn ghost" href="/union-alpha-not-working">Errors and limits</a>
  </p>
</System>

<style>
  .status-verified {
    color: var(--success);
  }
  .status-claim {
    color: var(--warn);
  }
  .status-warn {
    color: var(--danger);
  }
  .current {
    font-weight: 600;
  }
  .measure {
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .stages {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .stages li {
    margin-bottom: var(--space-3);
  }
  .stages strong {
    color: var(--text);
  }
  .bullets {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .bullets li {
    margin-bottom: var(--space-2);
  }
  .footnote {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
