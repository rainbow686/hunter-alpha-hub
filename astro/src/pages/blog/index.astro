---
/**
 * Blog index. Title, description and canonical are copied from the live page
 * verbatim (the parity check enforces it): this page already ranks for brand and
 * category queries, so its indexed fields are not ours to redesign.
 */
import System from "../../layouts/System.astro";
import { getCollection } from "astro:content";
import JsonLd from "../../components/JsonLd.astro";
import { blogSchema, breadcrumbSchema, SITE } from "../../lib/schema";

const title = "Model Hub Blog — OpenRouter comparisons & guides";
const description =
  "Practical articles, comparisons and tutorials for choosing and using AI models on OpenRouter.";
const canonical = `${SITE}/blog`;

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category))].sort();
const fmtDate = (value: string) =>
  new Date(value).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---
<System title={title} description={description} canonical={canonical} wide>
  <JsonLd slot="head" data={blogSchema({ name: "Model Hub Blog", url: canonical, description })} />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "Blog", url: canonical },
    ])}
  />

  <p class="kicker">Articles</p>
  <h1 class="display">Model Hub Blog</h1>
  <p class="lede">
    {description} {posts.length} articles, every claim dated, every number sourced.
  </p>
  <div class="byline">
    <span>{posts.length} articles</span>
    <span>{categories.length} categories</span>
    <span>Newest {fmtDate(posts[0].data.publishedAt)}</span>
  </div>

  <div style="margin-top: var(--space-8);">
    {categories.map((category) => (
      <section>
        <h2 style="margin-top: 0;">{category}</h2>
        <ul class="card-grid">
          {posts
            .filter((post) => post.data.category === category)
            .map((post) => (
              <li class="card">
                {/* No image slot here yet, and deliberately not a generated one: an
                    article card borrows the page's own cover once that is wired, and
                    until then a card with honest text beats a card with invented art. */}
                <div class="card-body">
                  <p class="card-eyebrow">{category}</p>
                  <h2 class="card-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                  <p class="card-note">{post.data.excerpt}</p>
                  <p class="card-meta">
                    <span>{fmtDate(post.data.publishedAt)}</span>
                    <span>{post.data.readTime} min read</span>
                    <span>{post.data.author}</span>
                  </p>
                </div>
              </li>
            ))}
        </ul>
      </section>
    ))}
  </div>
</System>
