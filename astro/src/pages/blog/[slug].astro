---
/**
 * Article route, served from the content collection.
 *
 * Every post is prerendered: Phase 2 moved the content out of lib/blog.ts into
 * src/content/blog/*.md, so adding an article is now adding a file. Rendering
 * goes through Astro's own Markdown pipeline (GFM tables included) instead of the
 * hand-rolled renderer this page used while the words still lived in TS.
 */
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/**
 * Related posts: same rule the Next app used (shared tag or same category),
 * computed from the collection so there is no second source to keep in sync.
 */
const all = await getCollection("blog");
const related = all
  .filter((candidate) => candidate.id !== post.id)
  .filter(
    (candidate) =>
      candidate.data.tags.some((tag) => post.data.tags.includes(tag)) ||
      candidate.data.category === post.data.category,
  )
  .slice(0, 3)
  .map((candidate) => ({
    href: `/blog/${candidate.id}`,
    label: candidate.data.title,
    note: candidate.data.excerpt,
  }));
---
<Article
  title={post.data.title}
  description={post.data.excerpt}
  slug={post.id}
  category={post.data.category}
  author={post.data.author}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  readTime={post.data.readTime}
  tags={post.data.tags}
  related={related}
>
  <Content />
</Article>
