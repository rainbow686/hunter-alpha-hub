---
/**
 * Article route, served from the content collection.
 *
 * Every post is prerendered: Phase 2 moved the content out of lib/blog.ts into
 * src/content/blog/*.md, so adding an article is now adding a file. Rendering
 * goes through Astro's own Markdown pipeline (GFM tables included) instead of the
 * hand-rolled renderer this page used while the words still lived in TS.
 */
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { getRelatedPosts } from "@repo/lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/**
 * Related posts come from the same function the live site renders, not a
 * re-implementation of its rule.
 *
 * The re-implementation looked equivalent and was not: it filtered the Astro
 * collection, which is ordered by filename, while `lib/blog.ts` is a curated
 * array — so the identical rule picked a different three posts on every article
 * (e.g. /blog/xiaomi-mimo-v2-complete-guide lost its links to the two newest
 * posts). `npm run check:links` is what caught it; see that script's header.
 */
const related = getRelatedPosts(post.id, 3).map((entry) => ({
  href: `/blog/${entry.slug}`,
  label: entry.title,
  note: entry.excerpt,
}));
---
<Article
  title={post.data.title}
  description={post.data.excerpt}
  slug={post.id}
  category={post.data.category}
  author={post.data.author}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  readTime={post.data.readTime}
  tags={post.data.tags}
  related={related}
>
  <Content />
</Article>
