---
import Base from "../../layouts/Base.astro";
import "../../styles/v3.css";
import { readFileSync } from "node:fs";

const modelsSource = readFileSync(`${process.env.SITE_ROOT ?? "../"}lib/openrouter-models.ts`, "utf8");
const models = [...modelsSource.matchAll(/slug: "([^"]+)",\s*\n\s*name: "([^"]+)",\s*\n\s*vendor: "([^"]+)",\s*\n\s*contextWindow: ([\d_]+),\s*\n\s*inputPricePerMillion: ([\d.]+),\s*\n\s*outputPricePerMillion: ([\d.]+)/g)]
  .map((m) => ({ slug: m[1], name: m[2], vendor: m[3], context: Number(m[4].replace(/_/g, "")), input: Number(m[5]), output: Number(m[6]) }))
  .slice(0, 9);
const fmtCtx = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 2)}M` : `${Math.round(n / 1024)}K`);
const fmtPrice = (n: number) => (n === 0 ? "free" : `$${n.toFixed(n < 1 ? 3 : 2)}`);
---
<Base title="V3 — editorial hybrid" description="Variant 3 preview" canonical="https://www.hunteralphahub.com/">
  <h1>Every model, priced and dated</h1>
  <p class="lede">
    Catalogue facts in one table: context window, price per million, modality. Stealth releases are tracked
    separately, and every claim carries a confidence label.
  </p>
  <div class="byline">
    <span>Model index</span><span>Verified 2026-09-17</span><span>Source: public catalogue</span>
  </div>

  <p class="pull">
    The useful question is not which model is best. It is which model finishes your work at a price you can
    plan around — and whether the endpoint will still exist next month.
  </p>

  <h2>Model snapshot</h2>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr><th>Model</th><th>Vendor</th><th class="num">Context</th><th class="num">Input /M</th><th class="num">Output /M</th></tr>
      </thead>
      <tbody>
        {models.map((m) => (
          <tr>
            <td><a href={`/openrouter-models/${m.slug}`}>{m.name}</a></td>
            <td style="color: var(--text-muted);">{m.vendor}</td>
            <td class="num">{fmtCtx(m.context)}</td>
            <td class={`num ${m.input === 0 ? "free" : ""}`}>{fmtPrice(m.input)}</td>
            <td class={`num ${m.output === 0 ? "free" : ""}`}>{fmtPrice(m.output)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="provenance">
    <span>Source <code>openrouter.ai/api/v1/models</code> · verified <code>2026-09-17</code> · re-checked daily</span>
  </div>

  <h2>Fact versus claim</h2>
  <div class="claim">
    <strong>Union Alpha accepts image input</strong> — <span class="tag verified">Verified</span>
    <div class="basis">Catalogue modality field, read 2026-09-17.</div>
  </div>
  <div class="claim" style="margin-top: var(--space-4);">
    <strong>Union Alpha is an orchestrator over several models</strong> — <span class="tag claimed">Claimed</span>
    <div class="basis">A public landing page describes parallel generation; testers report inconsistent behaviour. No confirmation from the maker.</div>
  </div>
</Base>
