---
/**
 * Union Alpha tracker — the stealth-line template, on real data.
 *
 * Shape, copied from the production page so the migration keeps every asset:
 * live status, TL;DR, verified specs, community claims (physically separate from
 * the specs), timeline, how-to, Alpha-line comparison, FAQ, reveal signup.
 *
 * Two things are structural rather than cosmetic:
 *   - facts and claims never share a surface: one is table.data with a
 *     provenance line, the other carries a confidence tag per row.
 *   - the status strip is polled, not baked: stealth endpoints vanish silently.
 */
import System from "../../layouts/System.astro";
import JsonLd from "../../components/JsonLd.astro";
import FactTable from "../../components/FactTable.astro";
import ClaimList from "../../components/ClaimList.astro";
import TimelineList from "../../components/TimelineList.astro";
import Faq from "../../components/Faq.astro";
import RevealNotice from "../../components/RevealNotice.astro";
import StatusStrip from "../../components/StatusStrip.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { articleSchema, breadcrumbSchema, faqSchema, SITE, SITE_NAME } from "../../lib/schema";
import {
  UNION_ALPHA_ADDED_AT_UTC,
  UNION_ALPHA_DATA_AS_OF,
  UNION_ALPHA_ENDPOINT,
  UNION_ALPHA_MODEL_ID,
  UNION_ALPHA_OPENROUTER_URL,
  UNION_ALPHA_REVEAL,
  communityClaims,
  timeline,
  unionAlphaFaqs,
  verifiedSpecs,
} from "@repo/lib/union-alpha";

/**
 * Title rewritten 2026-09-18 after reading the live SERP for "union alpha":
 * every page holding a top-8 position titles itself with the query's own
 * vocabulary — "Union Alpha AI Model: Specs, Benchmarks, Cost & API" (union-alpha.com),
 * "Union Alpha AI: Benchmarks, Specs, Cost & How to Use It" (kingy.ai),
 * "Union Alpha Stealth Model: Coding, Vision, and ..." (mindstudio.ai) — while
 * this page was answering the post-reveal question instead. Both intents are
 * real, so the title now carries the query language *and* the one thing the
 * competitors cannot answer, because they were not tracking it.
 *
 * We still do not publish benchmarks we do not have; that word is deliberately
 * absent rather than borrowed.
 */
const title = "Union Alpha Specs, Cost & API: Revealed as Unbiased Pareto (2026)";
const h1 = "What is Union Alpha? The Stealth Model That Turned Out to Be Unbiased Pareto";
const description =
  "Union Alpha appeared on OpenRouter on 16 September 2026 and was revealed two days later as Unbiased Pareto: 262K context, 128K output, image input, tool calling. The full specs, the reveal, and what it costs now.";
const canonical = `${SITE}/union-alpha`;

const tldr = [
  ["Maker", "Unbiased", "Revealed 2026-09-18"],
  ["Revealed as", "Unbiased Pareto", "unbiased/pareto"],
  ["Listed", "16 Sep 2026", "14:42 UTC"],
  ["Delisted", "18 Sep 2026", "stealth route removed"],
  ["Context", "256K", "262,144 tokens"],
  ["Max output", "128K", "131,072 tokens"],
  ["Price then", "Free", "$0 in / $0 out, 16–18 Sep"],
  ["Price now", "$2.50 / $7.50", "per million tokens, in / out"],
  ["Tools", "Supported", "tool_choice: auto"],
];

const comparison = [
  { href: "/hunter-alpha", name: "Hunter Alpha", context: "1M", vision: "No", revealed: "Xiaomi MiMo-V2.5" },
  { href: "/ox-alpha", name: "OX Alpha", context: "1M", vision: "No", revealed: "Z.ai GLM 5.3 Flash" },
  { href: null, name: "Union Alpha", context: "256K", vision: "Yes", revealed: "Unbiased Pareto" },
];

const howTo = [
  ["Create an OpenRouter account.", "Chat works in the browser; the API needs an OpenRouter key, not a key from the mystery maker."],
  ["Select the model by ID.", null],
  ["Use tool calling if you are building.", "The endpoint declares tools, tool_choice (auto), response_format, temperature, top_p and max_tokens."],
  ["Call it by its real name now.", "stealth/union-alpha no longer resolves; unbiased/pareto is the same model, billed."],
];

/** The three sibling pages, worded the way the live tracker words them. */
const relatedPages = [
  {
    href: "/union-alpha-free",
    title: "Is it still free?",
    body: "The preview window, the reported price after it, and how to check the number yourself.",
  },
  {
    href: "/union-alpha-opencode",
    title: "Using it in OpenCode",
    body: "The free route through OpenCode’s tier, and what we can and cannot verify about it.",
  },
  {
    href: "/union-alpha-not-working",
    title: "Errors and rate limits",
    body: "Why the endpoint stopped on 18 September, and the other three failure modes that apply to every stealth release.",
  },
];
---
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} ogType="article">
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Union Alpha: The Third Alpha-Line Codename, Revealed",
      description:
        "The third Alpha-line codename on OpenRouter, revealed as Unbiased Pareto on 2026-09-18. Specs read from the catalogue, theories labelled as theories.",
      publishedAt: "2026-09-17",
      updatedAt: UNION_ALPHA_DATA_AS_OF,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <JsonLd slot="head" data={faqSchema(unionAlphaFaqs)} />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "Union Alpha", url: canonical },
    ])}
  />

  <p class="kicker">Stealth line · live tracker</p>
  <h1 class="display">{h1}</h1>
  <p class="lede">
    Union Alpha appeared on OpenRouter on 16 September 2026 with no announcement and no model card — the
    third anonymous model in the Alpha line, after Hunter Alpha (later Xiaomi MiMo-V2.5) and OX Alpha
    (later Z.ai GLM 5.3 Flash). Two days later it was revealed as {UNION_ALPHA_REVEAL.name} and the
    stealth route disappeared. Facts and speculation are kept on separate surfaces on purpose:
    everything below is either re-checkable against the public catalogue or labelled as a claim.
  </p>
  <div class="byline">
    <span>Tracker</span>
    <span>Added 16 Sep 2026, 14:42 UTC</span>
    <span>Verified {UNION_ALPHA_DATA_AS_OF}</span>
    <span>
      <a href={UNION_ALPHA_OPENROUTER_URL} rel="noopener noreferrer">OpenRouter listing →</a>
    </span>
  </div>

  <div style="margin: var(--space-6) 0 var(--space-8);">
    <StatusStrip modelId={UNION_ALPHA_MODEL_ID} />
  </div>

  {/*
    Shared with the other three pages in the cluster — the sentence and the
    numbers live in lib/union-alpha.ts, not in this file.
  */}
  <RevealNotice />

  <h2 id="tldr">The short version</h2>
  <div class="stats">
    {tldr.map(([label, value, sub]) => (
      <div class="stat">
        <div class="label">{label}</div>
        <div class="value" style="font-size: var(--text-xl);">{value}</div>
        <div class="sub">{sub}</div>
      </div>
    ))}
  </div>

  <h2>Verified specs</h2>
  <p style="color: var(--text-muted); max-width: var(--measure); margin-bottom: var(--space-4);">
    Read straight from the public model catalogue and re-checkable by anyone. Rows marked as third-party
    are things other people published, not things we confirmed.
  </p>
  <FactTable rows={verifiedSpecs} />
  <div class="provenance">
    <span>Source <code>openrouter.ai/api/v1/models</code></span>
    <span>Verified <code>{UNION_ALPHA_DATA_AS_OF}</code></span>
    <span>Live status <code>/api/union-alpha/status</code></span>
  </div>

  <h2>What the community claims</h2>
  <p style="color: var(--text-muted); max-width: var(--measure); margin-bottom: var(--space-6);">
    None of this is confirmed by OpenRouter or the maker. It is included because it is what testers are
    arguing about, with the evidence attached so you can weigh it yourself.
  </p>
  <ClaimList claims={communityClaims} />

  <h2>Timeline</h2>
  <TimelineList entries={timeline} />

  <h2>How to use Union Alpha</h2>
  <ol style="max-width: var(--measure); color: var(--text-muted); padding-left: var(--space-6);">
    <li><strong style="color: var(--text);">{howTo[0][0]}</strong> {howTo[0][1]}</li>
    <li>
      <strong style="color: var(--text);">{howTo[1][0]}</strong> Use <code>{UNION_ALPHA_MODEL_ID}</code> —
      the display name in the picker is just <em>Union Alpha</em>.
    </li>
    <li><strong style="color: var(--text);">{howTo[2][0]}</strong> {howTo[2][1]}</li>
    <li><strong style="color: var(--text);">{howTo[3][0]}</strong> {howTo[3][1]}</li>
  </ol>
  <p style="max-width: var(--measure); color: var(--text-muted);">
    <strong style="color: var(--text);">Via OpenCode:</strong> third-party reports said the same anonymous
    model was reachable from OpenCode’s free tier. We never confirmed that independently, and it is moot now —
    the anonymous model was delisted alongside the reveal. <a href="/union-alpha-opencode">The OpenCode page</a>
    keeps the record of the claim.
  </p>

  {/*
    Cost and API. This section exists because of what the ranking pages actually
    answer: every one of them titles itself "Specs, Benchmarks, Cost & API", and
    we had the specs and none of the other two. The numbers below are read from
    the serving endpoint, including the cache price that was missing from the
    reveal row until this was written.
  */}
  <h2>What it costs now, and how to call it</h2>
  <p style="color: var(--text-muted); max-width: var(--measure);">
    Read from <code>GET /api/v1/models/unbiased/pareto/endpoints</code> on
    {UNION_ALPHA_DATA_AS_OF}. One provider serves it, so there is one price and no
    routing to reason about.
  </p>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr><th>Field</th><th class="num">Value</th><th>Note</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>Input</td>
          <td class="num">$2.50 / 1M</td>
          <td style="color: var(--text-muted);"><code>prompt 0.0000025</code> per token</td>
        </tr>
        <tr>
          <td><strong>Cached input</strong></td>
          <td class="num"><strong>$0.25 / 1M</strong></td>
          <td style="color: var(--text-muted);">
            <code>input_cache_read 0.00000025</code> — a tenth of fresh input. If you
            resend the same long prefix, this is the number that sets your bill, not
            the $2.50.
          </td>
        </tr>
        <tr>
          <td>Output</td>
          <td class="num">$7.50 / 1M</td>
          <td style="color: var(--text-muted);"><code>completion 0.0000075</code> per token</td>
        </tr>
        <tr>
          <td>Context window</td>
          <td class="num">262,144</td>
          <td style="color: var(--text-muted);">unchanged from the stealth era</td>
        </tr>
        <tr>
          <td>Max output</td>
          <td class="num">131,072</td>
          <td style="color: var(--text-muted);">declared by the single endpoint</td>
        </tr>
        <tr>
          <td>Accepts</td>
          <td class="num">text + image</td>
          <td style="color: var(--text-muted);"><code>text+image-&gt;text</code> — the first Alpha-line model that took images</td>
        </tr>
        <tr>
          <td>Parameters</td>
          <td class="num">5</td>
          <td style="color: var(--text-muted);">
            <code>{UNION_ALPHA_ENDPOINT.supportedParameters.join(", ")}</code>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="provenance">
    <span>Source <code>openrouter.ai/api/v1/models/unbiased/pareto/endpoints</code></span>
    <span>Verified <code>{UNION_ALPHA_DATA_AS_OF}</code></span>
    <span>Not quoted from a model card — read from the endpoint that serves it</span>
  </div>

  <h3>Calling it</h3>
  <p style="color: var(--text-muted); max-width: var(--measure);">
    The model id is <code>{UNION_ALPHA_REVEAL.modelId}</code> — the stealth id
    <code>stealth/union-alpha</code> no longer resolves. It is a normal
    OpenRouter route, so the request shape is the same as for any other model on
    the platform; only the id and the declared parameters above change.
  </p>
  <pre style="max-width: var(--measure); overflow-x: auto; padding: var(--space-4); background: var(--bg-sunken); border: 1px solid var(--field-border); border-radius: var(--radius); font-size: var(--text-sm);"><code>{`curl https://openrouter.ai/api/v1/chat/completions \\
  -H "Authorization: Bearer $OPENROUTER_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "unbiased/pareto",
    "messages": [
      { "role": "user", "content": "Summarise this error log." }
    ],
    "temperature": 0.2,
    "max_tokens": 2048
  }'`}</code></pre>
  <p style="color: var(--text-muted); max-width: var(--measure); font-size: var(--text-sm);">
    Tool calling is declared on the endpoint, so agent harnesses that send
    <code>tools</code> and <code>tool_choice</code> work without a wrapper. The
    image modality is why the request above can carry an image part alongside
    text — something Hunter Alpha and OX Alpha never accepted.
  </p>
  <div class="provenance">
    <span>Parameters <code>read 2026-09-18</code></span>
    <span>Request shape <a href="https://openrouter.ai/docs" rel="noopener noreferrer">OpenRouter docs</a></span>
  </div>

  <h2>How it compares to the earlier Alpha models</h2>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr><th>Model</th><th class="num">Context</th><th>Vision</th><th>Revealed as</th></tr>
      </thead>
      <tbody>
        {comparison.map((row) => (
          <tr>
            <td>{row.href ? <a href={row.href}>{row.name}</a> : <strong>{row.name}</strong>}</td>
            <td class="num">{row.context}</td>
            <td>{row.vision}</td>
            <td>{row.revealed}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="provenance">
    <span>Source <code>public catalogue reads, 2026-09-18</code></span>
    <span>Background <a href="/alpha-models">how the Alpha line works</a></span>
  </div>

  <h2>FAQ</h2>
  <Faq items={unionAlphaFaqs} />

  <section class="card" style="margin-top: var(--space-12);">
    <h2 style="margin-top: 0;">Get notified about the next codename</h2>
    <p style="color: var(--text-muted); max-width: var(--measure);">
      This reveal is over — Union Alpha ran for two days. Three codenames in, each one has been free while
      anonymous and billed once revealed. Leave your email and we will tell you when the next one appears,
      and who it turns out to be.
    </p>
    <SubscribeForm note="One email per reveal. No newsletter, no forwarding, unsubscribe in one click." />
  </section>

  {/*
    The three sibling pages are the cluster this tracker sits on top of. The live
    page linked them here and the redesign dropped the block entirely — which is
    invisible to every content check, because a missing <a> is not a changed
    field. `npm run check:links` is what caught it.
  */}
  <h2>Union Alpha, in more detail</h2>
  <div class="grid-cards">
    {relatedPages.map((page) => (
      <article class="card">
        <h3 class="card-title"><a href={page.href}>{page.title}</a></h3>
        <p class="card-body">{page.body}</p>
      </article>
    ))}
  </div>

  <p class="hero-actions">
    <a class="btn primary" href={UNION_ALPHA_OPENROUTER_URL} rel="noopener noreferrer">Open Union Alpha on OpenRouter →</a>
    <a class="btn ghost" href="/openrouter-free-models">Other free models</a>
    <a class="btn ghost" href="/openrouter-models">Full model directory</a>
  </p>
</System>
