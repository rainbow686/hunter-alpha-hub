---
/**
 * /typesafe-jev/videos — what people filmed about Jev.
 *
 * Two rules from the design are visible in the markup:
 *   - ADR-0022: the player is a facade. An iframe is created on click and not
 *     before, so the page costs no third-party requests until the reader asks for
 *     a video, and the CSP carries exactly one frame source for it;
 *   - every row carries a written note, or it is not rendered at all
 *     (lib/jev-videos.ts filters on it; scripts/check-intake.mjs enforces it).
 */
import System from "../../../layouts/System.astro";
import JsonLd from "../../../components/JsonLd.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { articleSchema, SITE, SITE_NAME } from "../../../lib/schema";
import { JEV_VIDEOS_READ_ON, jevVideoCounts, jevVideos } from "@repo/lib/jev-videos";

const title = "Jev Videos: Walkthroughs, Breakdowns and Demos (2026)";
const description = `Six videos about TypeSafe's Jev — the long walkthroughs, the seven-minute explanation and the breakdowns — with views and duration read on ${JEV_VIDEOS_READ_ON}. Playable here without leaving the page.`;
const canonical = `${SITE}/typesafe-jev/videos`;

const dur = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
const fmt = (n: number) => n.toLocaleString("en-US");
---

<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} wide ogType="article">

  <Breadcrumbs schema={true} items={[
    { name: "Jev", url: `${SITE}/typesafe-jev` },
    { name: "Videos", url: canonical },
  ]} />
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Jev videos: walkthroughs, breakdowns and demos",
      description,
      publishedAt: JEV_VIDEOS_READ_ON,
      updatedAt: JEV_VIDEOS_READ_ON,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />

  <article>
    <header class="col">
      <p class="eyebrow">Jev · video</p>
      <h1>What people filmed about Jev</h1>
      <p class="lede">
        Jev arrived with a launch post and no tutorial, so within four days the explaining was done
        by whoever got there first. These are the recordings worth the time, longest-reach first.
        Nothing loads from YouTube until you press play.
      </p>
      <p class="provenance">
        <span>Views and duration read {JEV_VIDEOS_READ_ON}</span>
        <span>{jevVideoCounts.published} videos published</span>
        <span>{jevVideoCounts.waiting} more waiting for a written note</span>
      </p>
    </header>

    <ul class="card-grid">
      {jevVideos.map((video) => (
        <li class="card">
          <div class="card-media" style="--ratio: 16 / 9">
            <button
              class="facade"
              data-video={video.videoId}
              aria-label={`Play: ${video.title}`}
              type="button"
            >
              <img src={video.thumb} width={video.thumbW} height={video.thumbH} alt="" loading="lazy" decoding="async" />
              <span class="play" aria-hidden="true">▶</span>
              <span class="length" aria-hidden="true">{dur(video.durationS)}</span>
            </button>
          </div>
          <h2 class="card-title"><a href={video.url} rel="noopener">{video.title}</a></h2>
          <p class="card-meta">
            <span>{video.channel}</span>
            <span>{video.publishedAt}</span>
            <span>{fmt(video.views)} views</span>
          </p>
          <p class="card-note card-our">{video.ourNote}</p>
        </li>
      ))}
    </ul>

    <section class="col">
      <h2>What this column does not have</h2>
      <p>
        Anything we have not watched past the part that matters. A video index built from titles is a
        list of other people's headlines, so the six above are the ones we could describe; the rest of
        what the search turned up sits in the intake queue until somebody writes that sentence.
      </p>
      <p class="provenance">
        <a href="https://developers.google.com/youtube/v3">Source: YouTube Data API v3</a>
        <span>Player loads only on click</span>
        <span><a href="/typesafe-jev">Jev topic</a></span>
      </p>
    </section>
  </article>

  <script>
    // Click-to-load (ADR-0022). The player document is ~1MB of third-party JS; it is
    // created only when a reader asks for it, which also means no request to Google
    // before that moment.
    document.querySelectorAll<HTMLButtonElement>(".facade").forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.video;
        if (!id) return;
        const frame = document.createElement("iframe");
        frame.className = "player";
        frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        frame.title = button.getAttribute("aria-label") ?? "YouTube video";
        frame.loading = "lazy";
        frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        frame.allowFullscreen = true;
        button.replaceWith(frame);
      }, { once: true });
    });
  </script>
</System>

<style>
  .facade { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; position: relative; }
  .facade img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .facade .play {
    position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%);
    width: 54px; height: 54px; border-radius: 50%; background: rgb(0 0 0 / 62%); color: #fff;
    display: grid; place-items: center; font-size: 18px; padding-left: 3px;
  }
  .facade .length {
    position: absolute; right: var(--space-2); bottom: var(--space-2);
    background: rgb(0 0 0 / 72%); color: #fff; font-size: var(--text-xs);
    padding: 2px var(--space-2); border-radius: var(--radius-sm); font-variant-numeric: tabular-nums;
  }
  .player { width: 100%; height: 100%; border: 0; display: block; }
</style>
