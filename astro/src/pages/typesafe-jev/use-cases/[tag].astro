---
/**
 * /typesafe-jev/use-cases/<tag> — one facet.
 *
 * Rows come from four sources through lib/jev-facets.ts, which is also where the
 * duplicate guard lives: an X post that is also a demo is counted once.
 */
import System from "../../../layouts/System.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import CardFilter from "../../../components/CardFilter.astro";
import TopicIndex from "../../../components/TopicIndex.astro";
import { articleSchema, SITE, SITE_NAME } from "../../../lib/schema";
import { JEV_FACETS, itemsByFacet, thumbRatio } from "@repo/lib/jev-facets";
import { jevTopicEntries } from "@repo/lib/jev-topic";

export const prerender = true;

export function getStaticPaths() {
  return JEV_FACETS.map((facet) => ({ params: { tag: facet.slug }, props: { facet } }));
}
const { facet } = Astro.props;
const items = itemsByFacet(facet.slug);
const canonical = `${SITE}/typesafe-jev/use-cases/${facet.slug}`;
const title = `Jev for ${facet.label.toLowerCase()}: Projects, Posts and Videos (2026)`;
const description = `${facet.blurb} ${items.length} item${items.length === 1 ? "" : "s"} gathered from the projects, posts and recordings we cover, each with a sentence of ours and a link to the source.`;
---

<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} wide ogType="article" noReferrer>
  <JsonLd slot="head" data={articleSchema({ title, description, publishedAt: "2026-09-22", updatedAt: "2026-09-22", image: `${SITE}/og-image.png`, url: canonical })} />
  <Breadcrumbs items={[
    { name: "Jev", url: `${SITE}/typesafe-jev` },
    { name: "Use cases", url: `${SITE}/typesafe-jev/use-cases` },
    { name: facet.label, url: canonical },
  ]} />

  <article>
    <header class="col">
      <h1>Jev for {facet.label.toLowerCase()}</h1>
      <p class="lede">{facet.blurb}</p>
      <p class="provenance">
        <span>{items.length} items, from every source we cover</span>
        <span><a href="/typesafe-jev/use-cases">All use cases</a></span>
      </p>
    </header>

    <CardFilter
      chips={[...new Set(items.map((i) => i.source))].map((source) => ({
        group: "source",
        value: source.toLowerCase().replace(/[^a-z]+/g, "-"),
        label: source,
        count: items.filter((i) => i.source === source).length,
      }))}
      noun="use cases"
      total={items.length}
      groups={[{ key: "source", label: "source" }]}
    />

    <ul class="card-grid">
      {items.map((item) => (
        <li class="card" data-sources={item.source.toLowerCase().replace(/[^a-z]+/g, "-")} data-tags={item.tags.join(" ")}>
          {item.thumb && item.video ? (
            <div class="card-media" style={`--ratio: "16 / 9"`}>
              <span class="card-src">{item.source}</span>
              <button class="xvideo-facade" type="button" data-xvideo={item.video.url} data-poster={item.thumb} aria-label={`Play the clip in this post: ${item.title}`}>
                <img src={item.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                <span class="xvideo-play" aria-hidden="true">▶</span>
              </button>
            </div>
          ) : item.thumb ? (
            <div class="card-media" style={`--ratio: "16 / 9"`}>
              <span class="card-src">{item.source}</span>
              <img src={item.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            </div>
          ) : null}
          <div class="card-body">
            <p class="card-eyebrow">{item.source} · {item.sourceKind}</p>
            <h2 class="card-title"><a href={item.url} rel="noopener">{item.title}</a></h2>
            <p class="card-note card-our">{item.note}</p>
            <p class="card-meta">{item.meta.map((m) => <span>{m}</span>)}</p>
            <p class="card-meta">
              {item.tags.map((tag) => (
                <a href={`/typesafe-jev/use-cases/${tag}`}>{JEV_FACETS.find((f) => f.slug === tag)?.label ?? tag}</a>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ul>
    <TopicIndex entries={jevTopicEntries} current={canonical.replace(SITE, "")} />
  </article>


</System>

<script>
  /*
   * Click-to-play for X clips.
   *
   * The reference site embeds 138 <video> elements and lets the browser sort it out; we do it
   * on click, for two reasons. A wall of a dozen <video preload="metadata"> tags fetches a
   * dozen manifests and first frames for a reader who may watch none, and the clip lives on
   * X's CDN — the reader should pay for it when they ask for it, not when the page loads.
   *
   * This is a hotlink, not a copy (writing contract §3): the mp4 URL is X's, the file stays on
   * video.twimg.com, and the CSP allows exactly that host.
   */
  for (const button of document.querySelectorAll("[data-xvideo]")) {
    button.addEventListener("click", () => {
      const src = button.getAttribute("data-xvideo");
      const poster = button.getAttribute("data-poster") ?? undefined;
      if (!src) return;
      const video = document.createElement("video");
      video.className = "xvideo-player";
      /*
       * `referrerPolicy = "no-referrer"` is not politeness, it is the difference between a
       * video and a black rectangle: x's CDN answers **403 to any request carrying a Referer**
       * (checked with and without the header on 2026-09-23 — no referer 200, referer 403).
       * A browser sends one for media by default, so without this the player sets its src, the
       * fetch is refused, and the element reports MEDIA_ERR_SRC_NOT_SUPPORTED. The poster images
       * have carried the same attribute since the first X card for the same reason.
       */
      video.referrerPolicy = "no-referrer";
      video.src = src;
      if (poster) video.poster = poster;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.preload = "auto";
      // The click is the gesture, so audio is allowed — but a muted start is still the
      // politest default in an office, and one tap un-mutes.
      video.muted = false;
      button.replaceWith(video);
      video.play().catch(() => { video.muted = true; video.play().catch(() => {}); });
    });
  }
</script>
<style is:global>
  .xvideo-facade {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--bg-sunken);
    cursor: pointer;
    aspect-ratio: var(--ratio, 16 / 9);
  }
  .xvideo-facade img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .xvideo-play {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgb(0 0 0 / 62%);
    color: #fff;
    font-size: 16px;
    padding-left: 3px;
  }
  .xvideo-facade:hover .xvideo-play { background: rgb(0 0 0 / 78%); }
  .xvideo-player { display: block; width: 100%; height: auto; background: #000; }
</style>
