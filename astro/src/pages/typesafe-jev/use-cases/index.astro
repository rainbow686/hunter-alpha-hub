---
/**
 * /typesafe-jev/use-cases — the use-case **section front**.
 *
 * This page was the explainer ("the nine jobs people hand to a decision model") until 2026-09-24,
 * and the reader asked the question that made the split obvious: the six facet pages under it are
 * wide three-column lists, and the page they hang off was a narrow column of prose with two-column
 * cards. Which of those is the section?
 *
 * Both, and they are different jobs:
 *
 *   - **this page** = the index: six cards, one per facet page, so the section has a front door that
 *     looks like what is behind it — the same shape as `/builds`, `/x-posts` and the facet pages;
 *   - **`/typesafe-jev/use-cases/jobs`** = the explainer: nine jobs in prose, with examples, at the
 *     760 column it was written for. It did not change except for its URL and its breadcrumb.
 *
 * Keeping both on one URL would have meant either prose at 1048 (~110 characters a line, which no
 * site we measured does) or a page whose cards and text disagree about how wide the page is.
 */
import System from "../../../layouts/System.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import TopicIndex from "../../../components/TopicIndex.astro";
import { articleSchema, SITE, SITE_NAME } from "../../../lib/schema";
import { JEV_FACET_COUNTS, JEV_ITEMS_TOTAL, JEV_TAGGED_TOTAL, itemsByFacet, thumbRatio } from "@repo/lib/jev-facets";
import { jevTopicEntries } from "@repo/lib/jev-topic";

const title = "Jev use cases: the six kinds of decision people hand to it (2026)";
const description = `Every Jev use case we have catalogued, in six pages — browser agents, triage, coding, research, media, trading — each one a cross-cut of the projects, posts and recordings we track. ${JEV_TAGGED_TOTAL} of ${JEV_ITEMS_TOTAL} records carry one.`;
const canonical = `${SITE}/typesafe-jev/use-cases`;

/**
 * Three examples per card, taken from the same rows the facet page renders — so a card here and
 * the list behind it cannot disagree. The counts are the facet counts, not this page's.
 */
const facets = JEV_FACET_COUNTS.map((facet) => {
  const items = itemsByFacet(facet.slug);
  /*
   * What the card shows instead of sample titles. First draft listed three titles, and that read
   * badly for the same reason the X column's cards were once criticised as machine-made: a tweet's
   * first 90 characters is prose, not a title, so two thirds of the cards began mid-sentence and in
   * lower case. The breakdown says something a reader can act on — "this page is nine repositories
   * and six posts" — and it is exactly the point of a cross-cut.
   */
  const bySource = [...new Set(items.map((item) => item.source))]
    .map((source) => ({ source, count: items.filter((item) => item.source === source).length }))
    .sort((a, b) => b.count - a.count);
  return { ...facet, bySource };
});
---

<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} wide ogType="article">
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Jev use cases",
      description,
      publishedAt: "2026-09-24",
      updatedAt: "2026-09-24",
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <Breadcrumbs schema={true} items={[
    { name: "Jev", url: `${SITE}/typesafe-jev` },
    { name: "Use cases", url: canonical },
  ]} />

  <header class="col">
    <p class="card-eyebrow">Use cases · Jev</p>
    <h1>Jev use cases</h1>
    <p class="lede">
      Six kinds of decision people hand to the model, each one its own page. A page here is a
      cross-cut of everything we track — the repository, the post, the recording — rather than one
      column: the question "what would I use this for" does not respect the question "where did I
      find it".
    </p>
    <p class="provenance">
      <span>{facets.length} use cases</span>
      <span>{JEV_TAGGED_TOTAL} of {JEV_ITEMS_TOTAL} records tagged</span>
      <span><a href="/typesafe-jev/use-cases/jobs">The nine jobs, explained in prose</a></span>
    </p>
  </header>

  {/*
    Three columns of cards, like every other list in the topic. The card carries the blurb and three
    real titles from behind it — a card with a number and nothing else is a menu entry, and the
    reader has already said what they think of those.
  */}
  <ul class="card-grid">
    {facets.map((facet) => (
      <li class="card">
        <div class="card-body">
          <p class="card-eyebrow">{facet.count} records</p>
          <h2 class="card-title"><a href={`/typesafe-jev/use-cases/${facet.slug}`}>{facet.label}</a></h2>
          <p class="card-note">{facet.blurb}</p>
          <ul class="facet-sources">
            {facet.bySource.map((row) => (
              <li><span>{row.source}</span><span class="n">{row.count}</span></li>
            ))}
          </ul>
          <p class="card-meta">
            <a href={`/typesafe-jev/use-cases/${facet.slug}`}>All {facet.count} →</a>
          </p>
        </div>
      </li>
    ))}
  </ul>

  <section class="col">
    <h2>Which of these is my job?</h2>
    <p>
      The test is the same for all six: if the answer is one of a fixed set, and you can recover from
      a wrong one, this is cheaper and faster than asking a chat model. If the answer has to be
      prose, it is the wrong tool.
      <a href="/typesafe-jev/use-cases/jobs">The nine jobs, explained</a> takes that apart case by
      case, and <a href="/typesafe-jev/reference">the reference page</a> has the specs and the price.
    </p>
  </section>

  <TopicIndex entries={jevTopicEntries} current={canonical} />
</System>

<style>
  /* Where the rows behind this page come from — the thing that makes it a cross-cut rather than a
     column. Not links: the card has exactly one destination, and a card with seven links in it asks
     the reader to choose before they know what the page is. */
  .facet-sources { margin: var(--space-3) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--border); }
  .facet-sources li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .facet-sources li:last-child { border-bottom: 0; }
  .facet-sources .n { font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--text-faint); }
</style>
