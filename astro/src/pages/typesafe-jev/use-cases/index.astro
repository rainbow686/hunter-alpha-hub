---
/**
 * /typesafe-jev/use-cases — every row that carries a use case, on one page, filterable.
 *
 * This page has now been three things in one day, and the reader's last note is the one that
 * settled it: "把 use case 这一页不要按类别分了，就多余了。直接把所有的 use case 都展示在这一页上面，
 * 然后横向加一个可以在本页过滤的分类功能."
 *
 * They were right about the duplication. The version before this one was an index of six cards,
 * one per facet page — but a card that only says "Browser agents · 18" is not content, it is a
 * second menu for pages the capsule panel already links, and the six facet pages underneath are
 * themselves filters of this one list. So the index is gone and this is **the list**:
 *
 *   - every tagged row we hold, in the three-column wall the rest of the topic uses;
 *   - one chip row that filters it in place, with no URL of its own — the six facet pages remain
 *     the addressable versions, each with its own h1 and its own search intent ("jev for trading");
 *   - the prose ("the nine jobs") lives at /typesafe-jev/use-cases/jobs, which is the explainer and
 *     not a second copy of this page.
 */
import System from "../../../layouts/System.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import CardFilter from "../../../components/CardFilter.astro";
import TopicIndex from "../../../components/TopicIndex.astro";
import XClipWall from "../../../components/XClipWall.astro";
import { articleSchema, SITE, SITE_NAME } from "../../../lib/schema";
import { JEV_FACETS, JEV_FACET_COUNTS, JEV_ITEMS_TOTAL, JEV_TAGGED_TOTAL, itemsByFacet, thumbRatio } from "@repo/lib/jev-facets";
import { jevTopicEntries } from "@repo/lib/jev-topic";

const title = "Jev use cases: every project, post and video by what it decides (2026)";
const description = `All ${JEV_TAGGED_TOTAL} Jev use-case records in one list — browser agents, triage, coding, research, media, trading — filterable here, with a page per use case behind it.`;
const canonical = `${SITE}/typesafe-jev/use-cases`;

/**
 * The union of the six facets, deduplicated: a row that carries two use cases appears once here
 * (and in two facet pages, which is what a facet is). Same rows, same notes, same numbers as the
 * facet pages, because those pages read them from this same file.
 */
const items = [
  ...new Map(JEV_FACET_COUNTS.flatMap((facet) => itemsByFacet(facet.slug)).map((item) => [item.id, item])).values(),
].sort((a, b) => a.title.localeCompare(b.title));

const chips = JEV_FACET_COUNTS.map((facet) => ({
  group: "tag",
  value: facet.slug,
  label: facet.label,
  count: facet.count,
}));
---

<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} wide ogType="article" noReferrer>
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Jev use cases",
      description,
      publishedAt: "2026-09-24",
      updatedAt: "2026-09-24",
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <Breadcrumbs schema={true} items={[
    { name: "Jev", url: `${SITE}/typesafe-jev` },
    { name: "Use cases", url: canonical },
  ]} />

  <header class="col">
    <p class="card-eyebrow">Use cases · Jev</p>
    <h1>Jev use cases</h1>
    <p class="lede">
      Every row we have catalogued that carries a kind of decision — {items.length} of the
      {JEV_ITEMS_TOTAL} records in the topic, from every source we track. Filter it here, or open the
      use case you care about, which has its own page and its own lists.
    </p>
    <p class="provenance">
      <span>{JEV_FACET_COUNTS.length} use cases</span>
      <span>{JEV_TAGGED_TOTAL} records tagged out of {JEV_ITEMS_TOTAL}</span>
      <span><a href="/typesafe-jev/use-cases/jobs">The nine jobs, explained in prose</a></span>
    </p>
  </header>

  {/*
    A filter, not a menu: the six chips narrow this page in place and mint no URL. The pages behind
    them are the ones a search engine should find, and each is linked from every card that carries
    that use case.
  */}
  <CardFilter chips={chips} noun="records" total={items.length} />

  <ul class="card-grid">
    {items.map((item) => (
      <li class="card" data-tags={item.tags.join(" ")}>
        {item.thumb && item.video ? (
          <div class="card-media" style={`--ratio: ${thumbRatio(item.thumbW, item.thumbH)}`}>
            <span class="card-src">{item.source}</span>
            <button class="xvideo-facade" type="button" data-xvideo={item.video.url} data-poster={item.thumb} aria-label={`Play the clip in this post: ${item.title}`}>
              <img src={item.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              <span class="xvideo-play" aria-hidden="true">▶</span>
            </button>
          </div>
        ) : item.thumb ? (
          <div class="card-media" style={`--ratio: ${thumbRatio(item.thumbW, item.thumbH)}`}>
            <span class="card-src">{item.source}</span>
            <img src={item.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
          </div>
        ) : null}
        <div class="card-body">
          <p class="card-eyebrow">{item.source} · {item.sourceKind}</p>
          <h2 class="card-title"><a href={item.pageSlug ? `/typesafe-jev/x-posts/${item.pageSlug}` : item.url} rel="noopener">{item.title}</a></h2>
          <p class="card-note card-our">{item.note}</p>
          <p class="card-meta">{item.meta.map((m) => <span>{m}</span>)}</p>
          <p class="card-meta">
            {item.tags.map((tag) => (
              <a href={`/typesafe-jev/use-cases/${tag}`}>{JEV_FACETS.find((f) => f.slug === tag)?.label ?? tag}</a>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ul>

  <TopicIndex entries={jevTopicEntries} current={canonical.replace(SITE, "")} />
</System>

<XClipWall />
