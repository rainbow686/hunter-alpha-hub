---
/**
 * Jev (TypeSafe) — hand-written model reference.
 *
 * Why this page is not generated from the snapshot: `typesafe/jev-1.13` is
 * served by OpenRouter but is absent from the `/api/v1/models` list that
 * `scripts/sync-openrouter-models.ts` reads, so nothing in the build would ever
 * create it. It is the one model page in the site that a human has to keep, and
 * the date stamp is the price of that.
 *
 * Contract carried over from the stealth-line pages: facts live in a FactTable
 * with a provenance line, other people's reporting lives in ClaimList with a
 * confidence tag, and the two never share a surface. The disambiguation block
 * exists because the bare word "jev" is not ours to claim.
 */
import System from "../../layouts/System.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import FactTable from "../../components/FactTable.astro";
import ClaimList from "../../components/ClaimList.astro";
import TimelineList from "../../components/TimelineList.astro";
import Faq from "../../components/Faq.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import TopicWall, { type WallItem } from "../../components/TopicWall.astro";
import XClipWall from "../../components/XClipWall.astro";
import { jevLaunchPost, jevXPosts, jevXPostsWithPages } from "@repo/lib/jev-x-posts";
import { jevBuilds, jevBuildsWithPages } from "@repo/lib/jev-builds";
import { jevVideos } from "@repo/lib/jev-videos";
import { jevThreads } from "@repo/lib/jev-threads";
import { articleSchema, breadcrumbSchema, faqSchema, SITE, SITE_NAME } from "../../lib/schema";
import {
  JEV_CLOUDFLARE_URL,
  JEV_DATA_AS_OF,
  JEV_INPUT_PRICE_PER_MILLION,
  JEV_LISTED_AT_UTC,
  JEV_MODEL_ID,
  JEV_OPENROUTER_URL,
  JEV_TYPESAFE_BLOG_URL,
  alsoCalledJev,
  claims,
  jevFaqs,
  timeline,
  verifiedSpecs,
} from "@repo/lib/jev";
import {
  JEV_OURS_MEASURED_ON,
  JEV_OURS_SAMPLES,
  oursAmbiguity,
  oursLabelStability,
  oursLatency,
  oursPhrasing,
  oursSampleResponse,
  oursSchemaProbe,
  oursSpread,
  oursUsage,
} from "@repo/lib/jev-our-measurements";

const title = "Jev on OpenRouter: TypeSafe's System One Model, Priced and Explained (2026)";
const h1 = "What is Jev? TypeSafe's decision model, on OpenRouter";
const description =
  "Jev is TypeSafe's System One model: text state in, typed decisions out, 32K context, $0.042 per million input tokens and free output. Listed on OpenRouter as typesafe/jev-1.13 — specs, price, and what it is not.";
const canonical = `${SITE}/typesafe-jev`;

const tldr = [
  ["Maker", "TypeSafe AI", "Announced 2026-09-15"],
  ["Class", "System One", "Decisions, not text"],
  ["OpenRouter ID", "typesafe/jev-1.13", "Listed 18 Sep 2026"],
  ["Context", "32,000", "tokens"],
  ["Input price", `$${JEV_INPUT_PRICE_PER_MILLION}`, "per million tokens"],
  ["Output price", "Free", "returns a decision"],
  ["Latency", "70–500 ms", "vendor-claimed"],
  ["Writes text?", "No", "gives up string generation"],
];

/** The three question types, in the shape the answer comes back in. */
const questionTypes = [
  {
    name: "Noul",
    shape: "a probability between 0 and 1",
    detail: "You name the true and false criteria; the model answers how likely the true one is.",
  },
  {
    name: "Choice",
    shape: "one option from a set you define",
    detail: "Routing, classification, triage — wherever the branches are already written down.",
  },
  {
    name: "Score",
    shape: "a position on an ordered scale you define",
    detail: "Grading, priors, severity. The scale is yours, so the output is already meaningful to code.",
  },
];

const vias = [
  {
    name: "OpenRouter",
    id: JEV_MODEL_ID,
    note: "One key, one bill, the same endpoint the rest of the directory is read from.",
    href: JEV_OPENROUTER_URL,
  },
  {
    name: "Cloudflare Workers AI",
    id: "typesafe/jev",
    note: "Listed as a third-party model; called through env.AI.run with a state and a questions object.",
    href: JEV_CLOUDFLARE_URL,
  },
];

const relatedPages = [
  {
    href: "/typesafe-jev/reference",
    title: "Jev, specified",
    /*
     * The long version moved here on 2026-09-24: specs, price, question types, the four other
     * things called Jev, and the probe we ran. The front page keeps the wall and the answer in
     * one screen; the appendix reads at the 760 column it was written for.
     */
    body: "The long version — verified specs, what the API actually returns, how to call it, and the 13 adversarial cases we ran ourselves.",
  },
  {
    href: "/comparison",
    title: "Compare the models that do write text",
    body: "15 LLMs side by side on price, context and fit — the tools Jev is meant to be called instead of, not alongside.",
  },
  {
    href: "/openrouter-models",
    title: "The full model directory",
    body: "Every model this site tracks, with the price and window read from the public catalogue.",
  },
  {
    href: "/stealth-models",
    title: "The Alpha line",
    body: "The other way a new model shows up on OpenRouter: anonymous, free, and gone in days. Jev did not arrive that way, and the difference matters.",
  },
];

/**
 * The probe rows, flattened to plain strings before they reach the table.
 *
 * Why: this compiler re-opens the last element-wrapped expression inside a
 * `<table>` after the table closes, so a conditional `{<span>}` in the final cell
 * would have swallowed the paragraph that follows it. Tables on this page carry
 * bare expressions only — see scripts/check-markup.mjs for the reproduction.
 */
const probeAttempts = oursSchemaProbe.attempts.map((row) => ({
  attempt: row.attempt,
  sent: row.sent,
  outcome: row.confidence ? `${row.returned} — ${row.confidence}` : row.returned,
}));

/**
 * The front page (2026-09-24). This page is the model's *home*, so it opens with
 * what the topic contains and how big it is, then the reference material below —
 * the order a magazine uses, and the order the reference site uses ("what people
 * are building", then the explainers).
 *
 * The wall is a **sample**: up to twenty-four from each column, interleaved, every one of
 * them in the column's own index with the full list. The reader asked for a fuller wall on
 * 2026-09-24 and twenty-four per column is what they approved.
 *
 * **Twenty-four per column is not ninety-six cards**, which is what I first told them:
 * twenty-four times four only reaches ninety-six if every column holds twenty-four, and
 * three of the four do not (builds 18, videos 12, threads 14 — read from the same files the
 * column pages render). The wall is therefore **68 cards** today, and it grows on its own as
 * the small columns grow. That is the honest version of "make it fuller", and it is why the
 * number is not written down anywhere on the page: the strip above asks the data.
 *
 * A bigger wall costs nothing at load — every image is lazy and hotlinked, so first paint
 * fetches only the posters on screen — but it does cost *attention*: past a few screens a
 * reader stops reading and starts scrolling. The guard against this page becoming the index
 * is that every card links into its column, not that the page is short.
 */
const fmt = (n: number) => n.toLocaleString("en-US");

/*
 * The hero's two media pieces, picked by name and by rank rather than by hand in the markup.
 *
 * `heroLaunch` is the model's own launch post (see lib/jev-x-posts.ts for why it is looked up
 * by id); `heroVideo` is whatever the videos column currently holds at the top, which is the
 * most-watched explainer — a count, not an editorial pick, so it stays true as the column grows.
 */
const heroLaunch = jevLaunchPost;
const heroLaunchRatio = heroLaunch ? `${heroLaunch.thumbW} / ${heroLaunch.thumbH}` : "16 / 9";
const heroVideo = jevVideos[0] ?? null;
const WALL_PER_COLUMN = 24;

const wallX: WallItem[] = jevXPosts.slice(0, WALL_PER_COLUMN).map((post) => ({
  kind: "X post",
  headline: post.page?.headline ?? post.title,
  href: post.page ? `/typesafe-jev/x-posts/${post.page.slug}` : post.url,
  external: !post.page,
  note: post.ourNote,
  meta: [`${fmt(post.likes)} likes`, post.publishedAt],
  thumb: post.thumb || undefined,
  thumbW: post.thumbW,
  thumbH: post.thumbH,
  avatar: post.avatar || undefined,
  /*
   * Only the X rows carry a clip: a `<video>` on X's CDN is a progressive mp4 we can
   * hotlink, while the videos column is YouTube, which stays click-to-load (ADR-0022).
   */
  video: post.video?.url,
}));

const wallBuilds: WallItem[] = jevBuilds.slice(0, WALL_PER_COLUMN).map((build) => ({
  kind: "Repository",
  headline: build.title,
  href: build.dossier ? `/typesafe-jev/builds/${build.dossier.slug}` : build.url,
  external: !build.dossier,
  note: build.ourNote,
  meta: [`${fmt(build.stars)} stars`, build.language ?? "—"],
  thumb: build.card ?? undefined,
}));

const wallVideos: WallItem[] = jevVideos.slice(0, WALL_PER_COLUMN).map((video) => ({
  kind: "Video",
  headline: video.title,
  href: video.url,
  external: true,
  note: video.ourNote,
  meta: [`${fmt(video.views)} views`, video.channel],
  thumb: video.thumb || undefined,
  thumbW: video.thumbW,
  thumbH: video.thumbH,
}));

const wallThreads: WallItem[] = jevThreads.slice(0, WALL_PER_COLUMN).map((thread) => ({
  kind: thread.source === "hn" ? "Hacker News" : "dev.to",
  headline: thread.title,
  href: thread.url,
  external: true,
  note: thread.ourNote,
  meta: [`${fmt(thread.score)} ${thread.scoreLabel}`, thread.publishedAt],
}));

/*
 * Interleaved rather than concatenated: one card from each column, four times
 * over, so the first screen alone shows an X post, a repository, a video and a
 * discussion. Sorting all 48 by one number would put four X posts at the top and
 * make the page look like one column.
 */
const wall: WallItem[] = [];
for (let i = 0; i < WALL_PER_COLUMN; i += 1) {
  for (const column of [wallX, wallBuilds, wallVideos, wallThreads]) {
    if (column[i]) wall.push(column[i]);
  }
}

/** The four columns, in the order a reader meets them, with their real counts. */
const columns = [
  { label: "Built with Jev", href: "/typesafe-jev/builds", count: jevBuilds.length },
  { label: "Seen on X", href: "/typesafe-jev/x-posts", count: jevXPosts.length },
  { label: "Videos", href: "/typesafe-jev/videos", count: jevVideos.length },
  { label: "Threads and write-ups", href: "/typesafe-jev/threads", count: jevThreads.length },
];

const recordCount = jevBuilds.length + jevXPosts.length + jevVideos.length + jevThreads.length;
const withPages = jevBuildsWithPages.length + jevXPostsWithPages.length;

/** The numbers strip: what this topic holds, and one number of our own. */
const heroStats = [
  { value: fmt(recordCount), label: "records in the four columns", note: `${withPages} of them have a page of ours` },
  { value: fmt(jevXPosts.length), label: "posts by other people", note: `the largest is ${fmt(Math.max(...jevXPosts.map((p) => p.likes)))} likes` },
  { value: fmt(jevBuilds.length), label: "repositories tracked", note: "stars re-read by the GitHub ingest" },
  { value: "783 ms", label: "median from our own run", note: `${JEV_OURS_SAMPLES} calls, from this machine, 2026-09-20` },
];
---
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} ogType="article" noReferrer wide>
  {/*
    `noReferrer` is required the moment the wall carries a clip: video.twimg.com answers 403 to
    any request with a third-party Referer, and a media element cannot opt out on its own (see
    System.astro). The column pages have carried it since the clips went in; the front page
    picked up the same clips on 2026-09-24.

    `wide` since the same day, and it was an outright bug rather than a preference: ADR-0019
    splits the tiers on "is this page one subject or a row of many things", this page became
    the second kind when the wall went in, and it kept the first kind's width — so the wall
    laid out at 760 and rendered **two** columns of 368, not three. The reader saw it before
    we did. Prose inside a wide page is fine: the tier decides the frame, not the paragraph
    measure, and the reference material below the wall is unchanged.
  */}
  <Breadcrumbs schema={false} items={[
    { name: "Jev", url: canonical },
  ]} />

  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Jev (TypeSafe): the System One model on OpenRouter",
      description:
        "TypeSafe's Jev returns typed decisions with calibrated probabilities instead of generating text. Specs, price and question types, read from the public listings on 2026-09-18.",
      publishedAt: JEV_DATA_AS_OF,
      updatedAt: JEV_DATA_AS_OF,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <JsonLd slot="head" data={faqSchema(jevFaqs)} />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "OpenRouter models", url: `${SITE}/openrouter-models` },
      { name: "Jev (TypeSafe)", url: canonical },
    ])}
  />


  {/*
    The hero is two columns — the words on the left, something real on the right — and that is
    a change the reader asked for on 2026-09-24: "一般网站左侧是文字介绍，右侧是图，只有长文才上下
    排". They were right, and the second half of the note was the useful half: the picture should
    not be another generated engraving. The model's own launch post is the image that stands for
    it (Diogo Almeida, 15 September 2026, 75,869 likes, the clip that announced Jev), so the
    right column is that, playable, followed by the most-watched explainer we track.
  */}
  <section class="topic-hero">
    <div class="hero-copy">
      <p class="kicker">Model reference · verified {JEV_DATA_AS_OF}</p>
      <h1 class="display">{h1}</h1>
      <p class="lede">
        Jev is TypeSafe's first model, announced on 15 September 2026 and listed on OpenRouter three days
        later. It does not write. You hand it program state and a typed question, and it hands back a decision
        with a probability attached — the thing a chat model is worst at and a program needs most.
      </p>
      <div class="byline">
        {/*
          The listed time is a full ISO stamp in the data (`2026-09-18T00:01:24Z`) and it was
          printed raw here — a timestamp in the middle of a sentence for a reader who wants
          "when". Cut to its date, which is the resolution at which the claim is useful.
        */}
        <span>Listed {JEV_LISTED_AT_UTC.slice(0, 10)}</span>
        <span>
          <a href={JEV_OPENROUTER_URL} rel="noopener noreferrer">OpenRouter listing →</a>
        </span>
      </div>

      {/*
        Three counts and one figure of our own: what the topic holds, and that at least one
        number on it came out of this machine rather than out of a vendor's deck. Each tile says
        where its number came from, because a number with no source is the thing this site
        exists to avoid.
      */}
      <ul class="stat-row">
        {heroStats.map((stat) => (
          <li>
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-note">{stat.note}</span>
          </li>
        ))}
      </ul>

      {/*
        The chips are the topic's own **reading**, not its shelves: guide, price, comparison,
        open source, statistics. The shelves (Built with Jev / X posts / Videos / Threads /
        Resources / Use cases) live in the sticky switcher under the header, on every page of
        the topic — two copies of one row 400px apart is the page arguing with itself about
        which one is the entrance.
      */}
      <nav class="topic-chips" aria-label="Jev explainers">
        <a href="/typesafe-jev/guide">How people use Jev</a>
        <a href="/typesafe-jev/pricing">What a decision costs</a>
        <a href="/typesafe-jev/vs-llm">Jev vs an LLM</a>
        <a href="/typesafe-jev/open-source">Open source, and what it gives up</a>
        <a href="/typesafe-jev/reference">Specs, and what we measured</a>
      </nav>
    </div>

    <div class="hero-media">
      {heroLaunch && (
        <figure class="hero-card">
          <div class="card-media" style={`--ratio: ${heroLaunchRatio}`}>
            <span class="card-src">X post · the launch</span>
            {heroLaunch.video ? (
              <button
                class="xvideo-facade"
                type="button"
                data-xvideo={heroLaunch.video.url}
                data-poster={heroLaunch.thumb}
                aria-label={`Play the launch clip: ${heroLaunch.page?.headline ?? heroLaunch.title}`}
              >
                <img src={heroLaunch.thumb} alt="" width={heroLaunch.thumbW} height={heroLaunch.thumbH} decoding="async" referrerpolicy="no-referrer" />
                <span class="xvideo-play" aria-hidden="true">▶</span>
              </button>
            ) : (
              <img src={heroLaunch.thumb} alt="" width={heroLaunch.thumbW} height={heroLaunch.thumbH} decoding="async" referrerpolicy="no-referrer" />
            )}
          </div>
          <figcaption class="hero-cap">
            <span class="hero-cap-title">The launch post, read out loud</span>
            <span class="hero-cap-meta">
              Diogo Almeida (@CompleteSkeptic) · {heroLaunch.publishedAt} · {fmt(heroLaunch.likes)} likes
            </span>
            {heroLaunch.page && (
              <a class="hero-cap-link" href={`/typesafe-jev/x-posts/${heroLaunch.page.slug}`}>
                What it claims, and what we make of it →
              </a>
            )}
          </figcaption>
        </figure>
      )}

      {heroVideo && (
        <figure class="hero-card hero-card-small">
          <a class="hero-video" href={heroVideo.url} rel="noopener noreferrer">
            <span class="hero-video-frame">
              <img src={heroVideo.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            </span>
            <span class="hero-video-body">
              <span class="card-eyebrow">Video · {Math.max(1, Math.round(heroVideo.durationS / 60))} min</span>
              <span class="hero-video-title">{heroVideo.title}</span>
              <span class="hero-cap-meta">{heroVideo.channel} · {fmt(heroVideo.views)} views</span>
            </span>
          </a>
        </figure>
      )}
    </div>
  </section>

  <h2 id="tldr">The short version</h2>
  <div class="stats">
    {tldr.map(([label, value, sub]) => (
      <div class="stat">
        <div class="label">{label}</div>
        <div class="value" style="font-size: var(--text-xl);">{value}</div>
        <div class="sub">{sub}</div>
      </div>
    ))}
  </div>


  <h2>FAQ</h2>
  <Faq items={jevFaqs} />

  {/*
    The wall. Below it the page continues as it did — the facts, the three question
    types, our own run, the FAQ — because a reader who wants the reference should
    not have to scroll past 48 cards to find it, and a reader who wanted to know
    whether anything is happening here has already been answered.
  */}
  <section class="topic-wall">
    <h2>What people are building</h2>
    <TopicWall items={wall} columns={columns} />
  </section>


  {/* The player for any clip the wall above rendered (see TopicWall.astro). */}
  <XClipWall />

  <section class="card" style="margin-top: var(--space-12);">
    <h2 style="margin-top: 0;">When the next model lands, you will hear about it</h2>
    <p style="color: var(--text-muted); max-width: var(--measure);">
      Jev arrived with an announcement, a company and a founder — unlike the Alpha line, which shows up
      anonymous and free. We track both. Leave an email and we will send one note when the next one appears,
      with the specs read from the catalogue.
    </p>
    <SubscribeForm note="One email per model. No newsletter, no forwarding, unsubscribe in one click." />
  </section>

  <h2>Where to go next</h2>
  <div class="grid-cards">
    {relatedPages.map((page) => (
      <article class="card">
        <h3 class="card-title"><a href={page.href}>{page.title}</a></h3>
        <p class="card-body">{page.body}</p>
      </article>
    ))}
  </div>

  <p class="hero-actions">
    <a class="btn primary" href={JEV_OPENROUTER_URL} rel="noopener noreferrer">Open Jev on OpenRouter →</a>
    <a class="btn ghost" href={JEV_CLOUDFLARE_URL} rel="noopener noreferrer">Cloudflare model card</a>
    <a class="btn ghost" href="/typesafe-jev/guide">How people actually use it</a>
    <a class="btn ghost" href="/openrouter-models">Full model directory</a>
  </p>
</System>

<style>
  /*
   * The hero: words left, media right — the ordinary shape of a front page, and the one the
   * reader asked for on 2026-09-24. Scoped to this page because both halves are this model's:
   * the numbers are counts of *this* topic, and the right column is this model's launch post.
   *
   * It collapses to one column at 1000px. The media column keeps its natural order, so on a
   * phone the reader gets the headline and the lede first and the clip after them, which is
   * the order the single-column version had.
   */
  .topic-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    gap: var(--space-10);
    align-items: start;
    margin: var(--space-5) 0 var(--space-8);
  }
  @media (max-width: 1000px) {
    .topic-hero { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
  }
  /*
   * The measure. A wide frame is right for a grid and wrong for a paragraph: at 1048 this
   * lede ran ~110 characters a line. `--measure` is `none` site-wide (ADR-0019), so the
   * hero sets its own — the one place on this page with continuous prose.
   */
  .hero-copy { max-width: 62ch; }
  .hero-media { display: grid; gap: var(--space-5); }
  .hero-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .hero-cap { display: flex; flex-direction: column; gap: 4px; padding: var(--space-4) var(--space-5) var(--space-5); }
  .hero-cap-title { font-family: var(--sans); font-weight: 600; font-size: var(--text-lg); }
  .hero-cap-meta { font-size: var(--text-xs); color: var(--text-faint); font-variant-numeric: tabular-nums; }
  .hero-cap-link { font-size: var(--text-sm); margin-top: var(--space-2); }
  /* The second card is a doorway to somebody else's video, so it is shaped like a row, not a
     poster: a thumbnail beside its title reads as "watch this" rather than as a second hero. */
  .hero-card-small .hero-video { display: grid; grid-template-columns: 124px minmax(0, 1fr); gap: var(--space-4); align-items: center; text-decoration: none; color: inherit; }
  .hero-video-frame { display: block; aspect-ratio: 16 / 9; background: var(--bg-sunken); overflow: hidden; }
  .hero-video-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-video-body { display: flex; flex-direction: column; gap: 3px; padding: var(--space-3) var(--space-4) var(--space-3) 0; }
  .hero-video-title { font-family: var(--sans); font-weight: 600; font-size: var(--text-sm); line-height: 1.3; }
  @media (max-width: 520px) {
    .hero-card-small .hero-video { grid-template-columns: 104px minmax(0, 1fr); }
  }
  .stat-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }
  .stat-row li { border-top: 2px solid var(--border-strong); padding-top: var(--space-3); }
  .stat-value { display: block; font-family: var(--sans); font-size: 1.6rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .stat-label { display: block; font-size: var(--text-sm); color: var(--text-muted); margin-top: 2px; }
  .stat-note { display: block; font-size: var(--text-xs); color: var(--text-faint); margin-top: var(--space-2); }

  .topic-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .topic-chips a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
