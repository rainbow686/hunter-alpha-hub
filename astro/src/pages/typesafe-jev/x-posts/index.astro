---
/**
 * /typesafe-jev/x-posts — a source hub: what the field is saying on X.
 *
 * Not a content type, and it does not pretend to be one: a post is a post, and the
 * media inside it (video, image, none) is reported on the card's eyebrow rather than
 * promoted into a category of its own. The seven rows that used to be shown twice, as
 * "demos", are in this list like every other post — see lib/jev-x-posts.ts for how that
 * column came to exist and why it was deleted on 2026-09-23.
 */
import System from "../../../layouts/System.astro";
import JsonLd from "../../../components/JsonLd.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { articleSchema, SITE, SITE_NAME } from "../../../lib/schema";
import CardFilter from "../../../components/CardFilter.astro";
import TopicIndex from "../../../components/TopicIndex.astro";
import { JEV_X_POSTS_READ_ON, jevXPostCounts, jevXPosts } from "@repo/lib/jev-x-posts";
import { JEV_FACET_COUNTS } from "@repo/lib/jev-facets";
import { jevTopicEntries } from "@repo/lib/jev-topic";
import { jevTagsById } from "@repo/lib/jev-facets";

const title = "Jev on X: What People Are Saying (2026)";
const description = `What the field has been saying about TypeSafe's Jev on X — vendor announcements, benchmarks, explainers, sceptical first-week notes — each with our own sentence and a link to the post.`;
const canonical = `${SITE}/typesafe-jev/x-posts`;

/*
 * The media kind is what the card already reports in its eyebrow; the chips just let a
 * reader say "show me only the ones with a video" without a second column claiming that
 * "video" is a category (it is not — see lib/jev-x-posts.ts).
 */
const xPostChips = [
  ...["video", "image"].map((kind) => ({
    group: "media",
    value: kind,
    label: kind === "video" ? "Has a video" : "Has an image",
    count: jevXPosts.filter((p) => p.kind === kind).length,
  })),
  ...JEV_FACET_COUNTS.map((facet) => ({
    group: "tag",
    value: facet.slug,
    label: facet.label,
    count: jevXPosts.filter((p) => (jevTagsById[p.id] ?? []).includes(facet.slug)).length,
  })).filter((chip) => chip.count > 0),
];

const naturalRatio = (w: number, h: number) => {
  if (!w || !h) return "16 / 9";
  const r = Math.min(Math.max(w / h, 0.75), 1.78);
  return `${r.toFixed(3)} / 1`;
};

---

<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} wide ogType="article" noReferrer>

  <Breadcrumbs schema={true} items={[
    { name: "Jev", url: `${SITE}/typesafe-jev` },
    { name: "X posts", url: canonical },
  ]} />
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Jev on X: what people are saying",
      description,
      publishedAt: JEV_X_POSTS_READ_ON,
      updatedAt: JEV_X_POSTS_READ_ON,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <article>
    <header class="col">
      <h1>Jev on X</h1>
      <p class="lede">
        The model arrived with a launch post and no tutorial, so the explaining happened in public. These
        are the posts that mattered — the vendor's own announcements, the platform confirmations, the
        benchmarks people ran, the first-week sceptics — each described in a sentence of ours and linked back.
      </p>
      <p class="provenance">
        <span>{jevXPostCounts.described} posts described</span>
        {jevXPostCounts.waiting > 0 && <span>{jevXPostCounts.waiting} waiting for a note</span>}
        <span><a href="/typesafe-jev/builds">The projects behind them: builds</a></span>
      </p>
    </header>

    {jevXPosts.length === 0 ? (
      <section class="col">
        <h2>Nothing published yet</h2>
        <p>
          Every post we have read so far is described from what we could verify in it — the claim in
          the text, the number in the box, the date — and none of them is described from a caption.
          That is a reason to wait for the next one, not a reason to guess.
        </p>
        <p>
          If you recorded something with Jev, <a href="/contact">send it over</a>: a link, what it
          does, and roughly what it cost you is enough for us to watch it and write it up.
        </p>
      </section>
    ) : (
      <CardFilter chips={xPostChips} noun="posts" total={jevXPosts.length} groups={[{ key: "media", label: "media" }, { key: "tag", label: "use case" }]} />

      <ul class="card-grid">
        {jevXPosts.map((demo) => (
          <li class="card" data-sources="x" data-media={demo.kind} data-tags={(jevTagsById[demo.id] ?? []).join(" ")}>
            {/*
              No thumb, no frame. The old fallback was a grey panel with the source's
              initial centred in it: seventeen of the forty-two X posts have no media,
              so the wall came out as a grid of identical empty rectangles — the thing a
              reader called machine-made. A text-only card now starts at its eyebrow and
              runs shorter, which is what a poster wall is supposed to look like. The
              source is not lost: the eyebrow below already says "X · post".
            */}
            {demo.thumb && demo.video ? (
              /* Playable clip: the poster is the button, and the mp4 only loads on click. */
              <div class="card-media" style={demo.thumbW ? `--ratio: ${naturalRatio(demo.thumbW, demo.thumbH)}` : "--ratio: 16 / 9"}>
                <span class="card-src">X</span>
                <button
                  class="xvideo-facade"
                  type="button"
                  data-xvideo={demo.video.url}
                  data-poster={demo.thumb}
                  aria-label={`Play the clip in this post: ${demo.title}`}
                >
                  <img src={demo.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  <span class="xvideo-play" aria-hidden="true">▶</span>
                </button>
              </div>
            ) : demo.thumb ? (
              <div class="card-media" style={demo.thumbW ? `--ratio: ${naturalRatio(demo.thumbW, demo.thumbH)}` : "--ratio: 16 / 9"}>
                <span class="card-src">X</span>
                <img src={demo.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </div>
            ) : null}
            <div class="card-body">
              <p class="card-eyebrow">X · {demo.kind === "video" ? "video" : demo.kind === "image" ? "image" : "post"}</p>
              <h2 class="card-title"><a href={demo.url} rel="noopener">{demo.title}</a></h2>
              <p class="card-note card-our">{demo.ourNote}</p>
              <p class="card-meta">
                <span>{demo.author}</span>
                <span>{demo.publishedAt}</span>
                <span>{demo.likes.toLocaleString("en-US")} likes</span>
              </p>
            </div>
          </li>
        ))}
      </ul>
    )}

    <section class="col">
      <p class="provenance">
        <span>Entered by hand — see <a href="/contact">contact</a></span>
        <span><a href="/typesafe-jev">Jev topic</a></span>
      </p>
    </section>
    <TopicIndex entries={jevTopicEntries} current="/typesafe-jev/x-posts" />
  </article>


</System>

<style>
  .demo-list { list-style: none; margin: var(--space-8) 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: var(--space-6); }
  .demo { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: var(--space-6); }
  .demo h2 { margin: 0 0 var(--space-2); font-size: var(--text-lg); font-family: var(--serif); }
  .demo-meta { display: flex; gap: var(--space-3); margin: 0 0 var(--space-3); font-size: var(--text-xs); color: var(--text-faint); }
  .demo-note { margin: 0; color: var(--text-muted); }
</style>

<script>
  /*
   * Click-to-play for X clips.
   *
   * The reference site embeds 138 <video> elements and lets the browser sort it out; we do it
   * on click, for two reasons. A wall of a dozen <video preload="metadata"> tags fetches a
   * dozen manifests and first frames for a reader who may watch none, and the clip lives on
   * X's CDN — the reader should pay for it when they ask for it, not when the page loads.
   *
   * This is a hotlink, not a copy (writing contract §3): the mp4 URL is X's, the file stays on
   * video.twimg.com, and the CSP allows exactly that host.
   */
  for (const button of document.querySelectorAll("[data-xvideo]")) {
    button.addEventListener("click", () => {
      const src = button.getAttribute("data-xvideo");
      const poster = button.getAttribute("data-poster") ?? undefined;
      if (!src) return;
      const video = document.createElement("video");
      video.className = "xvideo-player";
      /*
       * `referrerPolicy = "no-referrer"` is not politeness, it is the difference between a
       * video and a black rectangle: x's CDN answers **403 to any request carrying a Referer**
       * (checked with and without the header on 2026-09-23 — no referer 200, referer 403).
       * A browser sends one for media by default, so without this the player sets its src, the
       * fetch is refused, and the element reports MEDIA_ERR_SRC_NOT_SUPPORTED. The poster images
       * have carried the same attribute since the first X card for the same reason.
       */
      video.referrerPolicy = "no-referrer";
      video.src = src;
      if (poster) video.poster = poster;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.preload = "auto";
      // The click is the gesture, so audio is allowed — but a muted start is still the
      // politest default in an office, and one tap un-mutes.
      video.muted = false;
      button.replaceWith(video);
      video.play().catch(() => { video.muted = true; video.play().catch(() => {}); });
    });
  }
</script>
<style is:global>
  .xvideo-facade {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--bg-sunken);
    cursor: pointer;
    aspect-ratio: var(--ratio, 16 / 9);
  }
  .xvideo-facade img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .xvideo-play {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgb(0 0 0 / 62%);
    color: #fff;
    font-size: 16px;
    padding-left: 3px;
  }
  .xvideo-facade:hover .xvideo-play { background: rgb(0 0 0 / 78%); }
  .xvideo-player { display: block; width: 100%; height: auto; background: #000; }
</style>
