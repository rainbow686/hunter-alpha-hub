---
/**
 * /typesafe-jev/demos — what people recorded themselves doing with Jev.
 *
 * Open by design and honest about it: X and Threads have no read API we can afford or
 * get approved (ADR-0023), so this column is filled by hand, one watched demo at a
 * time, and each entry carries a written note. An empty column that says it is empty
 * is the correct state until somebody has actually watched something; the roadmap
 * says the same thing — an empty cell is not a failure.
 */
import System from "../../../layouts/System.astro";
import JsonLd from "../../../components/JsonLd.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { articleSchema, SITE, SITE_NAME } from "../../../lib/schema";
import { JEV_DEMOS_READ_ON, jevDemoCounts, jevDemos } from "@repo/lib/jev-demos";

const title = "Jev Demos: What People Built and Filmed (2026)";
const description = `Recorded demos of TypeSafe's Jev, entered by hand and described by us — currently ${jevDemoCounts.published}, with ${jevDemoCounts.waiting} waiting for a note.`;
const canonical = `${SITE}/typesafe-jev/demos`;
---

<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} wide ogType="article">

  <Breadcrumbs schema={true} items={[
    { name: "Jev", url: `${SITE}/typesafe-jev` },
    { name: "Demos", url: canonical },
  ]} />
  <JsonLd
    slot="head"
    data={articleSchema({
      title: "Jev demos: what people built and filmed",
      description,
      publishedAt: JEV_DEMOS_READ_ON,
      updatedAt: JEV_DEMOS_READ_ON,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <article>
    <header class="col">
      <h1>Demos</h1>
      <p class="lede">
        Screencasts of Jev doing something: driving a browser, routing a purchase order, running a
        game. This column fills slowly and on purpose — a clip is listed after one of us has watched
        it, not after a search engine found it.
      </p>
      <p class="provenance">
        <span>{jevDemoCounts.published} demos described</span>
        <span>{jevDemoCounts.waiting} waiting for a note</span>
        <span><a href="/typesafe-jev/videos">Longer recordings live in videos</a></span>
      </p>
    </header>

    {jevDemos.length === 0 ? (
      <section class="col">
        <h2>Nothing published yet</h2>
        <p>
          The demos we have seen so far were screenshots inside X posts, and we have not watched the
          clips closely enough to tell you what they prove. That is a reason to wait, not a reason to
          describe them from their captions — the difference between this column and a feed is
          exactly that sentence.
        </p>
        <p>
          If you recorded something with Jev, <a href="/contact">send it over</a>: a link, what it
          does, and roughly what it cost you is enough for us to watch it and write it up.
        </p>
      </section>
    ) : (
      <ul class="card-grid">
        {jevDemos.map((demo) => (
          <li class="card">
            {/* The poster image stays on X's CDN: we link to it rather than copy it, and
                the row points at the post for anything else (contract §3). */}
            {demo.thumb ? (
              <div class="card-media" style="--ratio: 16 / 9">
                <span class="card-src">X</span>
                <img src={demo.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </div>
            ) : (
              <div class="card-media card-chip" style="--ratio: 21 / 9" aria-hidden="true">X</div>
            )}
            <div class="card-body">
              <p class="card-eyebrow">X · {demo.kind === "video" ? "video" : demo.kind === "image" ? "image" : "post"}</p>
              <h2 class="card-title"><a href={demo.url} rel="noopener">{demo.title}</a></h2>
              <p class="card-note card-our">{demo.ourNote}</p>
              <p class="card-meta">
                <span>{demo.author}</span>
                <span>{demo.publishedAt}</span>
                <span>{demo.likes.toLocaleString("en-US")} likes</span>
              </p>
            </div>
          </li>
        ))}
      </ul>
    )}

    <section class="col">
      <p class="provenance">
        <span>Entered by hand — see <a href="/contact">contact</a></span>
        <span><a href="/typesafe-jev">Jev topic</a></span>
      </p>
    </section>
  </article>
</System>

<style>
  .demo-list { list-style: none; margin: var(--space-8) 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: var(--space-6); }
  .demo { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: var(--space-6); }
  .demo h2 { margin: 0 0 var(--space-2); font-size: var(--text-lg); font-family: var(--serif); }
  .demo-meta { display: flex; gap: var(--space-3); margin: 0 0 var(--space-3); font-size: var(--text-xs); color: var(--text-faint); }
  .demo-note { margin: 0; color: var(--text-muted); }
</style>
