---
import "../styles/v7.css";
import Logo from "../components/Logo.astro";

interface Props { title: string; description: string; canonical?: string; meta?: string }
const { title, description, canonical, meta = "15 models tracked · verified 06:00 UTC" } = Astro.props;
const path = Astro.url.pathname;

const sections = [
  { href: "/comparison", label: "Comparison" },
  { href: "/openrouter-models", label: "Models" },
  { href: "/openrouter-pricing-calculator", label: "Pricing" },
  { href: "/stealth-models", label: "Stealth line" },
  { href: "/union-alpha", label: "Union Alpha" },
  { href: "/blog", label: "Articles" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <div class="top-rule"></div>
    <header class="site">
      <div class="masthead">
        <div class="wrap">
          <a class="brand" href="/">
            <Logo size={32} />
            <span class="wordmark">hunteralpha<span class="accent">hub</span></span>
          </a>
          <div class="identity">
            <span class="line1">OpenRouter model reference</span>
            <span class="line2">Facts from the public catalogue, dated and labelled</span>
          </div>
          <div class="live-slot">
            <span class="badge live"><span class="dot"></span> Union Alpha live</span>
            <span class="stamp">Verified<br />2026-09-17</span>
          </div>
        </div>
      </div>
      <div class="navrow">
        <div class="wrap">
          <nav>
            {sections.map((s) => (
              <a href={s.href} aria-current={path === s.href ? "page" : undefined}>{s.label}</a>
            ))}
          </nav>
          <span class="meta">{meta}</span>
        </div>
      </div>
    </header>

    <main class="wrap" style="padding-top: var(--space-8); padding-bottom: var(--space-12);">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-col">
            <h3>Where the numbers come from</h3>
            <div class="source-list">
              <div class="row"><span>Model fields</span><code>openrouter.ai/api/v1/models</code></div>
              <div class="row"><span>Drift check</span><code>daily 06:00</code></div>
              <div class="row"><span>Last verified</span><code>2026-09-17</code></div>
            </div>
          </div>
          <div class="foot-col">
            <h3>Reference</h3>
            <ul>
              <li><a href="/openrouter-models">Model index</a></li>
              <li><a href="/comparison">Comparisons</a></li>
              <li><a href="/openrouter-pricing-calculator">Cost calculator</a></li>
              <li><a href="/openrouter-free-models">Free models</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h3>Stealth line</h3>
            <ul>
              <li><a href="/stealth-models">All stealth releases</a></li>
              <li><a href="/union-alpha">Union Alpha · Unbiased Pareto</a></li>
              <li><a href="/ox-alpha">OX Alpha (revealed)</a></li>
              <li><a href="/hunter-alpha">Hunter Alpha (revealed)</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h3>Site</h3>
            <ul>
              <li><a href="/blog">Articles</a></li>
              <li><a href="/zh/access">中文文档</a></li>
              <li><a href="/terms">Terms of service</a></li>
              <li><a href="/privacy">Privacy policy</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-base">
          <span>Independent reference. Not affiliated with OpenRouter or any model provider.</span>
          <span class="disclaimer">
            Pricing, context windows and availability change without notice; stealth endpoints especially.
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
