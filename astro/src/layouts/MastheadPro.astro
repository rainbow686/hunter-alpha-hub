---
import "../styles/v10.css";
import "../styles/v11.css";
import Logo from "../components/Logo.astro";

interface Props { title: string; description: string; mode?: "persistent" | "shrink" | "collapse"; meta?: string }
const { title, description, mode = "persistent", meta = "15 models tracked · verified 06:00 UTC" } = Astro.props;
const path = Astro.url.pathname;
const showMiniBrand = mode === "persistent" || mode === "collapse";
const scripted = mode === "shrink" || mode === "collapse";

const sections = [
  { href: "/comparison", label: "Comparison" },
  { href: "/openrouter-models", label: "Models" },
  { href: "/openrouter-pricing-calculator", label: "Pricing" },
  { href: "/stealth-models", label: "Stealth line" },
  { href: "/union-alpha", label: "Union Alpha" },
  { href: "/blog", label: "Articles" },
];

const wordmark = (size: number) => size;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class={mode}>
    <div class="top-rule"></div>
    <header class="site">
      <div class="masthead">
        <div class="wrap">
          <a class="brand" href="/">
            <span class="mark-tile"><Logo size={24} /></span>
            <span class="wordmark">
              <span>Hunter</span><em style="font-style: italic;">Alpha</em><span>Hub</span>
            </span>
          </a>
          <div class="identity">
            <span class="line1">OpenRouter model reference</span>
            <span class="line2">Facts from the public catalogue, dated and labelled</span>
          </div>
          <div class="live-slot">
            <span class="badge live"><span class="dot"></span> Union Alpha live</span>
            <span class="stamp">Verified<br />2026-09-17</span>
          </div>
        </div>
      </div>
      <div class="navrow">
        <div class="wrap">
          {showMiniBrand && (
            <a class="brand-mini" href="/">
              <span class="mark-tile" style="width:26px;height:26px;border-radius:7px;"><Logo size={17} /></span>
              <span class="mini-word">Hunter<em style="font-style: italic;">Alpha</em>Hub</span>
            </a>
          )}
          <nav>
            {sections.map((s) => (
              <a href={s.href} aria-current={path === s.href ? "page" : undefined}>{s.label}</a>
            ))}
          </nav>
          <span class="meta">{meta}</span>
        </div>
      </div>
    </header>

    <main class="wrap" style="padding-top: var(--space-8); padding-bottom: var(--space-12);">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-base" style="border-top:none; padding-top: var(--space-8);">
          <span>Independent reference. Not affiliated with OpenRouter or any model provider.</span>
        </div>
      </div>
    </footer>

    {scripted && (
      <script is:inline>
        const header = document.querySelector("header.site");
        // Hysteresis + a lock while the transition runs. A single threshold makes
        // the header flip back and forth when the collapse itself shifts the page
        // height around the trigger point.
        const CONDENSE_AT = 120;
        const EXPAND_AT = 48;
        const LOCK_MS = 320;
        let lockedUntil = 0;
        let queued = false;

        const apply = () => {
          queued = false;
          const y = window.scrollY;
          const condensed = header.classList.contains("is-condensed");
          const now = performance.now();
          if (now < lockedUntil) return;
          if (!condensed && y > CONDENSE_AT) {
            header.classList.add("is-condensed");
            lockedUntil = now + LOCK_MS;
          } else if (condensed && y < EXPAND_AT) {
            header.classList.remove("is-condensed");
            lockedUntil = now + LOCK_MS;
          }
        };

        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(apply);
        };

        apply();
        window.addEventListener("scroll", onScroll, { passive: true });
      </script>
    )}
  </body>
</html>
