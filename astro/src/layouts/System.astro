---
import "../styles/system.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";
import { SITE, SITE_NAME } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** BCP-47 tag for <html lang> and the og:locale hint. Chinese pages pass zh-CN. */
  lang?: string;
  /**
   * `<link rel="alternate" hreflang>` pairs. The live site declares these for the
   * Chinese/English twins of /access and /faq — and the Astro rewrite dropped every
   * one of them, which no guard noticed because head parity only parsed `<meta>`
   * tags. `check:parity` now compares hreflang links too (`docs/lessons/`).
   */
  alternates?: { lang: string; href: string }[];
  /**
   * og:type. The live site marks every content page (blog, model, comparison,
   * stealth line) as `article` and the hubs as `website`; a social card that says
   * `website` for a single article is a wasted signal.
   */
  ogType?: "website" | "article";
  /** Override the derived per-page card (the 404 page points at the site card). */
  ogImage?: string;
}
const {
  title,
  description,
  canonical,
  lang = "en",
  ogType = "website",
  ogImage: ogImageProp,
  alternates = [],
} = Astro.props;

/**
 * Publisher id for the AdSense script, injected from the build environment so the
 * production deploy can carry it and the preview deploy cannot. `ca-pub-…` is not
 * a secret — it is already published in `public/ads.txt` — but gating it at build
 * time is what keeps ad code off the preview host.
 */
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID as string | undefined;
/**
 * One card per page, generated after the build by scripts/generate-og-images.mjs.
 * The path is derived from the URL (not passed in per page) so a new page gets a
 * card for free — and `npm run check:files` fails if a declared card is missing,
 * so the URL can never quietly point at nothing.
 */
// The canonical is the served URL. `Astro.url.pathname` carries the build's
// file-format suffix (`/access.html`), which produced og:image URLs ending in
// `.html.png` — caught by `npm run check:files`, not by eye.
const pagePath = (canonical ? new URL(canonical).pathname : Astro.url.pathname)
  .replace(/\.html$/, "")
  .replace(/\/$/, "");
const ogImage = ogImageProp ?? `${SITE}${pagePath === "" ? "/og/home.png" : `/og${pagePath}.png`}`;
const ogLocale = lang.startsWith("zh") ? "zh_CN" : "en_US";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* The live site states this explicitly on every page; leaving it out is not a
        behaviour change (index, follow is the default) but it is a difference for
        no reason, and `check:page-parity` now compares head tags too. */}
    <meta name="robots" content="index, follow" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}
    {/*
      Three icons, because they answer three different clients:
        - the SVG is what current browsers use, and it carries the night variant;
        - `/favicon.ico` answers the clients that request that path blind (it 404'd
          until 2026-09-18, so those clients showed nothing rather than the old mark);
        - `apple-touch-icon` must be a PNG — iOS does not read SVG there, so the
          link that used to point at the SVG produced no icon at all on a home screen.

      `?v=2` is not decoration: browsers cache favicons harder than almost anything
      else and often keep showing the previous one after a deploy. A new URL is the
      only reliable way to make a returning visitor fetch it. Bump it when the mark
      changes; `npm run icons` regenerates the bitmaps from the SVG.
    */}
    {/*
      AdSense lives in the head, server-rendered, and only when the build was given
      a publisher id — `npm run deploy:production` sets one, `npm run deploy`
      (preview) does not. A tag the crawler can read in the HTML is what the review
      looks for; a script injected at runtime is not the same thing. There are no
      ad units on the site, so this loads the programme's script without showing
      an ad anywhere.
    */}
    {adsenseId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
        crossorigin="anonymous"></script>
    )}
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical ?? `${SITE}${Astro.url.pathname.replace(/\/$/, "")}`} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:type" content="image/png" />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />
    <meta name="twitter:image:alt" content={title} />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <SiteHeader />
    <main class="wrap" style="padding-top: var(--space-8); padding-bottom: var(--space-12);">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      const header = document.querySelector("header.site");
      const CONDENSE_AT = 120;
      const EXPAND_AT = 48;
      const LOCK_MS = 320;
      let lockedUntil = 0;
      let queued = false;
      const apply = () => {
        queued = false;
        const y = window.scrollY;
        const condensed = header.classList.contains("is-condensed");
        const now = performance.now();
        if (now < lockedUntil) return;
        if (!condensed && y > CONDENSE_AT) {
          header.classList.add("is-condensed");
          lockedUntil = now + LOCK_MS;
        } else if (condensed && y < EXPAND_AT) {
          header.classList.remove("is-condensed");
          lockedUntil = now + LOCK_MS;
        }
      };
      window.addEventListener("scroll", () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(apply);
      }, { passive: true });
      apply();
    </script>
  </body>
</html>
