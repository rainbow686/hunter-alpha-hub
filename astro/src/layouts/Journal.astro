---
import "../styles/v6.css";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  description: string;
  section?: string;
  canonical?: string;
}

const { title, description, section = "Models", canonical } = Astro.props;
const path = Astro.url.pathname;

// Evergreen reference first, then the time-sensitive line. Order matters: the
// stable half should not move when a codename arrives.
const sections = [
  { href: "/comparison", label: "Comparison" },
  { href: "/openrouter-models", label: "Models" },
  { href: "/openrouter-pricing-calculator", label: "Pricing" },
  { href: "/stealth-models", label: "Stealth line" },
  { href: "/blog", label: "Articles" },
];

const dataSources = [
  ["Model fields", "openrouter.ai/api/v1/models"],
  ["Drift check", "daily 06:00"],
  ["Last verified", "2026-09-17"],
  ["Stealth status", "/api/union-alpha/status"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">
          <Logo size={26} />
          <span class="wordmark">hunteralpha<span class="accent">hub</span></span>
          <span class="tagline">OpenRouter reference</span>
        </a>
        <nav class="sections">
          {sections.map((s) => (
            <a href={s.href} aria-current={path === s.href ? "page" : undefined}>{s.label}</a>
          ))}
        </nav>
        <!-- The only moving part of the header: whatever is live right now. -->
        <div class="status-slot">
          <span class="badge live"><span class="dot"></span> Union Alpha live</span>
          <span class="clock">09-17 · 06:00 UTC</span>
        </div>
      </div>
    </header>

    <main class="wrap" style="padding-top: var(--space-8); padding-bottom: var(--space-12);">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-col">
            <h3>Where the numbers come from</h3>
            <div class="source-list">
              {dataSources.map(([label, value]) => (
                <div class="row"><span>{label}</span><code>{value}</code></div>
              ))}
            </div>
            <p style="margin-top: var(--space-4);">
              Verified fields are re-read from the public catalogue. Anything we could not verify is
              labelled a claim, never presented as fact.
            </p>
          </div>
          <div class="foot-col">
            <h3>Reference</h3>
            <ul>
              <li><a href="/openrouter-models">Model index</a></li>
              <li><a href="/comparison">Comparisons</a></li>
              <li><a href="/openrouter-pricing-calculator">Cost calculator</a></li>
              <li><a href="/openrouter-free-models">Free models</a></li>
              <li><a href="/best-openrouter-models">Best picks</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h3>Stealth line</h3>
            <ul>
              <li><a href="/stealth-models">All stealth releases</a></li>
              <li><a href="/union-alpha">Union Alpha · Unbiased Pareto</a></li>
              <li><a href="/alpha-models">How the line works</a></li>
              <li><a href="/ox-alpha">OX Alpha (revealed)</a></li>
              <li><a href="/hunter-alpha">Hunter Alpha (revealed)</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h3>Site</h3>
            <ul>
              <li><a href="/about">About &amp; method</a></li>
              <li><a href="/blog">Articles</a></li>
              <li><a href="/zh/access">中文文档</a></li>
              <li><a href="/terms">Terms of service</a></li>
              <li><a href="/privacy">Privacy policy</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-base">
          <span>Independent reference. Not affiliated with OpenRouter or any model provider.</span>
          <span class="disclaimer">
            Pricing, context windows and availability change without notice; stealth endpoints especially.
            Confirm with the provider before you commit.
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
