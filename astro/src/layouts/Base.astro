---
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  nav?: { href: string; label: string }[];
  canonical?: string;
}

const {
  title,
  description,
  nav = [
    { href: "/", label: "Home" },
    { href: "/comparison", label: "Comparison" },
    { href: "/openrouter-models", label: "Models" },
    { href: "/stealth-models", label: "Stealth Models" },
    { href: "/union-alpha", label: "Union Alpha" },
    { href: "/blog", label: "Blog" },
  ],
  canonical,
} = Astro.props;

const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a href="/" class="wordmark">hunteralphahub</a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap" style="padding-top: var(--space-8); padding-bottom: var(--space-12);">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        Independent OpenRouter model reference. Facts come from the public catalogue and are
        labelled with the date they were verified; anything unverified is marked as a claim.
      </div>
    </footer>
  </body>
</html>
