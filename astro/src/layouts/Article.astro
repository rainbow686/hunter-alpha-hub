---
/**
 * Content page template (article): masthead header from the design system,
 * serif display heading, sans body at the measure, byline carrying dates and
 * provenance, then related links and the four-column footer.
 */
import System from "./System.astro";
import JsonLd from "../components/JsonLd.astro";
import { articleSchema, breadcrumbSchema, SITE, SITE_NAME } from "../lib/schema";

interface Related { href: string; label: string; note?: string }
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  author: string;
  publishedAt: string;
  updatedAt?: string;
  readTime?: number;
  tags?: string[];
  related?: Related[];
}
const {
  title,
  description,
  slug,
  category,
  author,
  publishedAt,
  updatedAt,
  readTime,
  tags = [],
  related = [],
} = Astro.props;

const canonical = `${SITE}/blog/${slug}`;
const fmtDate = (value: string) =>
  new Date(value).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<System title={`${title} | ${SITE_NAME}`} description={description} canonical={canonical} ogType="article">
  <JsonLd
    slot="head"
    data={articleSchema({
      title,
      description,
      publishedAt,
      updatedAt: updatedAt ?? publishedAt,
      image: `${SITE}/og-image.png`,
      url: canonical,
    })}
  />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", url: SITE },
      { name: "Blog", url: `${SITE}/blog` },
      { name: title, url: canonical },
    ])}
  />

  <div class="article-shell">
    <p class="card-eyebrow">{category}</p>
    <h1 class="display" style="max-width: 28ch;">{title}</h1>
    <p class="lede" style="margin-bottom: var(--space-4);">{description}</p>
    <p class="provenance">
      <span>{author}</span>
      <span>{fmtDate(publishedAt)}</span>
      {readTime && <span>{readTime} min read</span>}
      {updatedAt && updatedAt !== publishedAt && <span>Updated {fmtDate(updatedAt)}</span>}
    </p>

    <article class="prose" style="margin-top: var(--space-8);">
      <slot />
    </article>

    {tags.length > 0 && (
      <div style="margin-top: var(--space-8); display: flex; gap: var(--space-2); flex-wrap: wrap;">
        {tags.map((tag) => <span class="tag unknown">{tag}</span>)}
      </div>
    )}

    {related.length > 0 && (
      <section style="margin-top: var(--space-12);">
        <h2>Keep reading</h2>
        <ul style="list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border);">
          {related.map((item) => (
            <li style="border-bottom: 1px solid var(--border); padding: var(--space-4) 0;">
              <a href={item.href} style="font-weight: 600;">{item.label}</a>
              {item.note && <div style="font-size: var(--text-sm); color: var(--text-muted); margin-top: 2px;">{item.note}</div>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</System>

<style>
  /* A single centred column: at 1280px a 72ch measure pinned to the left edge of a
     1080px container leaves a dead third of the screen, which reads as a layout
     bug rather than as whitespace.

     This was fixed here and nowhere else, so the tracker and model pages kept the
     pinned measure and looked broken next to an article. The width now comes from
     the system token instead of 74ch, so both templates are the same column —
     see `--column` in styles/system.css. */
  .article-shell { max-width: var(--column); margin: 0 auto; }
</style>
