---
import { readFileSync } from "node:fs";

const src = readFileSync(`${process.env.SITE_ROOT ?? "../"}lib/openrouter-models.ts`, "utf8");
const models = [...src.matchAll(/slug: "([^"]+)",\s*\n\s*name: "([^"]+)",\s*\n\s*vendor: "([^"]+)",\s*\n\s*contextWindow: ([\d_]+),\s*\n\s*inputPricePerMillion: ([\d.]+),\s*\n\s*outputPricePerMillion: ([\d.]+)/g)]
  .map((m) => ({ slug: m[1], name: m[2], vendor: m[3], context: Number(m[4].replace(/_/g, "")), input: Number(m[5]), output: Number(m[6]) }));
const maxContext = Math.max(...models.map((m) => m.context));
const fmtCtx = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 2)}M` : `${Math.round(n / 1024)}K`);
const fmtPrice = (n: number) => (n === 0 ? "free" : `$${n.toFixed(n < 1 ? 3 : 2)}`);
---
<p class="kicker">OpenRouter model index</p>
<h1 class="display">Every model, priced and dated.</h1>
<p class="lede">
  Catalogue facts in one table: context window, price per million, modality. The stealth line is tracked
  separately, and every claim carries a confidence label.
</p>
<div class="byline">
  <span>Model index</span><span>Verified 2026-09-17</span><span>Source: public catalogue</span>
</div>

<div class="stats">
  <div class="stat"><div class="label">Curated models</div><div class="value">{models.length}</div><div class="sub">drift-checked daily</div></div>
  <div class="stat"><div class="label">Largest window</div><div class="value">{fmtCtx(maxContext)}</div><div class="sub">tokens</div></div>
  <div class="stat"><div class="label">Free entries</div><div class="value">{models.filter((m) => m.input === 0).length}</div><div class="sub">preview pricing</div></div>
  <div class="stat"><div class="label">Verified</div><div class="value">2026-09-17</div><div class="sub">catalogue read</div></div>
</div>

<h2>Model snapshot</h2>
<div class="table-scroll">
  <table class="data">
    <thead>
      <tr><th>Model</th><th>Vendor</th><th class="num">Context</th><th class="num">Input /M</th><th class="num">Output /M</th></tr>
    </thead>
    <tbody>
      {models.map((m) => (
        <tr>
          <td><a href={`/openrouter-models/${m.slug}`}>{m.name}</a></td>
          <td style="color: var(--text-muted);">{m.vendor}</td>
          <td class="num">
            <span class="bar">
              <span class="track"><span class="fill" style={`width:${Math.round((m.context / maxContext) * 100)}%`}></span></span>
              <span class="num">{fmtCtx(m.context)}</span>
            </span>
          </td>
          <td class={`num ${m.input === 0 ? "free" : ""}`}>{fmtPrice(m.input)}</td>
          <td class={`num ${m.output === 0 ? "free" : ""}`}>{fmtPrice(m.output)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<div class="provenance">
  <span>Source <code>openrouter.ai/api/v1/models</code></span>
  <span>Verified <code>2026-09-17</code></span>
  <span>Drift check <code>daily 06:00</code></span>
</div>

<h2>Scroll to test the header</h2>
<p class="prose">
  This block exists so the page is long enough to scroll. Watch the header: the question is whether the
  brand stays readable once the masthead has left the top of the viewport.
</p>
<div class="card">
  <p class="prose" style="color: var(--text-muted);">
    Sticky behaviour is the one thing that cannot be judged from a screenshot — it has to be scrolled.
  </p>
</div>
