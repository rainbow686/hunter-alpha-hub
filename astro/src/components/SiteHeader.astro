---
import Logo from "./Logo.astro";
import { DATA_AS_OF, openrouterModels } from "@repo/lib/openrouter-models";
import { stealthLine } from "@repo/lib/stealth-models";
import { spotlight } from "@repo/lib/spotlight";

/**
 * Masthead header that folds into a single row on scroll.
 * Scroll logic lives in the layout (inline script) so this component stays static.
 */
const path = Astro.url.pathname;
/*
 * The live slot and the verified stamp read from the tracker data, not from this
 * file. They were hardcoded here (`Union Alpha live`, `Verified 2026-09-17`) while
 * the page below said "Revealed 2026-09-18", and the footer printed a third date —
 * on a site whose banner is "Facts from the public catalogue, dated and labelled".
 * A codename's status is a claim about the world, so it lives in one field a human
 * updates with evidence (lib/stealth-models.ts), and the date comes from the same
 * catalogue snapshot the model pages use.
 *
 * Two states, decided 2026-09-24. The slot exists for one moment — a new stealth
 * codename going live, which is the only time this site has news — and it used to
 * fill the rest of the time by printing "Union Alpha revealed" next to "no live
 * codename": a permanent badge for an event that was over, plus a sentence that
 * tells a reader nothing is happening. A reader does not need to be told that.
 * When nothing is live the slot carries the newest thing on the site instead, from
 * one hand-maintained field (lib/spotlight.ts), so the space is a link rather than
 * a tombstone.
 */
const statusSlot = stealthLine.liveCodename
  ? { live: true, label: `${stealthLine.liveCodename} live`, href: "/stealth-models" }
  : { live: false, label: spotlight.label, href: spotlight.href };
/*
 * A section is its own prefix, not just its own path: /laya/vs-jev is inside Laya
 * and /typesafe-jev/pricing inside Jev. Exact-match only meant a reader four pages
 * deep in a topic saw no current section — which is how "there is no Jev in the
 * nav" went unnoticed for a week. Computed here rather than in the attribute: a
 * nested template literal inside an Astro expression in an attribute is a parse
 * error, not a nicety.
 */
const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(`${href}/`));

const sections = [
  { href: "/comparison", label: "Comparison" },
  { href: "/openrouter-models", label: "Models" },
  /*
   * The two model topics, added 2026-09-24. They are the site's own work rather
   * than catalogue views, and until today the only way to reach either of them was
   * the footer or a typed URL — the two things this site is actually building were
   * invisible in its own navigation. They sit next to Models because that is the
   * axis they belong to.
   */
  { href: "/typesafe-jev", label: "Jev" },
  { href: "/laya", label: "Laya" },
  { href: "/openrouter-pricing-calculator", label: "Pricing" },
  { href: "/stealth-models", label: "Stealth line" },
  { href: "/openrouter-free-models", label: "Free models" },
  { href: "/blog", label: "Articles" },
];
---
<header class="site">
  <div class="masthead">
    <div class="wrap">
      <a class="brand" href="/">
        <span class="mark-tile"><Logo size={24} /></span>
        <span class="wordmark"><span>Hunter</span><em style="font-style: italic;">Alpha</em><span>Hub</span></span>
      </a>
      <div class="identity">
        <span class="line1">OpenRouter model reference</span>
        <span class="line2">Facts from the public catalogue, dated and labelled</span>
      </div>
      <div class="live-slot">
        {/*
          One badge, two meanings: a live codename (green dot, the moment the slot
          was built for) or the newest thing on the site (no dot — it is not live,
          it is new). Both are links, because both are places to go.
        */}
        <a class={statusSlot.live ? "badge live" : "badge"} href={statusSlot.href}>
          {statusSlot.live && <span class="dot"></span>}
          {statusSlot.label}
        </a>
        <span class="stamp">Verified<br />{DATA_AS_OF}</span>
      </div>
    </div>
  </div>
  <div class="navrow">
    <div class="wrap">
      <a class="brand-mini" href="/">
        <span class="mark-tile" style="width:26px;height:26px;border-radius:7px;"><Logo size={17} /></span>
        <span class="mini-word">Hunter<em style="font-style: italic;">Alpha</em>Hub</span>
      </a>
      <nav>
        {sections.map((s) => (
          <a href={s.href} aria-current={isCurrent(s.href) ? "page" : undefined}>{s.label}</a>
        ))}
      </nav>
      {/*
        The count is derived, not typed. It read "15 models tracked" while the
        snapshot had grown to 18 — the MiMo-V2.6 line went in and this line did
        not move, on the one piece of chrome that appears on every page.

        The time is CST because that is when the job actually runs:
        `.github/workflows/model-drift-check.yml` is `0 22 * * *`, i.e. 06:00 in
        Asia/Shanghai. The line said "06:00 UTC" until 2026-09-22, which was a
        six-hour lie on every page — a small one, on a site whose entire claim is
        that its labels are accurate.
      */}
      {/*
        Kept SHORTER than the string it replaced ("15 models tracked · verified
        06:00 UTC", 38 characters). The meta is `white-space: nowrap` inside a
        wrapping flex row, so six extra characters pushed "Articles" onto a second
        line in the condensed header — a layout regression that only appeared once
        the brand-mini reappeared on scroll, i.e. in a screenshot rather than in a
        check. 36 characters: "models" carries the meaning that "tracked" repeated.
      */}
      {/*
        The search button and the model count share one right-hand group so that the
        `margin-left: auto` that pushes them right lives on the group and not on the
        count alone. It did live on the count: the count is `display: none` under
        760px, which left the button as the only child in the row and no rule to pull
        it right — it sat against the nav on every phone.
      */}
      <div class="nav-tools">
        {/*
          "18 models" and nothing else, as of 2026-09-24. The full string
          ("18 models · drift-checked 06:00 CST") needs ~200px, and the intake
          button above needs ~100 of the 360px this row has beside the nav: with
          both, "Articles" wrapped onto a second line at 1440 — the same
          regression the comment below records from adding "tracked" back in
          September. The drift-check time is not lost: the footer carries
          "Drift check daily 06:00 CST" on every page, and the masthead stamp
          carries the date. The count stays because it is the one number that
          says how big the catalogue is.
        */}
        <span class="meta">{openrouterModels.length} models</span>
        {/*
          The intake, on every page. It is the one thing this site asks a reader to
          do, and it used to cost them a navigation to a page with six fields on it.
          The dialog is the primary surface now; /submit is where the explanation
          and the topic links live.
        */}
        <button type="button" class="submit-trigger" data-submit-open aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M4 12h12M12 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Submit</span>
        </button>
        <button type="button" class="search-trigger" data-search-open aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" />
            <line x1="15.5" y1="15.5" x2="21" y2="21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
          <span>Search</span>
          <kbd>⌘K</kbd>
        </button>
      </div>
    </div>
  </div>
</header>
