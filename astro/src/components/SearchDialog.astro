---
/**
 * ⌘K search over the built site.
 *
 * The index is generated from the finished HTML after every build
 * (scripts/build-search-index.mjs) and served from our own origin, so the site keeps
 * its no-third-party rule and its `script-src 'self'` CSP. The trigger button lives
 * in the header, not here — one component owns the dialog and the keys, and the
 * header stays a layout file.
 *
 * A `<dialog>` rather than a hand-rolled overlay: the browser gives us the top
 * layer, focus containment, Esc, and the backdrop, all of which are the part a
 * custom overlay gets wrong on a phone.
 */
---
<dialog id="site-search" class="search" aria-label="Search this site">
  <div class="search-box">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
      <line x1="15.5" y1="15.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder="Search every page"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      aria-controls="search-results"
      aria-describedby="search-status"
    />
    <button type="button" class="search-close" data-search-close aria-label="Close search">
      <kbd>esc</kbd>
    </button>
  </div>
  {/*
    One live region for the state, one list for the results. The status is polite and
    the count is in it, so a screen-reader user hears "8 of 8 results" rather than
    discovering the list changed by tabbing back into it.
  */}
  <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
  <ul id="search-results" class="search-results"></ul>
  <div class="search-foot" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> to choose</span>
    <span><kbd>↵</kbd> to open</span>
    <span><kbd>esc</kbd> to close</span>
  </div>
</dialog>

<script>
  import "../scripts/site-search.js";
</script>

{/*
  `is:global` on purpose, and it is not laziness: Astro scopes a component's styles
  by adding a `data-astro-cid-…` attribute to the elements in *its* markup, and the
  result rows are injected by the client script at runtime, so a scoped rule would
  match the shell and none of the results. The first version of this dialog shipped
  exactly that: styled box, unstyled rows, five lines of text on one line. The
  selectors below are all namespaced under `.search` / `.r-`, so nothing leaks.
*/}
<style is:global>
  /* The dialog is centred at the top, the way every search palette from Spotlight
     down is: the eye is already near the top of the window when it opens, and a
     vertically centred box moves the results out from under the pointer. */
  .search {
    width: min(680px, calc(100vw - 2 * var(--space-4)));
    margin: 8vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 60px rgb(0 0 0 / 28%);
  }
  .search::backdrop {
    background: rgb(28 26 22 / 45%);
    backdrop-filter: blur(2px);
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border);
    color: var(--text-faint);
  }
  .search-box input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--sans, inherit);
    font-size: 16px; /* 16px, not 15: anything smaller makes iOS zoom the page on focus. */
    line-height: 1.4;
    padding: 0;
  }
  .search-box input:focus { outline: none; }
  .search-box input::placeholder { color: var(--text-faint); }
  .search-box input::-webkit-search-cancel-button { display: none; }
  .search-close {
    border: 0;
    background: transparent;
    padding: 2px;
    cursor: pointer;
    color: inherit;
  }
  .search kbd {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 5px;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--bg-sunken);
    color: var(--text-muted);
  }
  .search-status {
    margin: 0;
    padding: var(--space-3) var(--space-5) 0;
    font-size: var(--text-xs);
    color: var(--text-faint);
  }
  .search-status:empty { display: none; }
  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--space-2) var(--space-2) var(--space-2);
    max-height: min(56vh, 480px);
    overflow-y: auto;
  }
  .search-results:empty { display: none; }
  .search-results li { margin: 0; }
  .search-results a {
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    color: inherit;
  }
  .search-results a.is-active { background: var(--accent-soft); }
  .r-title { font-family: var(--serif); font-size: 15.5px; line-height: 1.3; }
  .r-where {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }
  .r-excerpt {
    font-size: var(--text-sm);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-results mark { background: var(--accent-soft); color: var(--text); }
  .search-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }
  @media (max-width: 560px) {
    .search-foot { display: none; }
  }
</style>
