---
/**
 * Night-edition review page.
 *
 * Same content as the frozen system page, but with a Paper / Night / System
 * switch so the night palette can be judged on real surfaces — tables, badges,
 * claim blocks, provenance — instead of on a colour swatch. `?theme=dark` in the
 * URL pins the theme for screenshots, so a review link always renders the same.
 */
import System from "../../src/layouts/System.astro";
import { openrouterModels, formatPrice } from "@repo/lib/openrouter-models";

const models = openrouterModels.map((m) => ({
  slug: m.slug,
  name: m.name,
  vendor: m.vendor,
  context: m.contextWindow,
  input: m.inputPricePerMillion,
  output: m.outputPricePerMillion,
}));
const fmtCtx = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 2)}M` : `${Math.round(n / 1024)}K`);
const fmtPrice = (n: number) => (n === 0 ? "free" : formatPrice(n));
---
<System
  title="Night edition — review"
  description="Review page for the night edition of the frozen design system."
>
  <script is:inline slot="head">
    // Runs before first paint, so a pinned theme never flashes the other one.
    (() => {
      const pinned = new URLSearchParams(location.search).get("theme");
      const stored = pinned === "dark" || pinned === "light" ? pinned : localStorage.getItem("hub-theme");
      if (stored === "dark" || stored === "light") document.documentElement.dataset.theme = stored;
    })();
  </script>

  <div class="theme-bar">
    <span class="label">Night edition review</span>
    <div class="theme-switch" role="group" aria-label="Theme">
      <button type="button" data-set-theme="">System</button>
      <button type="button" data-set-theme="light">Paper</button>
      <button type="button" data-set-theme="dark">Night</button>
    </div>
    <span class="hint">Same page, same tokens, inverted roles to check every surface at once.</span>
  </div>

  <p class="kicker">OpenRouter model index</p>
  <h1 class="display">Every model, priced and dated.</h1>
  <p class="lede">
    Catalogue facts in one table: context window, price per million, modality. The stealth line is tracked
    separately, and every claim carries a confidence label.
  </p>
  <div class="byline">
    <span>Model index</span><span>Verified 2026-09-17</span><span>Source: public catalogue</span>
  </div>

  <div class="stats">
    <div class="stat"><div class="label">Curated models</div><div class="value">{models.length}</div><div class="sub">drift-checked daily</div></div>
    <div class="stat"><div class="label">Free entries</div><div class="value">{models.filter((m) => m.input === 0).length}</div><div class="sub">preview pricing</div></div>
    <div class="stat"><div class="label">Status</div><div class="value">live</div><div class="sub">stealth endpoint</div></div>
    <div class="stat"><div class="label">Verified</div><div class="value">2026-09-17</div><div class="sub">catalogue read</div></div>
  </div>

  <h2>Model snapshot</h2>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr><th>Model</th><th>Vendor</th><th class="num">Context</th><th class="num">Input /M</th><th class="num">Output /M</th></tr>
      </thead>
      <tbody>
        {models.map((m) => (
          <tr>
            <td><a href={`/openrouter-models/${m.slug}`}>{m.name}</a></td>
            <td style="color: var(--text-muted);">{m.vendor}</td>
            <td class="num">{fmtCtx(m.context)}</td>
            <td class={`num ${m.input === 0 ? "free" : ""}`}>{fmtPrice(m.input)}</td>
            <td class={`num ${m.output === 0 ? "free" : ""}`}>{fmtPrice(m.output)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="provenance">
    <span>Source <code>openrouter.ai/api/v1/models</code></span>
    <span>Verified <code>2026-09-17</code></span>
    <span>Drift check <code>daily 06:00</code></span>
  </div>

  <h2>Fact versus claim</h2>
  <div class="claim">
    <strong>Union Alpha accepts image input</strong> — <span class="tag verified">Verified</span>
    <div class="basis">
      Catalogue modality field, read 2026-09-17.
    </div>
  </div>
  <div class="claim" style="margin-top: var(--space-4);">
    <strong>Union Alpha is an orchestrator over several models</strong> — <span class="tag claimed">Claimed</span>
    <div class="basis">
      A public landing page describes parallel generation with a synthesised answer; testers report
      inconsistent behaviour. No confirmation from the maker.
    </div>
  </div>

  <h2>Status colours, in place</h2>
  <p style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
    <span class="badge live"><span class="dot"></span> Free while in stealth</span>
    <span class="badge claimed">Claimed by a third party</span>
    <span class="badge gone">Endpoint retired</span>
  </p>
  <p class="hero-actions">
    <a class="btn primary" href="/openrouter-models">Primary action</a>
    <a class="btn ghost" href="/comparison">Secondary action</a>
  </p>
</System>

<style>
  .theme-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-8);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .theme-bar .label {
    font-family: var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .theme-bar .hint { flex: 1 1 260px; }
  .theme-switch { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 999px; overflow: hidden; }
  .theme-switch button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    padding: 5px var(--space-4);
    cursor: pointer;
  }
  .theme-switch button[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); }
</style>

<script is:inline>
  const buttons = document.querySelectorAll("[data-set-theme]");
  const current = () => document.documentElement.dataset.theme || "";
  const paint = () => buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setTheme === current())));
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const value = b.dataset.setTheme;
      if (value) document.documentElement.dataset.theme = value;
      else delete document.documentElement.dataset.theme;
      localStorage.setItem("hub-theme", value);
      paint();
    }),
  );
  paint();
</script>
