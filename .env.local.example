# Required runtime template for API routes
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional analytics / ads
NEXT_PUBLIC_ADSENSE_ID=
# GA4 measurement ID (G-XXXXXXXXXX). Public value — it ships in page HTML.
# Set here (or as a Cloudflare Worker var named GA_MEASUREMENT_ID) to turn the probe on.
NEXT_PUBLIC_GA_ID=

# Optional integrations
CONVERTKIT_API_KEY=
OPENROUTER_API_KEY=

# Optional server-side evidence import
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
