# No database credentials are needed here any more: email subscriptions are stored in
# Cloudflare D1 through the Worker binding `DB` (see ADR-0014). Local development uses
# the same binding, simulated by `wrangler dev`; apply d1/migrations to create the table.

# Optional analytics / ads
NEXT_PUBLIC_ADSENSE_ID=
# GA4 measurement ID (G-XXXXXXXXXX). Public value — it ships in page HTML.
# Set here (or as a Cloudflare Worker var named GA_MEASUREMENT_ID) to turn the probe on.
NEXT_PUBLIC_GA_ID=

# Optional integrations
CONVERTKIT_API_KEY=
OPENROUTER_API_KEY=

# Optional server-side evidence import
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
