{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunter-alpha-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
    "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hunter-alpha-hub-subscribers",
      "database_id": "941d6f24-ecc4-4f45-bc3a-888d9b6df00e",
      "migrations_dir": "d1/migrations"
    }
  ],
"services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hunter-alpha-hub"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "hunteralphahub.com",
      "custom_domain": true
    },
    {
      "pattern": "www.hunteralphahub.com",
      "custom_domain": true
    }
  ]
}
