#!/usr/bin/env bash
# Block direct pushes to main.
#
# Why this exists: the repo's flow is feature branch → verify → normal PR merge
# (AGENTS.md §6). Twice now a change has been committed while sitting on main
# after a merge, and both times the only thing that caught it was a human
# re-reading the log afterwards. A rule that depends on remembering is not a
# rule — this is the same move as check:theme and verify:pages, applied to the
# process itself.
#
# Emergency override: ALLOW_MAIN_PUSH=1 git push
set -euo pipefail

protected="refs/heads/main"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  if [ "$remote_ref" = "$protected" ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    blocked=1
  fi
done

if [ "$blocked" = "1" ]; then
  cat >&2 <<'EOF'
pushes to main are blocked.

  Use the flow from AGENTS.md §6: feature branch → verify (tsc / build /
  check:theme / verify:pages) → normal PR merge into main.

  git switch -c feat/<something>
  git push -u origin HEAD && gh pr create

  If you truly mean to push main (hotfix, revert of a bad deploy):
  ALLOW_MAIN_PUSH=1 git push
EOF
  exit 1
fi

exit 0
